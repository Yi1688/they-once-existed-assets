:: 开始 {"position": "480,0", "size": "180,100"}
<section data-scene="开始" class="page title-screen" data-sound="themeOpen"><canvas class="title-dust" aria-hidden="true"></canvas><div class="title-light" aria-hidden="true"></div><div class="title-main"><div class="title-copy"><div class="title-heading"><p class="title-overline">AN INTERACTIVE FABLE / 交互寓言</p><h1 class="title-wordmark"><span>它们</span><span>曾存在<span class="title-mark" aria-hidden="true">✦</span></span></h1><p class="title-english">THEY ONCE EXISTED</p><h2 class="title-subtitle">神明的赠礼</h2><p class="title-invitation">森林、笼子、围栏。<br>这一次，从它们的眼里看。</p></div><div class="title-controls"><div class="actions"><span>(transition-arrive: "instant")(link-goto: "开始游戏 <span aria-hidden=\"true\">↗</span>", "选择角色")</span><span>(transition-arrive: "instant")(link-goto: "旅程手记", "旅程手记")</span></div><button type="button" class="title-listen" data-start-listening><span class="title-equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-title-audio-status>点击开启音乐</span></button></div></div><div class="title-visual"><div class="title-orbit" aria-hidden="true"><div class="orbit-ring ring-outer"></div><div class="orbit-ring ring-inner"></div><div class="orbit-cross"></div><span class="orbit-star star-north">✦</span><span class="orbit-star star-south">✧</span></div><div class="title-portals"><button type="button" class="title-portal portal-pig" data-animal="pig" data-title-line="“这家伙怎么连树都咬得断？”" aria-label="试听野猪叫声"><span class="portal-number">I</span><span class="portal-halo" aria-hidden="true"></span><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%87%8E%E7%8C%AA%E9%80%8F%E6%98%8E.png" alt="野猪的剪影" width="240" height="200"><span class="portal-caption"><strong>野猪</strong><small>FOREST</small></span></button><button type="button" class="title-portal portal-cat" data-animal="cat" data-title-line="“这里就是我的家了吗？”" aria-label="试听猫叫声"><span class="portal-number">II</span><span class="portal-halo" aria-hidden="true"></span><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E7%8C%AB%E9%80%8F%E6%98%8E.png" alt="猫的剪影" width="240" height="200"><span class="portal-caption"><strong>猫</strong><small>HOME</small></span></button><button type="button" class="title-portal portal-duck" data-animal="duck" data-title-line="“被选中以后，真的能去天堂？”" aria-label="试听鸭子叫声"><span class="portal-number">III</span><span class="portal-halo" aria-hidden="true"></span><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%B8%AD%E5%AD%90%E9%80%8F%E6%98%8E.png" alt="鸭子的剪影" width="240" height="200"><span class="portal-caption"><strong>鸭子</strong><small>ALTAR</small></span></button></div><p class="title-scene-caption" data-title-caption>“那真的是神吗？”</p></div></div><footer class="title-footer"><span>三个故事 · 约 10–15 分钟</span><span>点击动物 · 试听叫声</span><span class="title-edition">神明的赠礼 / CHAPTER II</span></footer></section>

:: 选择角色 {"position": "720,0", "size": "180,100"}
<section data-scene="选择角色" class="page selection" data-sound="themeOpen"><div class="eyebrow">PROLOGUE / 序章</div><div class="selection-head"><h1>从它的眼睛看</h1><p>选一个角色。读完三条故事约需 10–15 分钟。</p></div><img class="selection-art" src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E5%AE%83%E4%BB%AC%E9%80%8F%E6%98%8E.png" alt="野猪、猫与鸭子的剪影"><div class="role-grid"><article class="role-card"><span class="role-count" data-role-count="pig">0/2</span><button type="button" class="animal-preview" data-animal="pig" aria-label="试听野猪叫声"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%87%8E%E7%8C%AA.jpg" alt="野猪的剪影"><span class="sound-hint">点击动物 · 试听叫声 ♫</span></button><div class="role-copy"><div class="role-no">01 / THE FOREST</div><h2>野猪</h2><p>林子外来了个大家伙。<br>你从没见过这样的动物。</p><div class="role-enter">(transition-arrive: "instant")(link-goto: "开始它的故事 <span>↗</span>", "猪_森林")</div></div></article><article class="role-card"><span class="role-count" data-role-count="cat">0/2</span><button type="button" class="animal-preview" data-animal="cat" aria-label="试听猫叫声"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E7%8C%AB.jpg" alt="猫的剪影"><span class="sound-hint">点击动物 · 试听叫声 ♫</span></button><div class="role-copy"><div class="role-no">02 / THE HOME</div><h2>猫</h2><p>有人说，要带你回家。<br>你在笼子里等了很久。</p><div class="role-enter">(transition-arrive: "instant")(link-goto: "开始它的故事 <span>↗</span>", "猫_牢笼")</div></div></article><article class="role-card"><span class="role-count" data-role-count="duck">0/2</span><button type="button" class="animal-preview" data-animal="duck" aria-label="试听鸭子叫声"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%B8%AD%E5%AD%90.jpg" alt="鸭子的剪影"><span class="sound-hint">点击动物 · 试听叫声 ♫</span></button><div class="role-copy"><div class="role-no">03 / THE ALTAR</div><h2>鸭子</h2><p>鸭群都在抢神明撒下的粮。<br>它们说，吃饱了就能去天堂。</p><div class="role-enter">(transition-arrive: "instant")(link-goto: "开始它的故事 <span>↗</span>", "鸭_泥沼")</div></div></article></div><footer class="selection-foot"><span>三个故事 · 每个故事两个结局 · 带下划线的文字可以点击</span><span class="series">它们曾存在 / 神明的赠礼</span></footer></section>

:: 猪_森林 {"position": "960,0", "size": "180,100"}
(set: $pigWater to false)(set: $pigRoots to false)(set: $pigShelter to false)(set: $pigRings to false)(set: $pigMarked to false)(set: $pigTasted to false)(set: $pigWaited to false)(set: $pigRetraced to false)(set: $pigTrail to false)(set: $pigOil to false)<section data-scene="猪_森林" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="forest"><div class="chapter"><span class="number">01</span><span>林子外的声音</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="从野猪的视角看向幽蓝色的树林" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>什么东西在响？</h1><p class="voice">“<span class="cycle-word word-slot" title="点击切换文字"><span class="word-measure" aria-hidden="true">也不像刮风</span><span class="word-value">(cycling-link: "不像打雷", "也不像刮风", "从没听过")</span></span>。怎么地也在动？”</p><p class="thought">你停下来，朝声音传来的方向看去。</p><div class="story-whisper" data-whisper="forestEcho"><span class="whisper-label">再听一会儿</span><span class="whisper-copy">|forestEcho>[地面又震了一下。附近的鸟全飞走了。]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "再听一次 ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?forestEcho)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "地面又震了一下。附近的鸟全飞走了。", "声音越来越近，还夹着树枝断裂的响声。", "你往林外走了两步，竖起耳朵。"))]]]</span></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "沿着溪边过去 →", "猪_溪水")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:8%"></span></div></section>

:: 猪_巨兽 {"position": "1200,0", "size": "180,100"}
<section data-scene="猪_巨兽" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="machine"><div class="chapter"><span class="number">01</span><span>林子外的声音</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="灰黑色的伐木机出现在树林之外" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>空地上，一个大家伙正慢慢往前挪。<br><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">灰黑色的硬壳上看不见皮毛。</span><span class="word-value">|ironSkin>[灰黑色的硬壳上看不见皮毛。]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?ironSkin)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "灰黑色的硬壳上看不见皮毛。", "硬壳没有随着呼吸起伏。", "里面一直响着，怎么也不停。"))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">(set: _inkText to "“这么大……它吃什么长的？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这么大……它吃什么长的？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这么大……它吃什么长的？”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">走近一点</span><span class=\"choice-detail\">看看它到底长什么样。</span>", "猪_靠近")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">沿林缘绕一圈</span><span class=\"choice-detail\">先看清周围有没有路。</span>", "猪_足迹")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:16%"></span></div></section>

:: 猪_足迹 {"position": "1440,0", "size": "180,100"}
<section data-scene="猪_足迹" class="page scene-stage role-pig " data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>林边的小径</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="森林深处留下了一条尚未被机器推平的小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigTrail to true)<p>你绕着空地走了一段。<br><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">小径还没被压坏，能从这里绕回密林。</span><span class="word-value">(link: "几行蹄印拐进了北边的小径。")[(transition: "dissolve")+(transition-time: .55s)[小径还没被压坏，能从这里绕回密林。]]</span></span></p><p class="voice">(set: _inkText to "“这边还能走。先记住，等会儿从这里回去。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这边还能走。先记住，等会儿从这里回去。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 21))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 21)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这边还能走。先记住，等会儿从这里回去。”</span></span>](click: ?spokenLine)[(set: _inkCount to 21)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="memory"><span>你记得</span>北边有条小径，入口旁长着一棵老树。</div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再去看看大家伙 →", "猪_路标")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:22%"></span></div></section>

:: 猪_靠近 {"position": "0,180", "size": "180,100"}
<section data-scene="猪_靠近" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="machine"><div class="chapter"><span class="number">02</span><span>硬壳里的轰鸣</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="伐木机的轮盘和钢铁躯体逐渐逼近" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>它碰到一棵树。树干晃了几下，突然折断。<br>枝叶被卷进去，碎木屑落了一地。</p><p class="voice">(set: _inkText to "“连这么粗的树都咬得断……”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“连这么粗的树都咬得断……”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“连这么粗的树都咬得断……”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再靠近一点 →", "猪_倒树")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:25%"></span></div></section>

:: 猪_光芒 {"position": "240,180", "size": "180,100"}
<section data-scene="猪_光芒" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="light"><div class="chapter"><span class="number">02</span><span>刺眼的灯</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/4%E6%9C%BA%E5%99%A8%E5%8F%91%E5%85%89.jpg" alt="停在森林边缘的机器散发刺眼的黄色光芒" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>大家伙停住了。两束(text-style: "shadow")[刺眼的黄光]照在你脸上。<br>风里飘来<span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">铁锈混着机油的味道</span><span class="word-value">(link: "一股怪味")[(transition: "dissolve")+(transition-time: .55s)[铁锈混着机油的味道]]</span></span>，你以前没有闻过。</p><p class="voice">(set: _inkText to "“盯着我干什么？这是我的地盘。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“盯着我干什么？这是我的地盘。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“盯着我干什么？这是我的地盘。”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">亮出獠牙</span><span class=\"choice-detail\">不能让它再往前走了。</span>", "猪_撞击")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先闻一闻风</span><span class=\"choice-detail\">这家伙身上的味道不对。</span>", "猪_机油")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:34%"></span></div></section>

:: 猪_机油 {"position": "480,180", "size": "180,100"}
<section data-scene="猪_机油" class="page scene-stage role-pig " data-sound="pigOpen"><div class="chapter"><span class="number">02</span><span>奇怪的气味</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="机器轮盘之间的黑暗缝隙" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigOil to true)<p>你嗅了又嗅。没有皮毛味，也没有血腥气。<br><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">只有铁锈、机油和树皮渗出的汁液。</span><span class="word-value">(link: "只有铁锈、机油和树皮渗出的汁液。")[(transition: "dissolve")+(transition-time: .55s)[机器的怪味里混着刚折断的树枝味。]]</span></span></p><p class="voice">(set: _inkText to "“它一直在叫，怎么不用喘气？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“它一直在叫，怎么不用喘气？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“它一直在叫，怎么不用喘气？”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="memory"><span>你记得</span>这个大家伙没有动物的气味，硬壳上也没有呼吸的起伏。</div><div class="story-whisper" data-whisper="ironBreath"><span class="whisper-label">靠近以后</span><span class="whisper-copy">|ironBreath>[热气扑在鼻子上，你打了个喷嚏。]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "再听一次 ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?ironBreath)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "热气扑在鼻子上，你打了个喷嚏。", "这么大的东西，居然闻不到一点皮毛味。", "它刚压过的地方，泥土都翻了出来。"))]]]</span></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "用獠牙试一试 →", "猪_铁壳")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:40%"></span></div></section>

:: 猪_撞击 {"position": "720,180", "size": "180,100"}
<section data-scene="猪_撞击" class="page scene-stage role-pig " data-sound="pigInteract"><div class="chapter"><span class="number">03</span><span>撞上去</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/5%E9%87%8E%E7%8C%AA%E9%9D%A0%E8%BF%91.jpg" alt="野猪举起獠牙迎向发光的机器" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“走开！不许再碰这里的树！”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“走开！不许再碰这里的树！”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“走开！不许再碰这里的树！”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p class="thought">你压低头，用獠牙撞上它的硬壳。</p></div><div class="interaction" data-task="ram" data-goal="5"><p class="instructions">点击五次，试着把它赶出森林。</p><button type="button" class="action-button" data-task-action>用獠牙撞击机械</button><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">獠牙撞击 · 0 / 5</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "抬头看看 →", "猪_神明")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:45%"></span></div></section>

:: 猪_神明 {"position": "960,180", "size": "180,100"}
<section data-scene="猪_神明" class="page scene-stage role-pig " data-sound="pigWorship" data-fx="revelation"><div class="chapter"><span class="number">04</span><span>你认出的神明</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/6%E6%9C%BA%E5%99%A8%E5%8F%98%E9%87%8E%E7%8C%AA.jpg" alt="机械在野猪眼中化为长着巨型獠牙的野猪神明" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>第五次撞上去，獠牙震得发麻。你抬起头。<br><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">灯光后面，竟然长着和你一样的獠牙。</span><span class="word-value">|godShape>[灯光后面，竟然长着和你一样的獠牙。]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?godShape)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "灯光后面，竟然长着和你一样的獠牙。", "那对獠牙比你高出许多。", "你把机器的铁臂认成了獠牙。"))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">“原来是(text-style: "outline")[野猪之神]……难怪我撞不动。”</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "仰头望着它 →", "猪_试探")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:57%"></span></div></section>

:: 猪_喷气 {"position": "1200,180", "size": "180,100"}
<section data-scene="猪_喷气" class="page scene-stage role-pig " data-sound="pigWorship" data-fx="steam"><div class="chapter"><span class="number">04</span><span>巨神的吐息</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/7%E9%87%8E%E7%8C%AA%E5%96%B7%E6%B0%94.jpg" alt="机械巨神向外喷出白雾，渺小的蓝色野猪在下方仰望" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "巨神身上突然喷出一团白雾。\n你缩了缩脖子，又忍不住仰头去看。")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">巨神身上突然喷出一团白雾。<br>你缩了缩脖子，又忍不住仰头去看。</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 30))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 30)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">巨神身上突然喷出一团白雾。<br>你缩了缩脖子，又忍不住仰头去看。</span></span>](click: ?spokenLine)[(set: _inkCount to 30)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="story-whisper" data-whisper="godReply"><span class="whisper-label">白雾里</span><span class="whisper-copy">|godReply>[巨神喷出的白雾从你头顶飘过。]</span>(set: _echo to 1)(live: 1.2s)[(set: _echo to _echo + 1)(replace: ?godReply)[(transition: "dissolve")+(transition-time: .6s)[(print: (nth: _echo, "巨神喷出的白雾从你头顶飘过。", "你一动不动，等着它再做点什么。", "雾散了，巨神又朝前挪了一步。"))]](if: _echo >= 3)[(stop:)]]</div></div><div class="interaction" data-task="hold" data-goal="1"><p class="instructions">按住约两秒，观察巨神喷气。</p><button type="button" class="hold-button" data-task-action>按住 · 注视巨神喷气</button><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">按住按钮，观察巨神喷出的白雾。</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "等白雾散开 →", "猪_赠礼")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:70%"></span></div></section>

:: 猪_抉择 {"position": "1440,180", "size": "180,100"}
<section data-scene="猪_抉择" class="page scene-stage role-pig " data-sound="pigWorship"><div class="chapter"><span class="number">05</span><span>走，还是留下</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/%E9%87%8E%E7%8C%AA%E8%AF%B4%E8%AF%9D.jpg" alt="野猪站在沉默的钢铁巨神面前" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>还要留在这里吗？</h1><p class="voice">(set: _inkText to "“它这么厉害，跟着它应该不会挨饿吧？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“它这么厉害，跟着它应该不会挨饿吧？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 19))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 19)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“它这么厉害，跟着它应该不会挨饿吧？”</span></span>](click: ?spokenLine)[(set: _inkCount to 19)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>身后又倒下一棵树。你回头看了看林子。</p>(if: $pigOil)[<div class="memory"><span>你记得</span>可它没有呼吸。你始终没想明白。</div>](if: $pigTrail)[<div class="memory"><span>你记得</span>北边那条小径还在，可以从老树旁边走。</div>](if: $pigTasted)[<p class="thought">牙缝里的木刺还没弄出来。你已经尝过，木屑不能当饭吃。</p>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">离开 · 回到森林</span><span class=\"choice-detail\">去找你熟悉的溪水和野果。</span>", "猪_存活")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">留下 · 追随巨神</span><span class=\"choice-detail\">这么强大的神，总会照顾你吧。</span>", "猪_灭绝")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:84%"></span></div></section>

:: 猪_存活 {"position": "0,360", "size": "180,100"}
<section data-scene="猪_存活" class="page scene-stage role-pig ending" data-sound="themeEnd" data-ending="pig-live"><div class="chapter"><span class="number">06</span><span>结局 A · 离开</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="野猪转身回到深蓝色的森林" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 01 / 离开</div><h1>回到林子里</h1><p>你最后看了一眼巨神，转身钻进树林。<br>走出很远，那阵轰鸣还没有停。</p>(if: $pigTrail)[<p>你沿北边的小径绕过空地，在溪边停了下来。</p>](else:)[<p>你顺着熟悉的气味往里走，终于找到了溪水。</p>]<p><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">你记得的那棵果树还在</span><span class="word-value">(link: "溪边还有野果")[(transition: "dissolve")+(transition-time: .55s)[你记得的那棵果树还在]]</span></span>。你低头喝了水，肚子也渐渐填饱了。</p><p class="closing">(set: _inkText to "今晚就在这里睡吧。")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">今晚就在这里睡吧。</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 9))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 9)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">今晚就在这里睡吧。</span></span>](click: ?spokenLine)[(set: _inkCount to 9)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再玩一次 ↻", "猪_森林")</span><span>(transition-arrive: "instant")(link-goto: "下一个故事 · 猫 ↗", "猫_牢笼")</span><span>(transition-arrive: "instant")(link-goto: "查看结局记录", "旅程手记")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: 猪_灭绝 {"position": "240,360", "size": "180,100"}
<section data-scene="猪_灭绝" class="page scene-stage role-pig ending ending-pig-fall" data-sound="themeEnd" data-ending="pig-fall"><div class="chapter"><span class="number">06</span><span>结局 B · 留下</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="森林的颜色褪去，只留下继续工作的伐木机" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 02 / 留下</div><h1>它没有回头</h1><p><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">你跟在巨神身后，把木屑和树桩当成神明留下的东西。</span><span class="word-value">|falseGift>[你跟在巨神身后，把木屑和树桩当成神明留下的东西。]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?falseGift)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "你跟在巨神身后，把木屑和树桩当成神明留下的东西。", "巨神经过的地方，只有木屑和树桩。", "你低头咬了一口，嘴里全是木头渣。"))]](if: _wordStep >= 3)[(stop:)]]<br>可那些东西吃不下去。你只好继续等。</p><p>几天后，机器开走了。周围没有树荫，溪水也被泥堵住。<br>你饿得站不起来，还是望着它离开的方向。</p><p class="closing">(set: _inkText to "它一直没有回来。")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">它一直没有回来。</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 8))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 8)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">它一直没有回来。</span></span>](click: ?spokenLine)[(set: _inkCount to 8)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再玩一次 ↻", "猪_森林")</span><span>(transition-arrive: "instant")(link-goto: "下一个故事 · 猫 ↗", "猫_牢笼")</span><span>(transition-arrive: "instant")(link-goto: "查看结局记录", "旅程手记")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: 猫_牢笼 {"position": "480,360", "size": "180,100"}
(set: $catHeard to false)(set: $catCold to false)(set: $catProof to false)(set: $catTouch to false)(set: $catSignal to false)(set: $catPatient to false)(set: $catTag to false)<section data-scene="猫_牢笼" class="page scene-stage role-cat " data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>笼子里的日子</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="灰色的猫挤在冰冷的铁栏杆之后" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>今天会有人来吗？</h1><p>铁栏杆很凉。<br><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">门一开，所有的猫就都抬起头。</span><span class="word-value">|cageNames>[几只猫挤成灰扑扑的一团。]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?cageNames)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "几只猫挤成灰扑扑的一团。", "你被夹在中间，连翻身都难。", "门一开，所有的猫就都抬起头。"))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">(set: _inkText to "“外面是不是暖和一点？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“外面是不是暖和一点？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“外面是不是暖和一点？”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="story-whisper" data-whisper="cageEcho"><span class="whisper-label">门口的动静</span><span class="whisper-copy">|cageEcho>[走道尽头响起了脚步声。]</span>(after: 1.6s)[(replace: ?cageEcho)[(transition: "dissolve")+(transition-time: .8s)[钥匙碰在一起。你赶紧抬起头。]]]</div><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">听听隔壁的声音</span><span class=\"choice-detail\">有只猫一直没有睡着。</span>", "猫_隔壁")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">找个不漏风的角落</span><span class=\"choice-detail\">笼子底下的布已经凉了。</span>", "猫_夜风")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:8%"></span></div></section>

:: 猫_走道 {"position": "720,360", "size": "180,100"}
<section data-scene="猫_走道" class="page scene-stage role-cat " data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>栏杆外面</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="猫从铁栏杆之间望向走道" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你贴着栏杆往外看。<span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">每个笼子里的猫都在盯着门口。</span><span class="word-value">(link: "走道两边是一排一样的笼子。")[(transition: "dissolve")+(transition-time: .55s)[每个笼子里的猫都在盯着门口。]]</span></span><br>窗户很高，阳光只照得到最上面一层。</p><p class="voice">(set: _inkText to "“我要是再长高一点，就能晒到了吧。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“我要是再长高一点，就能晒到了吧。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 18))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 18)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“我要是再长高一点，就能晒到了吧。”</span></span>](click: ?spokenLine)[(set: _inkCount to 18)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "门口有人来了 →", "猫_光")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:14%"></span></div></section>

:: 猫_光 {"position": "960,360", "size": "180,100"}
<section data-scene="猫_光" class="page scene-stage role-cat " data-sound="catOpen" data-fx="warmth"><div class="chapter"><span class="number">02</span><span>有人要带你走</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫想象中有沙发、落地灯和猫窝的温暖房间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“这只好乖。跟我回家吧，猫窝都买好了。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这只好乖。跟我回家吧，猫窝都买好了。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 20))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 20)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这只好乖。跟我回家吧，猫窝都买好了。”</span></span>](click: ?spokenLine)[(set: _inkCount to 20)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>你听不懂所有的话，只听出声音很轻。<br>你往前挤了挤，把脸贴在栏杆上。</p><div class="story-whisper" data-whisper="homePromise"><span class="whisper-label">你没见过的家</span><span class="whisper-copy">|homePromise>[沙发是可以趴着睡的地方吗？]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "再听一次 ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?homePromise)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "沙发是可以趴着睡的地方吗？", "灯开着的时候，屋里一定很暖和吧。", "要是猫窝够软，我想一直睡到明天。"))]]]</span></div><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">伸头蹭蹭那只手</span><span class=\"choice-detail\">你已经很久没被摸过了。</span>", "猫_换碗")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">看一眼笼门上的纸</span><span class=\"choice-detail\">旁边的人正忙着换标签。</span>", "猫_标签")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:18%"></span></div></section>

:: 猫_标签 {"position": "1200,360", "size": "180,100"}
<section data-scene="猫_标签" class="page scene-stage role-cat " data-sound="catOpen"><div class="chapter"><span class="number">02</span><span>新换的标签</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="铁栏杆隔开了猫与外面的人类" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catTag to true)<p>笼门上的纸被撕了下来，新纸上写着“|health>[健康、活泼]”。<br>旧纸揉成一团，扔进了旁边的箱子。</p><p class="voice">(set: _inkText to "“这只没问题，吃东西可积极了。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这只没问题，吃东西可积极了。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这只没问题，吃东西可积极了。”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="memory"><span>你记得</span>你昨晚一直没胃口。今天，他们却说你很健康。</div>(after: .9s)[(enchant: ?health, (text-style: "strike")+(text-colour: "#777777"))]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "一碗饭送了进来 →", "猫_凭据")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:24%"></span></div></section>

:: 猫_饭 {"position": "1440,360", "size": "180,100"}
<section data-scene="猫_饭" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>送来的饭</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/3.jpg" alt="白色背景上的淡紫色食碗" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">“总算有饭了。可是闻着<span class="cycle-word word-slot" title="点击切换文字"><span class="word-measure" aria-hidden="true">像是混了别的东西</span><span class="word-value">(cycling-link: "有一点怪", "有点发苦", "像是混了别的东西")</span></span>。”</p><p class="thought">肚子咕噜响了一声。你已经饿了很久。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先吃一点</span><span class=\"choice-detail\">填饱肚子再说。</span>", "猫_咀嚼")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">凑近闻一闻</span><span class=\"choice-detail\">饭里混着一股苦味。</span>", "猫_药味")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:28%"></span></div></section>

:: 猫_药味 {"position": "0,540", "size": "180,100"}
<section data-scene="猫_药味" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>饭里有什么</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="食碗中的胶囊显露出与食物不同的形状" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你用爪子拨开上面的饭，下面有<span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">掺进饭里的药粒</span><span class="word-value">(link: "几粒硬东西")[(transition: "dissolve")+(transition-time: .55s)[掺进饭里的药粒]]</span></span>。<br>鼻子凑过去，苦味更重了。</p><p class="voice">(set: _inkText to "“这也能吃吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这也能吃吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 8))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 8)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这也能吃吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 8)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">还是吃一点</span><span class=\"choice-detail\">肚子实在太饿了。</span>", "猫_咀嚼")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">把食碗推开</span><span class=\"choice-detail\">你不喜欢这个味道。</span>", "猫_推碗")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:33%"></span></div></section>

:: 猫_推碗 {"position": "240,540", "size": "180,100"}
<section data-scene="猫_推碗" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>推开食碗</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="猫用爪子把装有药物的食碗推向笼门" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你把碗推到门边，<span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">响声传进走道，没人停下来。</span><span class="word-value">(link: "瓷碗碰到栏杆，叮的一声。")[(transition: "dissolve")+(transition-time: .55s)[响声传进走道，没人停下来。]]</span></span><br>门外的人低头看了看，又把碗推回来。</p><p class="voice">(set: _inkText to "“吃吧，吃完就带你走。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“吃吧，吃完就带你走。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“吃吧，吃完就带你走。”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">低头吃一点</span><span class=\"choice-detail\">你还在惦记刚才说好的猫窝。</span>", "猫_目光")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:37%"></span></div></section>

:: 猫_咀嚼 {"position": "480,540", "size": "180,100"}
<section data-scene="猫_咀嚼" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>苦味</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="食碗中出现了写着兴奋的胶囊" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“就吃一口。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“就吃一口。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 7))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 7)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“就吃一口。”</span></span>](click: ?spokenLine)[(set: _inkCount to 7)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="interaction" data-task="chew" data-goal="1"><p class="instructions">饭里的硬东西硌到了牙。</p><button type="button" class="action-button" data-task-action>尝试咀嚼</button><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">咬一咬，再咽下去。</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "吞咽下去 →", "猫_色彩")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:38%"></span></div></section>

:: 猫_色彩 {"position": "720,540", "size": "180,100"}
<section data-scene="猫_色彩" class="page scene-stage role-cat is-colour-scene" data-sound="catDream" data-fx="colour"><div class="chapter"><span class="number">04</span><span>突然亮起来的笼子</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/5.jpg" alt="原本灰暗的猫笼变成低饱和的粉、蓝、绿等彩色斑块" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">“咦，(text-colour: "#666666")[(text-style: "shadow")[世界突然有了色彩]]。”</p><p class="thought"><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">你已经站不太稳了</span><span class="word-value">|sweetBars>[栏杆变成了粉色]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?sweetBars)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "栏杆变成了粉色", "地面也晃了起来", "你已经站不太稳了"))]](if: _wordStep >= 3)[(stop:)]]。身上也轻飘飘的。<br>你想站起来，却差点撞上笼门。</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "有人把你抱了起来 →", "猫_提笼")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:48%"></span></div></section>

:: 猫_新家 {"position": "960,540", "size": "180,100"}
<section data-scene="猫_新家" class="page scene-stage role-cat " data-sound="catDream" data-fx="warmth"><div class="chapter"><span class="number">05</span><span>到家了</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="有地毯、绿植、沙发和猫画像的柔和房间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>这里就是家吗？</h1><p class="voice">(set: _inkText to "“沙发好软。我真的可以睡在这里？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“沙发好软。我真的可以睡在这里？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 17))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 17)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“沙发好软。我真的可以睡在这里？”</span></span>](click: ?spokenLine)[(set: _inkCount to 17)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p class="thought">(link: "看看沙发")[你踩了两下，爪子陷进软垫里。]　·　(link: "看看墙上的画")[画里也有一只猫。你盯着它看了一会儿。]</p>(if: $catTag)[<div class="memory"><span>你记得</span>笼门上的纸写着“健康、活泼”。你现在却连尾巴都抬不动。</div>]<p class="thought">才过了一会儿，(text-style: "blur")[头越来越沉]，身上也热得难受。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">靠近旁边的水碗</span><span class=\"choice-detail\">嘴里一直发干。</span>", "猫_水碗")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">走到窗边</span><span class=\"choice-detail\">那里好像凉快一点。</span>", "猫_窗边")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:61%"></span></div></section>

:: 猫_窗边 {"position": "1200,540", "size": "180,100"}
<section data-scene="猫_窗边" class="page scene-stage role-cat " data-sound="catDream"><div class="chapter"><span class="number">05</span><span>没能跳上去</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="温暖房间的窗户透进朦胧的光" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你想跳上窗台，后腿一软，摔回了地毯上。<br>带你回来的人赶紧把你抱起来。</p><p class="voice"><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">“先去医院。现在就去。”</span><span class="word-value">(link: "“明明说是健康的……”")[(transition: "dissolve")+(transition-time: .55s)[“先去医院。现在就去。”]]</span></span></p><p class="thought">手掌贴在你的额头上。有人开始翻找手机。</p><p class="thought macro-line">(seq-link: "来时的笼子还放在门边。", "旁边压着那张写着“健康”的纸。", "他们拍下了标签，又拿起了电话。")</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "眼前渐渐模糊 →", "猫_水碗")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:70%"></span></div></section>

:: 猫_祭司 {"position": "1440,540", "size": "180,100"}
<section data-scene="猫_祭司" class="page scene-stage role-cat " data-sound="catPriest"><div class="chapter"><span class="number">06</span><span>半梦半醒</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.6"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/7%E7%A5%AD%E5%8F%B8%E8%AF%B4%E8%AF%9D%E7%8C%AB.jpg" alt="背着十字架、戴着骨饰的猫祭司站在猫面前" width="2560" height="1600" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你昏昏沉沉地趴着。一个高大的影子出现在面前。</p><p class="voice">“跟我走吧，过去就(text-style: "fade-in-out")[不用再疼了]。”</p><p class="thought">影子后面有一扇门。身旁却一直有人在叫你：<br>“醒醒，我们到医院了。”</p>(if: $catSignal)[<p class="thought">你认得那个人的声音。刚才你只叫出一点，它也听见了。</p>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">前往 · 回到人声里</span><span class=\"choice-detail\">你还想回那个家。</span>", "猫_醒来")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">放弃 · 我太累了</span><span class=\"choice-detail\">你已经听不清身边的话。</span>", "猫_告别")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:78%"></span></div></section>

:: 猫_醒来 {"position": "0,720", "size": "180,100"}
<section data-scene="猫_醒来" class="page scene-stage role-cat " data-sound="catDream" data-fx="warmth"><div class="chapter"><span class="number">07</span><span>选择 A · 前往</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="暖黄的灯光映出房间的轮廓" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>你动了一下爪子</h1><p class="voice">(set: _inkText to "“它动了。医生，它刚才动了！”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“它动了。医生，它刚才动了！”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“它动了。医生，它刚才动了！”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>你费力睁开眼睛，闻到一股消毒水的气味。<br>刚才那个人还在旁边，外套都没来得及脱。</p><p class="thought">接下来的几天，你留在医院接受治疗。</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "几天以后 →", "猫_探望")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:90%"></span></div></section>

:: 猫_告别 {"position": "240,720", "size": "180,100"}
<section data-scene="猫_告别" class="page scene-stage role-cat ending ending-cat-dark" data-sound="catEnd" data-fx="farewell"><div class="chapter"><span class="number">07</span><span>选择 B · 放弃</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.6" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/7%E7%A5%AD%E5%8F%B8%E8%AF%B4%E8%AF%9D%E7%8C%AB.jpg" alt="猫闭上双眼，祭司的身影逐渐隐入黑暗" width="2560" height="1600" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“我想再睡一会儿。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“我想再睡一会儿。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 10))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 10)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“我想再睡一会儿。”</span></span>](click: ?spokenLine)[(set: _inkCount to 10)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>你朝那个影子走去。它慢慢推开了门。<br>床边的人又叫了你几声，你没有听见。</p><p class="thought">医生继续抢救。监护仪的声音却慢了下来。</p><div class="story-whisper" data-whisper="lastVoice"><span class="whisper-label">床边</span><span class="whisper-copy">|lastVoice>[有人一直握着你的前爪。]</span>(set: _echo to 1)(live: 1.2s)[(set: _echo to _echo + 1)(replace: ?lastVoice)[(transition: "dissolve")+(transition-time: .6s)[(print: (nth: _echo, "有人一直握着你的前爪。", "你想蹭蹭那只手，已经没有力气了。", "“我在这儿。别怕。”"))]](if: _echo >= 3)[(stop:)]]</div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "后来 →", "猫_空提笼")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:90%"></span></div></section>

:: 猫_康复 {"position": "480,720", "size": "180,100"}
<section data-scene="猫_康复" class="page scene-stage role-cat ending" data-sound="themeEnd" data-ending="cat-light"><div class="chapter"><span class="number">08</span><span>结局 A · 前往</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="治疗后的猫回到了有沙发和猫窝的家" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 03 / 前往</div><h1>猫窝还给你留着</h1><p>病情稳定后，那个人来接你出院。<br><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">到家时，你自己走出了笼门，慢慢爬回那张沙发。</span><span class="word-value">(link: "到家时，你自己走出了笼门，慢慢爬回那张沙发。")[(transition: "dissolve")+(transition-time: .55s)[你一步步爬上沙发，这回后腿没再发软。]]</span></span></p><p>饭碗换了位置，水就在旁边。<br>你吃了几口，蜷进窗边的猫窝里。</p><p class="ending-note">【故事后续】他们留下检查记录和购猫凭据，举报了卖猫的人。</p><p class="closing">(set: _inkText to "这次可以好好睡一觉了。")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">这次可以好好睡一觉了。</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 11))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 11)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">这次可以好好睡一觉了。</span></span>](click: ?spokenLine)[(set: _inkCount to 11)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再玩一次 ↻", "猫_牢笼")</span><span>(transition-arrive: "instant")(link-goto: "下一个故事 · 鸭子 ↗", "鸭_泥沼")</span><span>(transition-arrive: "instant")(link-goto: "查看结局记录", "旅程手记")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: 猫_离去 {"position": "720,720", "size": "180,100"}
<section data-scene="猫_离去" class="page scene-stage role-cat ending" data-sound="themeEnd" data-ending="cat-sleep"><div class="chapter"><span class="number">08</span><span>结局 B · 放弃</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.6"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/8.jpg" alt="屏幕上的新闻记录了猫贩骗局被调查的消息" width="2560" height="1600" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 04 / 放弃</div><h1>没住够的家</h1><p>抢救没能留住你。你只在新家待了不到一天。<br><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">他们没收起你的猫窝，还放在原来的位置。</span><span class="word-value">(link: "那个人回到家时，窗边的猫窝还空着。")[(transition: "dissolve")+(transition-time: .55s)[他们没收起你的猫窝，还放在原来的位置。]]</span></span></p><p class="ending-note">【故事后续】他们拿着检查记录报了案。<br>卖家用药物掩盖病情、把病猫当健康猫出售的事，开始接受调查。</p><p class="closing">(set: _inkText to "沙发上还留着几根你的毛。")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">沙发上还留着几根你的毛。</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">沙发上还留着几根你的毛。</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再玩一次 ↻", "猫_牢笼")</span><span>(transition-arrive: "instant")(link-goto: "下一个故事 · 鸭子 ↗", "鸭_泥沼")</span><span>(transition-arrive: "instant")(link-goto: "查看结局记录", "旅程手记")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: 鸭_泥沼 {"position": "960,720", "size": "180,100"}
(set: $duckFence to false)(set: $duckAsked to false)(set: $duckTracks to false)(set: $duckFallen to false)(set: $duckCrate to false)(set: $duckPrice to false)(set: $duckHelp to false)(set: $duckShare to false)<section data-scene="鸭_泥沼" class="page scene-stage role-duck " data-sound="duckOpen" data-fx="halo"><div class="chapter"><span class="number">01</span><span>围栏里面</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD1.jpg" alt="头顶光晕的鸭子站在色彩浓烈的泥沼中" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>这里就是全部吗？</h1><p>你从小就住在这片泥地里。围栏很高，水一直很浑。<br>每只鸭子头顶都有(text-style: "outline")[一圈光]。</p><p class="voice">“<span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">吃饱了就能离开泥地</span><span class="word-value">(link: "这就是神的恩赐")[(transition: "dissolve")+(transition-time: .55s)[吃饱了就能离开泥地]]</span></span>。”大家都这么说。</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "先到水边看看 →", "鸭_水面")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:10%"></span></div></section>

:: 鸭_拥挤 {"position": "1200,720", "size": "180,100"}
<section data-scene="鸭_拥挤" class="page scene-stage role-duck " data-sound="duckOpen"><div class="chapter"><span class="number">02</span><span>开饭了</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="一群彩色的鸭子向前挤去" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“往哪儿挤？出了什么事？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“往哪儿挤？出了什么事？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“往哪儿挤？出了什么事？”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>“神明来了！今天又有粮！”</p><div class="story-whisper" data-whisper="crowdEcho"><span class="whisper-label">身后的声音</span><span class="whisper-copy">|crowdEcho>[“往前点，后面的都吃不到了。”]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "再听一次 ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?crowdEcho)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "“往前点，后面的都吃不到了。”", "一只脚踩住了你的尾羽。你赶紧往旁边躲。", "前面又挤了起来。没人肯往后退。"))]]]</span></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "跟上去看看 →", "鸭_开门")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:23%"></span></div></section>

:: 鸭_神迹 {"position": "1440,720", "size": "180,100"}
<section data-scene="鸭_神迹" class="page scene-stage role-duck " data-sound="duckWorship" data-fx="halo"><div class="chapter"><span class="number">02</span><span>它们说的天堂</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="鸭群在高高的人类形象周围聚集，像在朝拜神明" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">“多吃点。吃得壮，才会<span class="cycle-word word-slot" title="点击切换文字"><span class="word-measure" aria-hidden="true">被挑选</span><span class="word-value">(cycling-link: "被挑选", "被称重", "被带走")</span></span>。”</p><p class="thought">听说被选中的鸭子会离开这里，去没有泥水的天堂。<br>去过的鸭子，一只也没回来过。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">挤到前面抢粮</span><span class=\"choice-detail\">再等下去就吃不到了。</span>", "鸭_争夺")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先扶起旁边的鸭子</span><span class=\"choice-detail\">它被挤倒了，翅膀还陷在泥里。</span>", "鸭_同伴")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:36%"></span></div></section>

:: 鸭_同伴 {"position": "0,900", "size": "180,100"}
<section data-scene="鸭_同伴" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">02</span><span>被踩住的翅膀</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="拥挤的鸭群里，有一只鸭子落在后方" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckHelp to true)<p><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">你用身体顶住后面的鸭子，挤出一点空地。</span><span class="word-value">(link: "你用身体顶住后面的鸭子，挤出一点空地。")[(transition: "dissolve")+(transition-time: .55s)[你挡着挤过来的鸭子，等它把翅膀抽出来。]]</span></span><br>它收回翅膀，晃了几下才站稳。</p><p class="voice">(set: _inkText to "“谢谢。快去吧，要撒完了。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“谢谢。快去吧，要撒完了。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“谢谢。快去吧，要撒完了。”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "转身去抢粮 →", "鸭_伤翅")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:43%"></span></div></section>

:: 鸭_争夺 {"position": "240,900", "size": "180,100"}
<section data-scene="鸭_争夺" class="page scene-stage role-duck task-duck" data-sound="duckInteract"><div class="chapter"><span class="number">03</span><span>挤进去</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/4.jpg" alt="鸭子争抢神明撒下的粮食" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>抢不到就没得吃</h1><p class="voice">(set: _inkText to "你张开翅膀往前挤。羽毛被扯住，脚下也踩到了什么。\n可粮就那么一点，谁都不肯让。")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">你张开翅膀往前挤。羽毛被扯住，脚下也踩到了什么。<br>可粮就那么一点，谁都不肯让。</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 39))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 39)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">你张开翅膀往前挤。羽毛被扯住，脚下也踩到了什么。<br>可粮就那么一点，谁都不肯让。</span></span>](click: ?spokenLine)[(set: _inkCount to 39)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="interaction" data-task="duel" data-goal="6"><p class="instructions">交替点击左右两只鸭子，挤过去抢粮。</p><div class="duel"><button type="button" class="duel-target" data-task-action data-duck-target="0" aria-label="冲撞左侧鸭子"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/4.jpg" alt="张开翅膀的粉色鸭子"><span class="target-label" data-target-life>还需 3 次</span></button><button type="button" class="duel-target" data-task-action data-duck-target="1" aria-label="冲撞右侧鸭子"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/4%201.jpg" alt="张开翅膀的紫色鸭子"><span class="target-label" data-target-life>还需 3 次</span></button></div><div class="duel-status"><span>粮食 <strong data-grains>0</strong> / 6</span><span>先挤到前面去</span></div><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">左边挤不动，就试试右边。</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "看看抢到了多少 →", "鸭_散场")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:50%"></span></div></section>

:: 鸭_粮食 {"position": "480,900", "size": "180,100"}
<section data-scene="鸭_粮食" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>抢到的粮</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="争抢之后的鸭群渐渐安静下来" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>只有这么一点</h1><p><span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">你把粮护在身前，数了数，只有六粒。</span><span class="word-value">(link: "你把粮护在身前，数了数，只有六粒。")[(transition: "dissolve")+(transition-time: .55s)[挤了这么久，你只抢到六粒粮。]]</span></span></p>(if: $duckHelp)[<p class="thought">刚才那只鸭子站在旁边。它没抢到，翅膀还在抖。</p>](else:)[<p class="thought">旁边有只鸭子低头啄着泥，像是在找漏下的粮。</p>](if: $duckFallen)[<p class="thought">你刚看见，有的鸭子并不是不肯争，只是连站起来的地方都没有。</p>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">自己吃完</span><span class=\"choice-detail\">你也饿了一整天。</span>", "鸭_独食")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">分出一半</span><span class=\"choice-detail\">让旁边那只也吃一点。</span>", "鸭_分食")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:58%"></span></div></section>

:: 鸭_独食 {"position": "720,900", "size": "180,100"}
<section data-scene="鸭_独食" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>轮到你了</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="鸭子向着投粮者的方向仰望" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你赶紧把粮吃下去。<span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">它看了你一眼，伸手抓向你的翅膀。</span><span class="word-value">|choosingHand>[那只手朝你伸了过来。]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?choosingHand)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "那只手朝你伸了过来。", "刚才撒粮的人蹲了下来。", "它看了你一眼，伸手抓向你的翅膀。"))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">(set: _inkText to "“是我吗？这次真的轮到我了？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“是我吗？这次真的轮到我了？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“是我吗？这次真的轮到我了？”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p class="thought">它抓住你的翅膀，把你提了起来。</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "被放上秤盘 →", "鸭_悬空")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:63%"></span></div></section>

:: 鸭_分食 {"position": "960,900", "size": "180,100"}
<section data-scene="鸭_分食" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>三粒粮</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="鸭群在泥沼中彼此靠近" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckShare to true)<p>你把三粒粮推到旁边。<span class="reveal-word word-slot" title="点击展开这句话"><span class="word-measure" aria-hidden="true">它很快就吃完了</span><span class="word-value">(link: "它很快就吃完了")[(transition: "dissolve")+(transition-time: .55s)[它一直饿着肚子]]</span></span>。</p><p class="voice">(set: _inkText to "“还有吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“还有吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 6))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 6)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“还有吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 6)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>你低头看看自己剩下的三粒，还没来得及吃，<br>一只手就抓住了你的翅膀。</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "被放上秤盘 →", "鸭_悬空")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:63%"></span></div></section>

:: 鸭_天平 {"position": "1200,900", "size": "180,100"}
<section data-scene="鸭_天平" class="page scene-stage role-duck " data-sound="duckScales" data-fx="scales"><div class="chapter"><span class="number">04</span><span>称重</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD5.jpg" alt="神圣的天平一边是蓝色的鸭子，一边是沉重的红色祭品" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>原来是在称重</h1><p class="voice">(set: _inkText to "“它在看什么？我够不够虔诚吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“它在看什么？我够不够虔诚吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“它在看什么？我够不够虔诚吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>秤盘晃了几下。那个人盯着刻度，只关心<span class="cycle-word word-slot" title="点击切换文字"><span class="word-measure" aria-hidden="true">能卖出的价钱</span><span class="word-value">(cycling-link: "你的体重", "能卖出的价钱", "能切下多少肉")</span></span>。</p>(if: $duckShare)[<p class="thought">刚才分出去的三粒粮，似乎也没让指针少动多少。</p>](else:)[<p class="thought">你拼命抢来的粮，会让你再重一点，也更早被带走。</p>]<div class="story-whisper" data-whisper="scaleReply"><span class="whisper-label">秤盘上</span><span class="whisper-copy">|scaleReply>[你动了一下，指针跟着晃。]</span>(set: _echo to 1)(live: 1.2s)[(set: _echo to _echo + 1)(replace: ?scaleReply)[(transition: "dissolve")+(transition-time: .6s)[(print: (nth: _echo, "你动了一下，指针跟着晃。", "有人伸手按住你，又低头看了一眼秤。", "“这只差不多了。”"))]](if: _echo >= 3)[(stop:)]]</div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "抬起头 →", "鸭_记号")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:72%"></span></div></section>

:: 鸭_祭司 {"position": "1440,900", "size": "180,100"}
<section data-scene="鸭_祭司" class="page scene-stage role-duck " data-sound="duckEnd" data-fx="altar"><div class="chapter"><span class="number">05</span><span>祭司转过身</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="鸭祭司转身望向屏幕之外的玩家" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>它在问屏幕外的你</h1><p class="voice">“人类，你觉得自己是(text-style: "shadow")[造物主]吗？”</p><div class="story-whisper" data-whisper="outsideScreen"><span class="whisper-label">它看着你</span><span class="whisper-copy">|outsideScreen>[祭司转过头，盯着屏幕外。]</span>(after: 1.6s)[(replace: ?outsideScreen)[(transition: "dissolve")+(transition-time: .8s)[它没有接着说。你得自己选一个回答。]]]</div><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">是</span><span class=\"choice-detail\">人能决定别的动物怎样生活。</span>", "鸭_能决定")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">否</span><span class=\"choice-detail\">人也是自然中的一种动物。</span>", "鸭_也在其中")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:83%"></span></div></section>

:: 鸭_是 {"position": "0,1080", "size": "180,100"}
<section data-scene="鸭_是" class="page scene-stage role-duck ending data-ending" data-sound="themeEnd" data-ending="duck-yes"><div class="chapter"><span class="number">06</span><span>结局 A · 是</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="鸭祭司静静凝视着屏幕外的人类" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 05 / 是</div><h1>能决定，然后呢？</h1><p class="voice">(set: _inkText to "“那这些事发生的时候，你打算怎么办？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“那这些事发生的时候，你打算怎么办？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 19))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 19)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“那这些事发生的时候，你打算怎么办？”</span></span>](click: ?spokenLine)[(set: _inkCount to 19)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="facts"><article class="fact"><strong>44 万亿</strong><h2>美元的经济价值，依赖自然</h2><p>世界经济论坛在 2020 年估计，超过一半的全球 GDP 中度或高度依赖自然及其提供的服务。</p><a href="https://www.weforum.org/publications/nature-risk-rising-why-the-crisis-engulfing-nature-matters-for-business-and-the-economy/" target="_blank" rel="noopener noreferrer">WEF · Nature Risk Rising · 2020 ↗</a></article><article class="fact"><strong>73%</strong><h2>监测到的野生动物种群规模平均下降</h2><p>WWF《地球生命力报告 2024》记录：1970—2020 年，受监测的脊椎动物种群规模平均下降 73%。</p><a href="https://livingplanet.panda.org/" target="_blank" rel="noopener noreferrer">WWF · Living Planet Report · 2024 ↗</a></article><article class="fact"><strong>约 100 万</strong><h2>动植物物种面临灭绝威胁</h2><p>IPBES 在 2019 年全球评估中指出，约一百万种动植物面临灭绝威胁，其中许多可能在数十年内消失。</p><a href="https://www.ipbes.net/global-assessment" target="_blank" rel="noopener noreferrer">IPBES · Global Assessment · 2019 ↗</a></article></div><p class="facts-note">73% 是受监测种群规模指数的平均变化，不代表所有动物个体减少了 73%。各项数据的年份和来源见卡片。</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再玩一次 ↻", "鸭_泥沼")</span><span>(transition-arrive: "instant")(link-goto: "换个角色 ↗", "选择角色")</span><span>(transition-arrive: "instant")(link-goto: "查看结局记录", "旅程手记")</span></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: 鸭_否 {"position": "240,1080", "size": "180,100"}
<section data-scene="鸭_否" class="page scene-stage role-duck ending data-ending" data-sound="themeEnd" data-ending="duck-no"><div class="chapter"><span class="number">06</span><span>结局 B · 否</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="鸭祭司向屏幕外的人类提出最后一个问题" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 06 / 否</div><h1>它们也得有地方活</h1><p class="voice">(set: _inkText to "“可它们住哪里、吃什么、什么时候被带走，\n不还是人说了算吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“可它们住哪里、吃什么、什么时候被带走，<br>不还是人说了算吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 31))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 31)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“可它们住哪里、吃什么、什么时候被带走，<br>不还是人说了算吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 31)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="facts"><article class="fact"><strong>塑料</strong><h2>丢掉以后，它去了哪里？</h2><p>流入水生环境的塑料会通过误食、缠绕和生境污染，影响水生生物的生存。</p><a href="https://www.unep.org/plastic-pollution" target="_blank" rel="noopener noreferrer">UNEP · Plastic pollution ↗</a></article><article class="fact"><strong>生境</strong><h2>动物需要能生活的地方</h2><p>土地与海洋利用变化、直接利用生物、气候变化、污染和外来入侵物种，是生物多样性丧失的主要直接驱动因素。</p><a href="https://www.ipbes.net/global-assessment" target="_blank" rel="noopener noreferrer">IPBES · Global Assessment · 2019 ↗</a></article><article class="fact"><strong>日常</strong><h2>能从哪些小事做起？</h2><p>少用一次性塑料，不买来源不明的野生动物，了解宠物的来源。看见非法交易，可以保留证据并举报。</p><a href="https://www.unep.org/" target="_blank" rel="noopener noreferrer">UNEP · 为自然而行动 ↗</a></article></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再玩一次 ↻", "鸭_泥沼")</span><span>(transition-arrive: "instant")(link-goto: "换个角色 ↗", "选择角色")</span><span>(transition-arrive: "instant")(link-goto: "查看结局记录", "旅程手记")</span></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: 旅程手记 {"position": "480,1080", "size": "180,100"}
<section data-scene="旅程手记" class="page journal" data-sound="themeEnd"><div class="journal-head"><div class="eyebrow">JOURNAL / 结局记录</div><h1>旅程手记</h1><p>已完成 <span data-journal-total>0/6</span> 个结局 · 记录保存在当前浏览器</p></div><div class="journal-grid"><article class="journal-role" data-card-label="野猪"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%87%8E%E7%8C%AA%E9%80%8F%E6%98%8E.png" alt="野猪剪影"><div class="role-no">01 / THE FOREST</div><h2>野猪</h2><div class="journal-entry" data-entry="pig-live" data-description="你离开机器，找到溪水和野果，在森林里活了下来。"><span class="entry-state">尚未完成 / UNDISCOVERED</span><h3>回到林子里</h3><p class="entry-copy">走完这条路线后，这里会记下结局。</p></div><div class="journal-entry" data-entry="pig-fall" data-description="你一直跟着机器。树被砍完后，它走了，没给你留下吃的。"><span class="entry-state">尚未完成 / UNDISCOVERED</span><h3>它没有回头</h3><p class="entry-copy">走完这条路线后，这里会记下结局。</p></div><div class="role-enter">(transition-arrive: "instant")(link-goto: "再玩一次 ↗", "猪_森林")</div></article><article class="journal-role" data-card-label="猫"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E7%8C%AB%E9%80%8F%E6%98%8E.png" alt="猫剪影"><div class="role-no">02 / THE HOME</div><h2>猫</h2><div class="journal-entry" data-entry="cat-light" data-description="你在医院醒来，接受治疗。病情稳定后，有人接你回家。"><span class="entry-state">尚未完成 / UNDISCOVERED</span><h3>猫窝还给你留着</h3><p class="entry-copy">走完这条路线后，这里会记下结局。</p></div><div class="journal-entry" data-entry="cat-sleep" data-description="抢救没能留住你。带你回家的人留下病历，举报了卖家。"><span class="entry-state">尚未完成 / UNDISCOVERED</span><h3>没住够的家</h3><p class="entry-copy">走完这条路线后，这里会记下结局。</p></div><div class="role-enter">(transition-arrive: "instant")(link-goto: "再玩一次 ↗", "猫_牢笼")</div></article><article class="journal-role" data-card-label="鸭子"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%B8%AD%E5%AD%90%E9%80%8F%E6%98%8E.png" alt="鸭子剪影"><div class="role-no">03 / THE ALTAR</div><h2>鸭子</h2><div class="journal-entry" data-entry="duck-yes" data-description="你回答“是”。祭司问，你打算怎样对待这些动物。"><span class="entry-state">尚未完成 / UNDISCOVERED</span><h3>能决定，然后呢？</h3><p class="entry-copy">走完这条路线后，这里会记下结局。</p></div><div class="journal-entry" data-entry="duck-no" data-description="你回答“否”。祭司提醒你，动物的生活仍在被人决定。"><span class="entry-state">尚未完成 / UNDISCOVERED</span><h3>它们也得有地方活</h3><p class="entry-copy">走完这条路线后，这里会记下结局。</p></div><div class="role-enter">(transition-arrive: "instant")(link-goto: "再玩一次 ↗", "鸭_泥沼")</div></article></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "返回选角 →", "选择角色")</span><span>(transition-arrive: "instant")(link-goto: "回到首页", "开始")</span></div></section>

:: 猪_溪水 {"position": "720,1080", "size": "180,100"}
<section data-scene="猪_溪水" class="page scene-stage role-pig expanded-scene" data-fx="forest" data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>今天的水浅了</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="幽蓝的树林与林间小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你本来只是来喝水。昨天还能没过蹄子的地方，今天只剩一条细流。水面漂着碎叶，上游还传来咚咚的响声。你用鼻子拱了拱石缝，没找到藏在下面的小虫。</p><p class="voice">(set: _inkText to "“昨天还不是这样。上面到底怎么了？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“昨天还不是这样。上面到底怎么了？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 18))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 18)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“昨天还不是这样。上面到底怎么了？”</span></span>](click: ?spokenLine)[(set: _inkCount to 18)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">看看岸边的泥</span><span class=\"choice-detail\">泥里有你不认识的印子。</span>", "猪_泥印")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">去旧树下面找吃的</span><span class=\"choice-detail\">那里常有落下的果子。</span>", "猪_树根")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:10%"></span></div></section>

:: 猪_泥印 {"position": "960,1080", "size": "180,100"}
<section data-scene="猪_泥印" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>不是蹄印</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="幽蓝的树林与林间小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigWater to true)<p>泥岸被压出两道很深的沟，横着穿过溪水。你把一只蹄子放进去，比了比，连沟的一半都填不满。两边的泥被挤进水里，水绕不过去，只能慢慢往石头下面渗。</p><p class="voice">(set: _inkText to "“这得多重啊。它也从这里喝水？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这得多重啊。它也从这里喝水？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这得多重啊。它也从这里喝水？”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "顺着印子往上走 →", "猪_土坡")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:12%"></span></div></section>

:: 猪_树根 {"position": "1200,1080", "size": "180,100"}
<section data-scene="猪_树根" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>空了的树下</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="幽蓝的树林与林间小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigRoots to true)<p>你记得树根旁有一小堆熟果，昨天还没吃完。现在树枝横在地上，果子埋进了泥。你翻出一颗，咬下去全是沙，赶紧吐了。树皮上还留着很新的一道刮痕。</p><p class="voice">(set: _inkText to "“我才离开一会儿。谁把这里弄成这样？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“我才离开一会儿。谁把这里弄成这样？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 19))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 19)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“我才离开一会儿。谁把这里弄成这样？”</span></span>](click: ?spokenLine)[(set: _inkCount to 19)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "从土坡上看看 →", "猪_土坡")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:12%"></span></div></section>

:: 猪_土坡 {"position": "1440,1080", "size": "180,100"}
<section data-scene="猪_土坡" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>树梢在往下沉</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="树林边缘的伐木机" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你爬上土坡，正好看见一片树梢慢慢往下沉。鸟叫突然密起来，几只鸟从枝叶里冲出去。那个声音停了一下，又响起来，比刚才更近。你往后缩了半步。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先停下来听听</span><span class=\"choice-detail\">看看它会不会靠过来。</span>", "猪_停听")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">走到空地边</span><span class=\"choice-detail\">躲在树后面看。</span>", "猪_巨兽")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:14%"></span></div></section>

:: 猪_停听 {"position": "0,1260", "size": "180,100"}
<section data-scene="猪_停听" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>它没有停下来</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="树林边缘的伐木机" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你伏在坡后，数着它的声音。响一阵，停一下，又响一阵。停下的时候，没有喘气声，也听不到啃食的声音。只有树枝折断以后，远处传来一阵沙沙响。</p><p class="voice">(set: _inkText to "“吃这么多，还不歇一会儿？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“吃这么多，还不歇一会儿？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“吃这么多，还不歇一会儿？”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再看清楚一点 →", "猪_巨兽")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:15%"></span></div></section>

:: 猪_路标 {"position": "240,1260", "size": "180,100"}
<section data-scene="猪_路标" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>把来路记住</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="幽蓝的树林与林间小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigMarked to true)<p>小径的入口被倒下的枝叶遮住了。从空地回头看，很容易走过头。你把一截白色枯枝拱到老树旁，又在树根上蹭掉一点泥。离开时，只要找到它们，就能认出路口。</p><p class="voice">(set: _inkText to "“从这里回去。别走错了。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“从这里回去。别走错了。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“从这里回去。别走错了。”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "回到空地旁 →", "猪_靠近")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:23%"></span></div></section>

:: 猪_倒树 {"position": "480,1260", "size": "180,100"}
<section data-scene="猪_倒树" class="page scene-stage role-pig expanded-scene" data-fx="machine" data-sound="pigOpen"><div class="chapter"><span class="number">02</span><span>倒下的那棵树</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="伐木机靠近，钢铁轮盘露在树间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>断树倒在你常走的地方。树冠压住了灌木，叶子还在抖。你本想从下面钻过去，鼻尖却碰到湿漉漉的木头。平时遮雨的那片阴凉，整个翻到了地上。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">看看原来的树洞</span><span class=\"choice-detail\">洞口被枝叶挡住了。</span>", "猪_树洞")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">闻闻断开的树干</span><span class=\"choice-detail\">树心的气味很重。</span>", "猪_树心")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:28%"></span></div></section>

:: 猪_树洞 {"position": "720,1260", "size": "180,100"}
<section data-scene="猪_树洞" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">02</span><span>雨天躲过的地方</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="幽蓝的树林与林间小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigShelter to true)<p>树洞的底翻出来了，里面的干叶子散了一地。你以前在这里挤着睡过，鼻子贴着树皮，外面下大雨也淋不到。你拱了拱那堆叶子，已经没有能钻进去的口子。</p><p class="voice">(set: _inkText to "“下雨的时候，我还能去哪儿？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“下雨的时候，我还能去哪儿？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“下雨的时候，我还能去哪儿？”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "身后亮了起来 →", "猪_光芒")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:30%"></span></div></section>

:: 猪_树心 {"position": "960,1260", "size": "180,100"}
<section data-scene="猪_树心" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">02</span><span>里面也不是食物</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="伐木机靠近，钢铁轮盘露在树间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigRings to true)<p>树干断面一圈套着一圈，湿润得像刚被咬开的果子。可你舔了一下，只有涩味。大家伙扯掉树枝，又把长长的树干拖到一边。它折了这么多树，却没有把树干吃下去。</p><p class="voice">(set: _inkText to "“不吃？那它弄倒树干什么？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“不吃？那它弄倒树干什么？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“不吃？那它弄倒树干什么？”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "抬头看看它 →", "猪_光芒")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:30%"></span></div></section>

:: 猪_铁壳 {"position": "1200,1260", "size": "180,100"}
<section data-scene="猪_铁壳" class="page scene-stage role-pig expanded-scene" data-sound="pigOpen"><div class="chapter"><span class="number">02</span><span>壳下面有人</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="伐木机靠近，钢铁轮盘露在树间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你绕到侧面，看见硬壳高处有一块透明的东西。后面晃着一个影子。影子动一下，巨大的铁臂就抬起来；影子停住，铁臂也停住了。你踮着蹄子，还是看不清它的脸。</p><p class="voice">(set: _inkText to "“它肚子里还有个东西？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“它肚子里还有个东西？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“它肚子里还有个东西？”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "回到灯光前 →", "猪_撞击")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:41%"></span></div></section>

:: 猪_试探 {"position": "1440,1260", "size": "180,100"}
<section data-scene="猪_试探" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">04</span><span>它认得你吗</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/6%E6%9C%BA%E5%99%A8%E5%8F%98%E9%87%8E%E7%8C%AA.jpg" alt="野猪眼中长着獠牙的钢铁巨神" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你慢慢站直，把发麻的獠牙从泥里抬起来。巨神的脸上没有伤口。你刚才用尽了力气，它连头都没低过。也许它早就见过你，也许只是还没发现你站在这里。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">叫一声，等它回应</span><span class=\"choice-detail\">如果它听得懂呢？</span>", "猪_等回答")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">像它一样低下头</span><span class=\"choice-detail\">你不知道该怎么见神。</span>", "猪_低头")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:59%"></span></div></section>

:: 猪_等回答 {"position": "0,1440", "size": "180,100"}
<section data-scene="猪_等回答" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">04</span><span>没有回答</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/%E9%87%8E%E7%8C%AA%E8%AF%B4%E8%AF%9D.jpg" alt="野猪望着林间的巨神" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你短短地叫了一声。林子里没有别的野猪回答，巨神也没有。你又叫了一声，这次更响。灯光从你头顶扫过去，一根树枝在它身后断了，像是谁踩碎了一截干骨头。</p><p class="voice">(set: _inkText to "“我就在这里。你没听见吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“我就在这里。你没听见吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“我就在这里。你没听见吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "巨神忽然动了 →", "猪_喷气")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:63%"></span></div></section>

:: 猪_低头 {"position": "240,1440", "size": "180,100"}
<section data-scene="猪_低头" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">04</span><span>低头等着</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/6%E6%9C%BA%E5%99%A8%E5%8F%98%E9%87%8E%E7%8C%AA.jpg" alt="野猪眼中长着獠牙的钢铁巨神" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你压低前腿，学着它刚才的样子低下头。过了好一会儿，泥水渗进蹄子。巨神没有伸出獠牙碰你，也没有靠过来闻。你悄悄抬起一只眼睛，它还望着远处的树。</p><p class="voice">(set: _inkText to "“还不行吗？我要再低一点？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“还不行吗？我要再低一点？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“还不行吗？我要再低一点？”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "听见一声长响 →", "猪_喷气")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:63%"></span></div></section>

:: 猪_赠礼 {"position": "480,1440", "size": "180,100"}
<section data-scene="猪_赠礼" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">04</span><span>神明留下的东西</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="树林边缘的伐木机" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>白雾散了，巨神又往前走。你跟出几步，发现它身后铺着细细的木屑，还有刚切下来的树皮。你已经很久没吃东西，肚子又叫了一声。也许这些就是给你的。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">尝一点木屑</span><span class=\"choice-detail\">看看是不是能吃的。</span>", "猪_木屑")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先找个凉快的地方</span><span class=\"choice-detail\">太阳已经照到背上了。</span>", "猪_树荫")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:73%"></span></div></section>

:: 猪_木屑 {"position": "720,1440", "size": "180,100"}
<section data-scene="猪_木屑" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">04</span><span>咽不下去</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/5%E9%87%8E%E7%8C%AA%E9%9D%A0%E8%BF%91.jpg" alt="野猪站在机器前面" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigTasted to true)<p>你挑了一小片木屑，嚼了两下。硬刺扎进牙缝，舌头上全是苦味。你吐出来，在泥上蹭了蹭嘴。巨神已经走远，后面还落着同样的东西。没有果子，也没有根茎。</p><p class="voice">(set: _inkText to "“也许……这块不够好。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“也许……这块不够好。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“也许……这块不够好。”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "天开始暗了 →", "猪_黄昏")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:76%"></span></div></section>

:: 猪_树荫 {"position": "960,1440", "size": "180,100"}
<section data-scene="猪_树荫" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">04</span><span>影子不肯停</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="树林边缘的伐木机" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>树荫少了很多。你挪到巨神身后，它的影子刚好盖住你的背。可没歇多久，影子就移开了。你只好跟着走。它停下的时候，你才能喘口气；它再往前，你也得往前。</p><p class="voice">(set: _inkText to "“等一下。我还没歇够。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“等一下。我还没歇够。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“等一下。我还没歇够。”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "再跟出去一段 →", "猪_黄昏")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:76%"></span></div></section>

:: 猪_黄昏 {"position": "1200,1440", "size": "180,100"}
<section data-scene="猪_黄昏" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">05</span><span>天快黑了</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/%E9%87%8E%E7%8C%AA%E8%AF%B4%E8%AF%9D.jpg" alt="野猪望着林间的巨神" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>傍晚的风吹过空地。白天还连在一起的树冠，现在裂开了很大一块。你站在光秃秃的地方，突然不知道今晚该在哪儿躺下。巨神仍在叫，好像不需要睡觉。</p>(if: $pigShelter)[<p>你想起那个翻倒的树洞。里面的干叶子，这会儿大概已经湿了。</p>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">回头认一认来路</span><span class=\"choice-detail\">看看溪水还在什么方向。</span>", "猪_来路")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">再等一会儿</span><span class=\"choice-detail\">它也许会停下来。</span>", "猪_再等")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:79%"></span></div></section>

:: 猪_来路 {"position": "1440,1440", "size": "180,100"}
<section data-scene="猪_来路" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">05</span><span>还能认出来</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="幽蓝的树林与林间小径" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigRetraced to true)(if: $pigMarked)[<p>老树旁的白色枯枝还在。你把头朝那边转了转，小径藏在两丛叶子后面。只要走过去，就不用再追着巨神的影子跑。</p>](else:)[<p>你顺着风闻了很久，终于分出了溪边湿泥的气味。回去要绕一段路，可方向还没有丢。你往那边走了两步，又回过头看巨神。</p>](if: $pigWater)[<p>水沟被堵住的地方也在那边。至少你知道，可以从更上游找水。</p>]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "回到空地边做决定 →", "猪_抉择")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:82%"></span></div></section>

:: 猪_再等 {"position": "0,1620", "size": "180,100"}
<section data-scene="猪_再等" class="page scene-stage role-pig expanded-scene" data-sound="pigWorship"><div class="chapter"><span class="number">05</span><span>又等过一阵</span><span class="track"></span><small>野猪 / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="树林边缘的伐木机" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigWaited to true)<p>你等到地上的影子伸得很长。巨神停了一次，可那只是为了转向另一棵树。你跟着挪过去，空着的肚子疼了一下。它从没说过会喂你；这件事，你以前没有想过。</p><p class="voice">(set: _inkText to "“要是等到明天，它还不停呢？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“要是等到明天，它还不停呢？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“要是等到明天，它还不停呢？”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "天黑以前，做个决定 →", "猪_抉择")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:82%"></span></div></section>

:: 猫_隔壁 {"position": "240,1620", "size": "180,100"}
<section data-scene="猫_隔壁" class="page scene-stage role-cat expanded-scene" data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>隔壁还醒着</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="挤在铁栏杆后的猫" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catHeard to true)<p>隔壁的猫轻轻咳了一下。它说，昨天有人抱它出去，摸了摸，又放回原来的笼子。你问外面有没有窗台，它想了半天，说自己只记得头顶的灯很亮。</p><p class="voice">(set: _inkText to "“你要是出去了，替我看看太阳。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“你要是出去了，替我看看太阳。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“你要是出去了，替我看看太阳。”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "门锁响了一声 →", "猫_钥匙")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:10%"></span></div></section>

:: 猫_夜风 {"position": "480,1620", "size": "180,100"}
<section data-scene="猫_夜风" class="page scene-stage role-cat expanded-scene" data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>挪过去一点</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="挤在铁栏杆后的猫" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catCold to true)<p>你用爪子把薄布拢到肚子下面。旁边的猫动了一下，给你让出一点位置。你们挤在一起，总算没有那么冷。可门一开，风又从最下面那道缝钻了进来。</p><p class="voice">(set: _inkText to "“到外面以后，也会一直这么冷吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“到外面以后，也会一直这么冷吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 17))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 17)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“到外面以后，也会一直这么冷吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 17)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "有人走进来了 →", "猫_钥匙")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:10%"></span></div></section>

:: 猫_钥匙 {"position": "720,1620", "size": "180,100"}
<section data-scene="猫_钥匙" class="page scene-stage role-cat expanded-scene" data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>钥匙碰着笼门</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="挤在铁栏杆后的猫" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>钥匙一响，几只猫都抬起头。有人把上面的笼子搬到灯下，又把你这只挪到前面。你晃了一下，爪子没抓稳。那个人没有看你，只是拍掉袖子上的毛。</p><p class="voice">(set: _inkText to "“今天能出去吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“今天能出去吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 9))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 9)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“今天能出去吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 9)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "听见笼门外的交谈 →", "猫_交谈")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:12%"></span></div></section>

:: 猫_交谈 {"position": "960,1620", "size": "180,100"}
<section data-scene="猫_交谈" class="page scene-stage role-cat expanded-scene" data-sound="catOpen"><div class="chapter"><span class="number">02</span><span>门外的人声</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="挤在铁栏杆后的猫" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>一个陌生人蹲下来，把手指伸近笼门。“它怎么不太动？”旁边的人笑着说：“刚睡醒，脾气好。”你用力甩了甩尾巴，尾尖却只碰了一下地。陌生人的手还在等着。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">靠过去闻闻那只手</span><span class=\"choice-detail\">它没有急着抓你。</span>", "猫_光")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先看看走道外面</span><span class=\"choice-detail\">你还不知道门通到哪里。</span>", "猫_走道")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:16%"></span></div></section>

:: 猫_凭据 {"position": "1200,1620", "size": "180,100"}
<section data-scene="猫_凭据" class="page scene-stage role-cat expanded-scene" data-sound="catOpen"><div class="chapter"><span class="number">02</span><span>那张纸被收起来了</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="挤在铁栏杆后的猫" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catProof to true)<p>陌生人拿手机对着标签拍了一张，又把一张折好的纸装进包里。有人催：“放心吧，都是一样的。”陌生人没有马上走，先低头看你，问你是不是饿了。你舔了舔干燥的鼻子。</p><p class="voice">(set: _inkText to "“你会把我和那张纸一起带走吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“你会把我和那张纸一起带走吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“你会把我和那张纸一起带走吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "有人拿来食碗 →", "猫_换碗")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:25%"></span></div></section>

:: 猫_换碗 {"position": "1440,1620", "size": "180,100"}
<section data-scene="猫_换碗" class="page scene-stage role-cat expanded-scene" data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>饭送来之前</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/3.jpg" alt="放在猫面前的食碗" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>原来的空碗被拿走了。你闻到食物，忍不住往前蹭。外面的人说：“让它吃点，精神就好了。”陌生人把手收回去，站在笼门旁边等，没有跟着别人离开。</p><p class="voice">(set: _inkText to "“吃完就走，是不是？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“吃完就走，是不是？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 11))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 11)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“吃完就走，是不是？”</span></span>](click: ?spokenLine)[(set: _inkCount to 11)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "把鼻子凑过去 →", "猫_饭")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:27%"></span></div></section>

:: 猫_目光 {"position": "0,1800", "size": "180,100"}
<section data-scene="猫_目光" class="page scene-stage role-cat expanded-scene" data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>有人看见了</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="猫食碗里混着几粒胶囊" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catProof to true)<p>碗被推回来时，里面的一粒硬东西滚到了表面。陌生人伸头看了一眼，拿起了手机。旁边的人说是拌进去的营养品。你听不懂，只知道这一次，那只手没有再把你的头按向碗里。</p><p class="voice">(set: _inkText to "“你也觉得味道不对吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“你也觉得味道不对吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“你也觉得味道不对吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "肚子又响了一声 →", "猫_咀嚼")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:38%"></span></div></section>

:: 猫_提笼 {"position": "240,1800", "size": "180,100"}
<section data-scene="猫_提笼" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">04</span><span>第一次离开笼架</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/5.jpg" alt="猫眼中摇晃的彩色笼子" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>脚下忽然离地。你被放进另一个小笼子，底下垫着干净的布。门合上的时候，你吓得缩了一下，可原来那排笼子正在慢慢往后退。你第一次从它们的另一边经过。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">抬头看着外面</span><span class=\"choice-detail\">那个人的手就在旁边。</span>", "猫_抬头")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">钻进布下面</span><span class=\"choice-detail\">你有点怕晃动的光。</span>", "猫_藏起")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:51%"></span></div></section>

:: 猫_抬头 {"position": "480,1800", "size": "180,100"}
<section data-scene="猫_抬头" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">04</span><span>隔着提笼的手</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫所期待的房间和暖灯" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catTouch to true)<p>你把鼻子凑到小孔边。那个人停下来，用指背碰了碰你的脸。“快到了。”你听见这三个字重复了两遍。提笼晃起来时，旁边的手也跟着放慢了。</p>(if: $catHeard)[<p>你努力往亮的地方看，想记住太阳到底是什么样。</p>]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "提笼终于停下了 →", "猫_门槛")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:54%"></span></div></section>

:: 猫_藏起 {"position": "720,1800", "size": "180,100"}
<section data-scene="猫_藏起" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">04</span><span>布下面的声音</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫所期待的房间和暖灯" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你把头埋起来，只露出一只耳朵。外面的声音变低了，有风声，也有金属碰在一起的响声。那个人隔着提笼叫你，没有伸手把布掀开。你一点一点松开了抓紧布料的爪子。</p><p class="voice">(set: _inkText to "“再等一会儿。我就出来。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“再等一会儿。我就出来。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“再等一会儿。我就出来。”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "听见一扇门打开 →", "猫_门槛")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:54%"></span></div></section>

:: 猫_门槛 {"position": "960,1800", "size": "180,100"}
<section data-scene="猫_门槛" class="page scene-stage role-cat expanded-scene" data-fx="warmth" data-sound="catDream"><div class="chapter"><span class="number">05</span><span>门开着</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="有沙发和窗边猫窝的房间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>提笼被轻轻放在地上。门开了，外面没有另一排笼子。一个碗，一张软垫，还有离地很近的窗。那个人坐在旁边等。你试着伸出一只爪子，没有人把你推回去。</p>(if: $catCold)[<p>地板不凉，风也没有从肚子下面钻过来。你又往外挪了一点。</p>]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "慢慢走进房间 →", "猫_新家")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:57%"></span></div></section>

:: 猫_水碗 {"position": "1200,1800", "size": "180,100"}
<section data-scene="猫_水碗" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">05</span><span>水就在旁边</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/3.jpg" alt="放在猫面前的食碗" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>水就在鼻子前面，你却低不下头。你想再往前一点，前腿软了，碗边碰出一声轻响。那个人马上蹲下来，没有再让你自己走，把你和垫子一起抱了起来。</p><p class="voice">(set: _inkText to "“刚才还会走的。你怎么了？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“刚才还会走的。你怎么了？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“刚才还会走的。你怎么了？”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "听见电话接通 →", "猫_电话")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:71%"></span></div></section>

:: 猫_电话 {"position": "1440,1800", "size": "180,100"}
<section data-scene="猫_电话" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">05</span><span>电话那边</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="有沙发和窗边猫窝的房间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>有人在电话里问了很多话。抱着你的人一边回答，一边找钥匙。窗边那盏灯还亮着，猫窝也没有收走。你想把这些都记住，可眼睛已经睁不开了。</p>(if: $catProof)[<p>手机里还留着刚拍的照片。那个人把照片和那张纸一起找出来，放进包里。</p>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">用力叫一声</span><span class=\"choice-detail\">让那个人知道你还醒着。</span>", "猫_叫一声")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">把爪子搭在袖口上</span><span class=\"choice-detail\">你现在只抬得动一点。</span>", "猫_袖口")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:73%"></span></div></section>

:: 猫_叫一声 {"position": "0,1980", "size": "180,100"}
<section data-scene="猫_叫一声" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">05</span><span>只叫出很轻一声</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫所期待的房间和暖灯" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catSignal to true)<p>你攒了半天力气，只发出很轻的一声。那个人却立刻低下头：“我听见了。”手掌贴住你的背，没有把你放回地上。你听见包的拉链响，接着是急急的脚步。</p><p class="voice">(set: _inkText to "“别把我留在这里。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“别把我留在这里。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 10))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 10)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“别把我留在这里。”</span></span>](click: ?spokenLine)[(set: _inkCount to 10)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "跟着脚步声出去 →", "猫_夜路")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:75%"></span></div></section>

:: 猫_袖口 {"position": "240,1980", "size": "180,100"}
<section data-scene="猫_袖口" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">05</span><span>抓住一点布料</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫所期待的房间和暖灯" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你勾住了袖口的一点布。那个人停下来，把你的爪子托在手心里。“不松开也行。”你没有力气再抓紧了，可那只手一直没有抽走。门被打开，一阵风吹过你的耳朵。</p><p class="voice">(set: _inkText to "“那就让我抓一会儿。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“那就让我抓一会儿。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 11))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 11)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“那就让我抓一会儿。”</span></span>](click: ?spokenLine)[(set: _inkCount to 11)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "那只手一直托着你 →", "猫_夜路")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:75%"></span></div></section>

:: 猫_夜路 {"position": "480,1980", "size": "180,100"}
<section data-scene="猫_夜路" class="page scene-stage role-cat expanded-scene" data-sound="catPriest"><div class="chapter"><span class="number">06</span><span>窗外的夜路</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/5.jpg" alt="猫眼中摇晃的彩色笼子" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>灯光一盏一盏从外面滑过去。提笼重新晃起来，里面还是那块布。有人报出你的体温，又重复了一遍你的名字。你不明白那些数字，只认得声音还是刚才那个。</p>(if: $catTouch)[<p>你把脸挪到那个小孔边，等着刚才碰过你的手。</p>]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "声音忽远忽近 →", "猫_祭司")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:77%"></span></div></section>

:: 猫_探望 {"position": "720,1980", "size": "180,100"}
<section data-scene="猫_探望" class="page scene-stage role-cat expanded-scene" data-fx="warmth" data-sound="catDream"><div class="chapter"><span class="number">07</span><span>第二天的探望</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫所期待的房间和暖灯" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>再醒来时，那个人换了一件衣服。你隔着笼门闻到熟悉的味道，慢慢把脸转过去。桌上放着一个小食碗，这回没有人催你吃，也没有人说你应该很有精神。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">凑近闻闻，再吃一口</span><span class=\"choice-detail\">这一次先慢慢来。</span>", "猫_吃饭")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先趴着，等一等</span><span class=\"choice-detail\">有人会等你。</span>", "猫_等一等")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:93%"></span></div></section>

:: 猫_吃饭 {"position": "960,1980", "size": "180,100"}
<section data-scene="猫_吃饭" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">07</span><span>吃下一点</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/3.jpg" alt="放在猫面前的食碗" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你先闻了闻，再舔下一点。那个人没有把碗往前推，只轻轻摸了摸你的耳朵。“今天吃一点就好。”你吃得很慢，中间歇了好几次。碗一直放在你够得到的地方。</p><p class="voice">(set: _inkText to "“这个味道，我想记住。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这个味道，我想记住。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这个味道，我想记住。”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "等身体一点点好起来 →", "猫_康复")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:96%"></span></div></section>

:: 猫_等一等 {"position": "1200,1980", "size": "180,100"}
<section data-scene="猫_等一等" class="page scene-stage role-cat expanded-scene" data-sound="catDream"><div class="chapter"><span class="number">07</span><span>没有人催你</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="猫所期待的房间和暖灯" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catPatient to true)<p>你把头放回前爪上。那个人就在旁边坐下来，包还背在肩上，像是刚赶到。过了一会儿，手掌又伸进来。你用鼻子碰了一下，接着睡，没有因为没吃饭被抱走。</p><p class="voice">(set: _inkText to "“醒来以后，你还会在吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“醒来以后，你还会在吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“醒来以后，你还会在吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "一天一天地过去 →", "猫_康复")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:96%"></span></div></section>

:: 猫_空提笼 {"position": "1440,1980", "size": "180,100"}
<section data-scene="猫_空提笼" class="page scene-stage role-cat expanded-scene" data-sound="catEnd"><div class="chapter"><span class="number">07</span><span>空下来的提笼</span><span class="track"></span><small>猫 / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="有沙发和窗边猫窝的房间" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>医院走道安静下来。那个人把垫布叠好，放回提笼底下，手在笼门上停了很久。窗边的猫窝是昨天才买的，袋子还没扔，里面放着没用完的东西。</p>(if: $catProof)[<p>手机里的照片没有删。那张写着“健康”的纸，也和医院留下的记录放在了一起。</p>]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "那个人带着空提笼回了家 →", "猫_离去")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:96%"></span></div></section>

:: 鸭_水面 {"position": "0,2160", "size": "180,100"}
<section data-scene="鸭_水面" class="page scene-stage role-duck expanded-scene" data-sound="duckOpen"><div class="chapter"><span class="number">01</span><span>水里的另一只鸭</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD1.jpg" alt="站在泥水里的鸭子" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你低头找水喝，水面上也有一只鸭子。它和你一起晃，头顶的光也跟着晃。脚边漂着几根断羽，远一点的水却被围栏隔开了。你伸长脖子，还是够不到。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">沿着围栏走一段</span><span class=\"choice-detail\">看看有没有能过去的地方。</span>", "鸭_围栏")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">再看看自己的光圈</span><span class=\"choice-detail\">大家说这证明你被照顾着。</span>", "鸭_倒影")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:12%"></span></div></section>

:: 鸭_围栏 {"position": "240,2160", "size": "180,100"}
<section data-scene="鸭_围栏" class="page scene-stage role-duck expanded-scene" data-sound="duckOpen"><div class="chapter"><span class="number">01</span><span>够不到的那一边</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD1.jpg" alt="站在泥水里的鸭子" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckFence to true)<p>你贴着铁丝走，试着把头伸过去。脖子够到了，身体却卡在里面。外面有一小块干地，长着细细的草。你拽了一下，草尖从嘴边滑走，铁丝在羽毛上刮了一道。</p><p class="voice">(set: _inkText to "“那边也有地方。为什么不能过去？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“那边也有地方。为什么不能过去？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 17))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 17)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“那边也有地方。为什么不能过去？”</span></span>](click: ?spokenLine)[(set: _inkCount to 17)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "回到鸭群旁边 →", "鸭_老鸭")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:15%"></span></div></section>

:: 鸭_倒影 {"position": "480,2160", "size": "180,100"}
<section data-scene="鸭_倒影" class="page scene-stage role-duck expanded-scene" data-sound="duckOpen"><div class="chapter"><span class="number">01</span><span>光照不到泥下面</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD1.jpg" alt="站在泥水里的鸭子" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你把头压低，想看看光是不是从羽毛里长出来的。水里那圈光碎成几段，又慢慢拼回去。肚子还是饿，踩进泥里的脚也没变干净。旁边的鸭子让你别乱动，说光会被弄散。</p><p class="voice">(set: _inkText to "“可我动不动，都还是饿啊。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“可我动不动，都还是饿啊。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 14))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 14)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“可我动不动，都还是饿啊。”</span></span>](click: ?spokenLine)[(set: _inkCount to 14)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "有人叫住了你 →", "鸭_老鸭")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:15%"></span></div></section>

:: 鸭_老鸭 {"position": "720,2160", "size": "180,100"}
<section data-scene="鸭_老鸭" class="page scene-stage role-duck expanded-scene" data-sound="duckOpen"><div class="chapter"><span class="number">01</span><span>在这里待得最久的鸭</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>有只尾羽稀疏的老鸭站在角落。它知道粮会从哪个方向撒下来，也知道开门之前会响几声。你问它是不是一直住在这里。它说，久到以前挤在身边的那些鸭都不在了。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">问问被带走的鸭子</span><span class=\"choice-detail\">它们真的去过天堂吗？</span>", "鸭_回来")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">问问今天的粮</span><span class=\"choice-detail\">你现在饿得更厉害。</span>", "鸭_饿着")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:18%"></span></div></section>

:: 鸭_回来 {"position": "960,2160", "size": "180,100"}
<section data-scene="鸭_回来" class="page scene-stage role-duck expanded-scene" data-sound="duckOpen"><div class="chapter"><span class="number">01</span><span>谁回来讲过</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckAsked to true)<p>“你见过回来的吗？”你问。老鸭想了一会儿，说没有。“那是谁告诉你的？”它转头看了看别的鸭子：“大家一直都这么说。”你等着它再说一点，它却只低头理了理翅膀。</p><p class="voice">(set: _inkText to "“那第一个这么说的，又是谁呢？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“那第一个这么说的，又是谁呢？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“那第一个这么说的，又是谁呢？”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "前面突然吵起来 →", "鸭_拥挤")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:21%"></span></div></section>

:: 鸭_饿着 {"position": "1200,2160", "size": "180,100"}
<section data-scene="鸭_饿着" class="page scene-stage role-duck expanded-scene" data-sound="duckOpen"><div class="chapter"><span class="number">01</span><span>先把肚子填上</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>老鸭说，别站在最边上，粮常落不到那里。你问为什么不多撒一点，它说自己也等过。说话的时候，它一直望着门。你本来还有别的问题，肚子却响得让你没法集中精神。</p><p class="voice">(set: _inkText to "“等吃到东西，我再来问。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“等吃到东西，我再来问。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“等吃到东西，我再来问。”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "跟着它看向门口 →", "鸭_拥挤")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:21%"></span></div></section>

:: 鸭_开门 {"position": "1440,2160", "size": "180,100"}
<section data-scene="鸭_开门" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">02</span><span>门只开了一点</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="鸭群仰望撒粮的人" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>门缝打开时，几只鸭子一起伸长脖子。一个空箱子被拖进来，底下留着湿湿的拖痕。撒粮的人站住了，门却没有完全关。你第一次看见那条缝后面的地面。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">看看地上的印子</span><span class=\"choice-detail\">有些印子只朝一个方向。</span>", "鸭_脚印")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先看撒粮的手</span><span class=\"choice-detail\">也许粮马上就落下来了。</span>", "鸭_远望")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:26%"></span></div></section>

:: 鸭_脚印 {"position": "0,2340", "size": "180,100"}
<section data-scene="鸭_脚印" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">02</span><span>只往外去的脚印</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckTracks to true)<p>你认得鸭子的脚印，三根脚趾分开，深浅也熟悉。门口的几行印子通向箱子，外面还有更大的鞋印。你找了半天，没找出同样一行从外面走回来的鸭脚印。</p><p class="voice">(set: _inkText to "“回来时，是被抱着的吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“回来时，是被抱着的吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“回来时，是被抱着的吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "鸭群把你推向前面 →", "鸭_神迹")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:30%"></span></div></section>

:: 鸭_远望 {"position": "240,2340", "size": "180,100"}
<section data-scene="鸭_远望" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">02</span><span>粮还在手里</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="鸭群仰望撒粮的人" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你盯着那只手。它抬高一点，鸭群就往前挪一点。你也跟着挪，脚踩进前一只鸭子留下的坑。门缝很快被身体挡住，等你再回头，已经什么都看不见了。</p><p class="voice">(set: _inkText to "“先吃到再说。别又空着肚子。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“先吃到再说。别又空着肚子。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“先吃到再说。别又空着肚子。”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "第一粒粮掉下来了 →", "鸭_神迹")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:30%"></span></div></section>

:: 鸭_伤翅 {"position": "480,2340", "size": "180,100"}
<section data-scene="鸭_伤翅" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">02</span><span>能站稳了</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>那只鸭子把翅膀收好，试着拍了一下。它告诉你，刚才不是不肯往前走，是脚陷得太深。你替它踩住旁边的泥，让它借力拔出来。再抬头时，前面已经少了好几个空位。</p><p class="voice">(set: _inkText to "“走吧。再晚就真的没了。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“走吧。再晚就真的没了。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“走吧。再晚就真的没了。”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "一起挤回鸭群里 →", "鸭_争夺")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:44%"></span></div></section>

:: 鸭_散场 {"position": "720,2340", "size": "180,100"}
<section data-scene="鸭_散场" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>粮撒完以后</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>最后一点粮落进泥里，撒粮的手收回去了。大家还在低头啄，谁都怕漏了一粒。你护着抢来的东西，听见背后有鸭子叫了一声。那声音很轻，很快被踩水声盖住。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">回头看看低处</span><span class=\"choice-detail\">有只鸭子还没站起来。</span>", "鸭_低处")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">先护好自己的粮</span><span class=\"choice-detail\">旁边还在有人挤。</span>", "鸭_护粮")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:53%"></span></div></section>

:: 鸭_低处 {"position": "960,2340", "size": "180,100"}
<section data-scene="鸭_低处" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>被挡住的那只</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckFallen to true)<p>你把翅膀让开一点，才看见它趴在脚边。它一直够不到地上的粮，刚伸出脖子，又被后面的身体压回去。你往旁边挪了半步，让它能抬起头。自己的肚子也还空着。</p><p class="voice">(set: _inkText to "“你刚才也一直在这里？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“你刚才也一直在这里？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“你刚才也一直在这里？”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "低头数数护着的粮 →", "鸭_粮食")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:55%"></span></div></section>

:: 鸭_护粮 {"position": "1200,2340", "size": "180,100"}
<section data-scene="鸭_护粮" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>护住这几粒</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>你把身体压低，用翅膀挡住旁边的嘴。没有谁真的要抢，你却一直不敢松开。刚才用了那么多力气，脚现在还在发抖。你一点一点把泥推开，想看清自己到底抢到了多少。</p><p class="voice">(set: _inkText to "“这些得是我的。至少这些是。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“这些得是我的。至少这些是。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“这些得是我的。至少这些是。”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "终于数清了 →", "鸭_粮食")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:55%"></span></div></section>

:: 鸭_悬空 {"position": "1440,2340", "size": "180,100"}
<section data-scene="鸭_悬空" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">04</span><span>脚离开泥地</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="鸭群仰望撒粮的人" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>脚下忽然空了。你拍了一下翅膀，抓着你的手更紧了一点。地上的鸭子都抬起头，有的往前挤，像是盼着下一次能轮到自己。你想说，从这里看并没有更舒服。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">看看旁边的箱子</span><span class=\"choice-detail\">里面传来窸窸窣窣的声音。</span>", "鸭_木箱")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">听听上面的人说话</span><span class=\"choice-detail\">他们正在商量什么。</span>", "鸭_人声")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:65%"></span></div></section>

:: 鸭_木箱 {"position": "0,2520", "size": "180,100"}
<section data-scene="鸭_木箱" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">04</span><span>箱子里面</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="围栏内聚在一起的鸭群" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckCrate to true)<p>箱子里挤着几只鸭子。你认出一只昨天还在门口争食的，它脖子上的那撮毛没有长齐。它看了你一眼，想往旁边让，却没让出地方。箱子底下也有泥，并不是传说中干净的草地。</p><p class="voice">(set: _inkText to "“你也没到吗？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“你也没到吗？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 8))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 8)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“你也没到吗？”</span></span>](click: ?spokenLine)[(set: _inkCount to 8)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "你被放到另一边 →", "鸭_天平")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:68%"></span></div></section>

:: 鸭_人声 {"position": "240,2520", "size": "180,100"}
<section data-scene="鸭_人声" class="page scene-stage role-duck expanded-scene" data-sound="duckWorship"><div class="chapter"><span class="number">04</span><span>它们在挑什么</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="鸭群仰望撒粮的人" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckPrice to true)<p>一个人把你翻了翻，看了看翅膀下面。另一个人拿着笔，说：“这只先称。”没有谁提天堂，也没有谁夸你的光圈。你听见几句很快的话，里面反复出现一个数字。</p><p class="voice">(set: _inkText to "“不是在看我够不够好？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“不是在看我够不够好？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 12))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 12)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“不是在看我够不够好？”</span></span>](click: ?spokenLine)[(set: _inkCount to 12)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "脚碰到了冰凉的盘子 →", "鸭_天平")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:68%"></span></div></section>

:: 鸭_记号 {"position": "480,2520", "size": "180,100"}
<section data-scene="鸭_记号" class="page scene-stage role-duck expanded-scene" data-fx="scales" data-sound="duckScales"><div class="chapter"><span class="number">04</span><span>笔尖落下去</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD5.jpg" alt="站在秤盘上的蓝色鸭子" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>指针停了，那个人低头在纸上写了一笔。你努力站直，想让它再看你一眼。它却已经转向下一只鸭子。原来它等的只是指针停下，连你有没有抬头，都不太在意。</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">想起刚才抢到的粮</span><span class=\"choice-detail\">六粒，费了那么大力气。</span>", "鸭_六粒")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">想起围栏另一边</span><span class=\"choice-detail\">你一直够不到那里。</span>", "鸭_铁丝")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:75%"></span></div></section>

:: 鸭_六粒 {"position": "720,2520", "size": "180,100"}
<section data-scene="鸭_六粒" class="page scene-stage role-duck expanded-scene" data-sound="duckScales"><div class="chapter"><span class="number">04</span><span>六粒粮的分量</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD5.jpg" alt="站在秤盘上的蓝色鸭子" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(if: $duckShare)[<p>你想起推过去的三粒粮。旁边那只鸭子至少吃到了东西，可你的去处并没有因此变远。那只手没有问你分过多少，只把你的重量记在纸上。</p>](else:)[<p>你把六粒都吃了，肚子却没有饱多久。为了这些粮，你踩过泥，也撞开过别的鸭子。现在它们只变成纸上的一点重量，连多看你一眼都没有换来。</p>]<p class="voice">(set: _inkText to "“吃到了，也还是在这里。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“吃到了，也还是在这里。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 13))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 13)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“吃到了，也还是在这里。”</span></span>](click: ?spokenLine)[(set: _inkCount to 13)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "听见身后有声音 →", "鸭_转身")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:78%"></span></div></section>

:: 鸭_铁丝 {"position": "960,2520", "size": "180,100"}
<section data-scene="鸭_铁丝" class="page scene-stage role-duck expanded-scene" data-sound="duckScales"><div class="chapter"><span class="number">04</span><span>那道铁丝还在</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD1.jpg" alt="站在泥水里的鸭子" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(if: $duckFence)[<p>你记得铁丝刮过羽毛的感觉。外面那点草离你那么近，脖子一伸就碰得到。你当时还以为，只要被挑中，就能从另一边绕过去。可现在，脚下变成了秤盘。</p>](else:)[<p>你以前没有走到围栏边。总觉得先吃饱，别的以后再说。现在离泥地远了一点，你才看清围栏把整片地方圈得很紧，连那条浅浅的水沟也出不去。</p>]<p class="voice">(set: _inkText to "“原来被抱起来，也不算出去。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“原来被抱起来，也不算出去。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 15))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 15)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“原来被抱起来，也不算出去。”</span></span>](click: ?spokenLine)[(set: _inkCount to 15)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "有谁转过身来 →", "鸭_转身")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:78%"></span></div></section>

:: 鸭_转身 {"position": "1200,2520", "size": "180,100"}
<section data-scene="鸭_转身" class="page scene-stage role-duck expanded-scene" data-sound="duckEnd"><div class="chapter"><span class="number">05</span><span>它问的不是鸭子</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="面向屏幕外的鸭祭司" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>一个高高的影子站在前面。你以为它会让你再站直一点，它却从你身旁望过去。它看的不是秤，不是撒粮的手，也不是门后的箱子。它一直望着屏幕外面。</p>(if: $duckAsked)[<p>你想起那个没得到回答的问题：谁回来讲过天堂？现在，好像轮到别人回答了。</p>]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "顺着它的目光看去 →", "鸭_祭司")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:81%"></span></div></section>

:: 鸭_能决定 {"position": "1440,2520", "size": "180,100"}
<section data-scene="鸭_能决定" class="page scene-stage role-duck expanded-scene" data-sound="duckEnd"><div class="chapter"><span class="number">05</span><span>如果你能决定</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="面向屏幕外的鸭祭司" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>“那就别只看它吃得多不多。”祭司朝秤盘点了点头。“粮是你撒的，围栏是你搭的，去哪里也是你决定的。它想喝一口干净的水，却连走到哪边都选不了。”</p><p class="voice">(set: _inkText to "“你说自己能决定。那下一步呢？”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“你说自己能决定。那下一步呢？”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“你说自己能决定。那下一步呢？”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "看看这些决定影响着什么 →", "鸭_是")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:94%"></span></div></section>

:: 鸭_也在其中 {"position": "0,2700", "size": "180,100"}
<section data-scene="鸭_也在其中" class="page scene-stage role-duck expanded-scene" data-sound="duckEnd"><div class="chapter"><span class="number">05</span><span>你也在这段生活里</span><span class="track"></span><small>鸭子 / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="面向屏幕外的鸭祭司" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>“好。那你和它都需要吃饭，也都需要能休息的地方。”祭司没有替你松开围栏。“可这道门谁来开，谁会被带走，它还是说了不算。你走过的时候，会不会看见它？”</p><p class="voice">(set: _inkText to "“不用先成为神，才肯替它留一点地方。”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="点击对白，立即读完整句"><span class="typewriter-measure" aria-hidden="true">“不用先成为神，才肯替它留一点地方。”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 19))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 19)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“不用先成为神，才肯替它留一点地方。”</span></span>](click: ?spokenLine)[(set: _inkCount to 19)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "从身边的事看起 →", "鸭_否")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:94%"></span></div></section>

:: 样式 [stylesheet] {"position": "240,2700", "size": "180,100"}
:root{color-scheme:light;--ink:#302e2f;--muted:#686159;--gold:#79613d;--line:#8a795b55;--accent:#8a7859;--bg:#d4d0c8}
html[data-role="pig"]{--bg:#03060b;--gold:#b4bfd1;--line:#a3b9dd30}html[data-role="cat"]{--bg:#0c090f;--gold:#d5b9b6;--line:#d5b9b632}html[data-role="duck"]{--bg:#07040d;--gold:#c9a8e0;--line:#c9a8e038}html,body{transition:none}h1[tabindex="-1"]:focus{outline:none}.role-pig .artwork{box-shadow:0 0 60px #10223b15}.role-cat .artwork{box-shadow:0 0 60px #a383a019}.role-duck .artwork{box-shadow:0 0 60px #7542a31c}.role-pig .voice{color:#c6d1e0}.role-cat .voice{color:#e3c9cf}.role-duck .voice{color:#d4bee5}.role-duck .chapter .track{background:linear-gradient(90deg,#c9a8e05e,transparent)}.role-cat .chapter .track{background:linear-gradient(90deg,#d5b9b65e,transparent)}.memory{max-width:650px;text-align:left;margin:18px auto 0;padding:11px 15px;border-left:1px solid var(--gold);background:#ffffff04;color:#b6afa7;font-size:12px;line-height:1.9}.memory>span{display:block;color:var(--gold);font-size:9px;letter-spacing:3px;margin-bottom:2px}.story-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:790px;margin:22px auto 0}.story-choices:has(>.decision-option:only-child){grid-template-columns:1fr;max-width:790px}.story-choices .decision-option{display:block;min-width:0}.story-choices tw-link{display:flex;width:100%;height:100%;flex-direction:column;align-items:flex-start;gap:5px;min-height:82px;text-align:left;padding:15px 20px;background:#ffffff02;border-color:var(--line)}.story-choices tw-link:after{content:"↗";position:absolute;right:15px;top:15px;opacity:.55}.story-choices tw-link{position:relative;padding-right:32px}.choice-title{color:var(--gold);font-size:14px;letter-spacing:1px}.choice-detail{color:#8d8990;font-size:11px;line-height:1.8;letter-spacing:0}.story-choices tw-link:hover{background:#ffffff06;border-color:var(--gold)}.story-choices tw-link:hover .choice-detail{color:#b6b1a8}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);min-height:100%;-webkit-text-size-adjust:100%;text-size-adjust:100%}body{font-family:"Microsoft YaHei","PingFang SC",sans-serif}tw-story{display:block;background:transparent;color:var(--ink);width:100%;max-width:1640px;min-height:100dvh;margin:0 auto;padding:0 clamp(18px,4vw,70px) 26px;font-size:17px;line-height:1.8}tw-passage{display:block;overflow-wrap:break-word}tw-sidebar,tw-icon,tw-story>br{display:none}tw-include{display:contents}tw-transition-container{max-width:100%}button,a,tw-link{touch-action:manipulation}button{font:inherit}button,tw-link,a{color:var(--gold)}tw-link{font-weight:400;cursor:pointer;transition:color .2s}tw-link:hover,a:hover{color:#fff0c7}button:focus-visible,tw-link:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:5px}button{cursor:pointer}button:disabled{cursor:default}::selection{background:#c7ab7540}h1,h2,h3,p,figure{margin:0}button svg{width:18px;height:18px;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:1.5}a{text-underline-offset:4px}
.mast{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);margin-bottom:20px;color:var(--muted);font-size:12px;letter-spacing:2px}.brand{display:flex;gap:12px;align-items:center;color:#a49377;font-family:Georgia,serif}.brand em{color:var(--gold);font-style:normal}.mast nav{display:flex;align-items:center;gap:24px;letter-spacing:1px}.mast tw-link{font-size:12px}.audio-toggle{border:0;padding:8px 0;background:none;font-size:12px}.audio-toggle.is-off{color:var(--muted)}.page{animation:none}.eyebrow{font:10px/1.6 Georgia,"Microsoft YaHei",serif;letter-spacing:4px;color:var(--gold)}.selection-head{text-align:center;margin:28px auto 0}.selection-head h1{font:normal clamp(34px,4vw,58px)/1.5 "Songti SC","SimSun",serif;letter-spacing:12px;margin:8px 0 4px}.selection-head p{font-size:13px;line-height:1.9;color:var(--muted);letter-spacing:1px}.selection-art{display:block;width:270px;height:96px;object-fit:contain;filter:invert(1);margin:16px auto 22px}.role-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:0 auto;max-width:1380px}.role-card{border:1px solid #ffffff18;position:relative;transition:border-color .3s,background .3s;min-width:0;background:#090a09}.role-card:hover,.role-card:focus-within{border-color:#c7ab7560;background:#10110f}.animal-preview{display:block;position:relative;background:none;border:0;width:100%;padding:12px 20px 0;overflow:hidden}.animal-preview img{display:block;width:100%;height:clamp(110px,17dvh,190px);object-fit:contain;filter:invert(1);opacity:.6;transition:opacity .25s}.animal-preview:hover img,.animal-preview.is-playing img{opacity:1}.sound-hint{font-size:10px;letter-spacing:1px;color:#9a8969;display:block;padding:6px 0}.role-copy{padding:20px 26px 26px}.role-no{font:10px Georgia,serif;letter-spacing:3px;color:var(--gold)}.role-card h2{font:normal 29px/1.5 "SimSun",serif;letter-spacing:6px;margin:7px 0}.role-card p{font-size:13px;color:#a4a095;line-height:1.95;min-height:52px}.role-enter{margin-top:18px;font-size:14px}.role-enter tw-link{display:flex;justify-content:space-between;gap:12px;align-items:center}.role-count{position:absolute;right:22px;top:16px;font:10px Georgia,serif;color:#68665e;letter-spacing:2px}.role-count.has-ending{color:var(--gold)}.selection-foot{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:27px auto 10px;max-width:1380px;color:#77776f;font-size:11px;letter-spacing:1px}.selection-foot .series{color:#a28e68}
.chapter{display:flex;align-items:center;gap:15px;margin:0 0 14px;font-size:12px;letter-spacing:2px;color:var(--muted)}.chapter .number{font:italic 26px Georgia,serif;color:var(--gold)}.chapter .track{height:1px;background:var(--line);flex:1}.chapter small{font-size:10px;letter-spacing:2px;color:#77796e}.scene-stage{position:relative;width:100%;isolation:isolate}.artwork{display:flex;justify-content:center;align-items:center;position:relative;width:100%;height:clamp(220px,52dvh,650px);margin:0;overflow:hidden;background:#000}.artwork img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}.artwork.is-clickable{cursor:pointer}.artwork.is-clickable:after{content:"点击画面继续 ↗";position:absolute;right:15px;bottom:10px;padding:3px 8px;color:#d7c29a;background:#000b;font-size:10px;letter-spacing:1px;pointer-events:none}.scene-copy{position:relative;max-width:900px;margin:22px auto 0;text-align:center}.scene-copy h1{font:normal clamp(26px,3vw,38px)/1.5 "SimSun",serif;letter-spacing:6px;margin:4px auto 12px}.scene-copy p{font-size:clamp(14px,1.2vw,17px);line-height:1.95;margin:9px 0;color:#c4c0b7}.scene-copy .voice{color:#e8ddc8;font-family:"SimSun",serif;font-size:clamp(17px,1.5vw,22px);line-height:1.8}.scene-copy .thought{color:#96958e;font-size:13px}.actions{display:flex;justify-content:center;align-items:center;gap:16px;flex-wrap:wrap;margin:21px 0 0}.actions tw-link,.action-button,.hold-button{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:46px;border:1px solid #c7ab7566;border-radius:0;background:linear-gradient(140deg,#c7ab750b,transparent);color:#dfcca7;padding:10px 28px;font-size:14px;font-weight:normal;letter-spacing:1px;transition:background .2s,border-color .2s}.actions tw-link:hover,.action-button:hover,.hold-button:hover{border-color:var(--gold);background:#c7ab751b;color:#fff0cf}.actions .secondary tw-link{border-color:#ffffff26;color:#b1afa8}.scene-note{font:10px/1.8 Georgia,"Microsoft YaHei",sans-serif;letter-spacing:2px;color:#666c65;text-align:center;margin-top:20px}.chapter-meter{width:100%;height:1px;background:#ffffff0a;position:relative;margin-top:22px}.chapter-meter span{display:block;height:1px;background:var(--accent)}.role-pig{--accent:#8c9fbe}.role-cat{--accent:#cfb3a6}.role-duck{--accent:#a890cc}.interaction{max-width:600px;margin:19px auto 0;text-align:center}.interaction .instructions{font-size:12px;color:#9b9588;line-height:1.8;margin:0 0 12px}.task-status{font:12px/1.8 "Microsoft YaHei",sans-serif;color:var(--gold);min-height:25px;margin:8px 0}.task-track{height:3px;background:#ffffff16;width:160px;max-width:100%;margin:12px auto 0;overflow:hidden}.task-track span{display:block;width:0;height:100%;background:var(--gold);transition:width .12s}.is-locked{display:none!important}.hold-button{user-select:none;-webkit-user-select:none;touch-action:none;min-width:240px;position:relative;overflow:hidden}.hold-button:before{content:"";position:absolute;inset:0;transform:scaleX(var(--hold,0));transform-origin:left;background:#c7ab7524;pointer-events:none}.hold-button.is-holding{border-color:#f0d49e;color:#ffedbd}.hold-button.is-holding:after{content:"";position:absolute;border:1px solid #ffe8ba33;border-radius:50%;width:90px;height:90px;left:50%;top:50%;animation:breath .8s infinite;pointer-events:none}.task-complete .action-button,.task-complete .hold-button{border-color:#c7ab752a;color:#8b826f}.artwork.is-steaming:after{content:"";position:absolute;inset:15% 28% 0;background:radial-gradient(ellipse at 50% 80%,#ffffff36,transparent 60%);animation:mist 1.1s infinite;pointer-events:none}.duel{display:grid;grid-template-columns:1fr 1fr;gap:15px;width:min(800px,100%);margin:0 auto}.duel-target{border:1px solid #ffffff22;padding:0;position:relative;background:#000;overflow:hidden}.duel-target img{display:block;width:100%;height:clamp(150px,30dvh,350px);object-fit:contain;transition:filter .2s,transform .2s}.duel-target .target-label{display:block;padding:8px 10px;color:#beab87;font-size:11px;border-top:1px solid #ffffff14}.duel-target:hover{border-color:#c7ab7580}.duel-target.is-hit img{filter:brightness(1.6)}.duel-target:disabled{opacity:.42}.task-duck .scene-copy{margin-top:20px}.task-duck .artwork{display:none}.duel-status{display:flex;justify-content:center;gap:24px;margin:12px 0;color:#b1a89a;font-size:12px}.crumb{width:6px;height:6px;position:absolute;pointer-events:none;background:#e6c47d;border-radius:50%;animation:crumb .75s both}
.ending .artwork{height:clamp(210px,40dvh,480px)}.ending .scene-copy{max-width:900px}.ending .ending-label{color:var(--gold);font:10px Georgia,"Microsoft YaHei",sans-serif;letter-spacing:4px;margin-top:4px}.ending .ending-note{color:#9f998a;font-size:12px;border-top:1px solid var(--line);padding-top:16px;margin-top:18px}.ending .closing{font:normal 23px/1.8 "SimSun",serif;letter-spacing:4px;margin-top:15px;color:#d1bb94}.ending-cat-dark .artwork{background:radial-gradient(ellipse,#151319,#000 70%)}.ending-cat-dark .artwork img{opacity:.12;filter:grayscale(1)}.ending-pig-fall .artwork img{filter:grayscale(.9) brightness(.42)}.ending-pig-fall .artwork:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#000b,transparent 50%);pointer-events:none}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:1100px;margin:22px auto}.fact{padding:24px;border:1px solid var(--line);text-align:left;background:#ffffff02}.fact strong{display:block;color:#dfc796;font:normal clamp(27px,3.5vw,45px)/1.5 Georgia,"SimSun",serif;letter-spacing:1px}.fact h2{font-weight:400;font-size:15px;margin:5px 0 10px;color:#ded9cc}.fact p{color:#a4a198;font-size:13px;line-height:1.9}.fact a{display:inline-block;font-size:10px;color:#9d8c6e;line-height:1.6;margin-top:15px}.facts-note{font-size:11px;color:#8a887e;line-height:1.9;max-width:1050px;margin:0 auto;text-align:center}.data-ending .artwork{height:clamp(160px,27dvh,320px)}.data-ending .scene-copy{margin-top:16px}.data-ending .facts .fact{padding:18px 22px}
.journal-head{text-align:center;padding:22px 0}.journal-head h1{font:normal 40px/1.5 "SimSun",serif;letter-spacing:10px;margin:8px 0}.journal-head p{font-size:12px;color:var(--muted)}.journal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:22px auto}.journal-role{padding:24px;border:1px solid var(--line)}.journal-role>img{display:block;width:100%;height:130px;object-fit:contain;filter:invert(1);opacity:.5}.journal-role h2{font:normal 26px/1.5 "SimSun",serif;letter-spacing:6px;margin:10px 0 20px}.journal-entry{position:relative;border-top:1px solid #ffffff16;padding:15px 0 10px}.journal-entry h3{font-size:15px;font-weight:400;color:#c8c2b4;margin-bottom:8px}.journal-entry p{color:#787a72;font-size:12px;line-height:1.8}.journal-entry.is-discovered h3{color:#dfc796}.journal-entry.is-discovered p{color:#aaa69a}.journal-entry .entry-state{font:10px Georgia,"Microsoft YaHei",sans-serif;letter-spacing:2px;color:#62685e;margin-bottom:7px;display:block}.journal-entry.is-discovered .entry-state{color:var(--gold)}.journal-role .role-enter{font-size:13px;margin-top:16px}
.sound-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);padding:7px 16px;background:#161711;border:1px solid #c7ab7538;color:#cdbb96;font-size:12px;z-index:80;pointer-events:none;animation:none}.load-error{position:absolute;inset:0;display:grid;place-content:center;padding:24px;text-align:center;color:var(--muted);font-size:13px}.load-error small{display:block;color:#756d60;margin-top:7px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.utility-note{max-width:800px;margin:30px auto 0;padding-top:20px;border-top:1px solid var(--line);font-size:12px;line-height:2;color:#8b8b81;text-align:center}
@keyframes breath{from{transform:translate(-50%,-50%) scale(.3);opacity:1}to{transform:translate(-50%,-50%) scale(2.5);opacity:0}}@keyframes mist{from{transform:translateY(12px);opacity:.2}to{transform:translateY(-14px);opacity:.7}}@keyframes crumb{to{transform:translate(var(--dx),var(--dy));opacity:0}}
@media(min-width:1700px){.artwork{height:min(55dvh,720px)}.scene-copy{margin-top:26px}.role-grid{margin-top:28px}.selection-head{margin-top:42px}.selection-art{margin-top:24px;margin-bottom:30px}.animal-preview img{height:190px}.role-copy{padding:24px 30px 32px}}
@media(max-width:800px){tw-story{padding:0 20px 26px}.mast{min-height:58px;letter-spacing:1px}.brand{font-size:10px;gap:7px}.mast nav{gap:14px}.role-grid{gap:12px}.role-copy{padding:16px}.role-card p{font-size:12px}.role-card h2{font-size:25px}.role-no{font-size:9px;letter-spacing:2px}.role-count{right:12px;top:10px}.facts{gap:10px}.fact{padding:17px}.chapter small{font-size:9px}.journal-grid{gap:12px}.journal-role{padding:16px}}
@media(max-width:600px){tw-story{padding:0 15px 24px}.mast{min-height:52px;margin-bottom:14px;gap:8px}.brand .series-label{display:none}.brand{font-size:10px;letter-spacing:1px}.mast nav{gap:16px}.mast tw-link,.audio-toggle{font-size:11px}.mast .journal-number{display:none}.selection-head{margin-top:15px}.selection-head h1{font-size:33px;letter-spacing:8px;margin:5px 0 9px}.selection-head p{font-size:11px;letter-spacing:0}.eyebrow{font-size:9px;letter-spacing:3px}.selection-art{width:180px;height:61px;margin:10px auto 16px}.role-grid{grid-template-columns:1fr;gap:10px}.role-card{display:grid;grid-template-columns:29% 1fr}.animal-preview{padding:6px 5px;display:flex;flex-direction:column;justify-content:center}.animal-preview img{height:86px;width:100%;min-height:0}.sound-hint{font-size:8px;letter-spacing:0;padding:5px 0 0}.role-copy{padding:13px 15px 14px 10px}.role-no{font-size:8px;letter-spacing:2px}.role-card h2{font-size:23px;line-height:1.3;margin:5px 0;letter-spacing:4px}.role-card p{min-height:0;font-size:11px;line-height:1.7}.role-enter{margin-top:8px;font-size:12px}.role-count{top:12px;right:13px;font-size:9px}.selection-foot{font-size:9px;letter-spacing:0;margin-top:19px;gap:8px}.selection-foot .series{width:100%;order:2}.chapter{font-size:10px;gap:9px;letter-spacing:1px;margin-bottom:10px}.chapter .number{font-size:23px}.chapter small{letter-spacing:1px;font-size:8px}.artwork{height:clamp(170px,35dvh,360px)}.artwork.is-clickable:after{font-size:9px;bottom:6px;right:7px}.scene-copy{margin-top:20px}.scene-copy h1{font-size:27px;letter-spacing:4px;margin-bottom:12px}.scene-copy p{font-size:14px;line-height:1.9;margin:9px 0}.scene-copy .voice{font-size:18px}.scene-copy .thought{font-size:12px}.actions{gap:10px;margin-top:20px}.actions tw-link,.action-button,.hold-button{font-size:13px;min-height:44px;padding:10px 22px}.scene-note{font-size:8px;letter-spacing:1px;margin-top:18px}.interaction{margin-top:18px}.interaction .instructions{font-size:11px}.task-track{width:140px}.task-status{font-size:11px}.chapter-meter{margin-top:20px}.duel{gap:10px}.duel-target img{height:clamp(140px,24dvh,230px)}.duel-target .target-label{font-size:10px;padding:8px}.ending .artwork{height:clamp(170px,29dvh,310px)}.ending .scene-copy h1{font-size:29px}.ending .ending-note{font-size:11px;padding-top:13px;margin-top:16px}.ending .closing{font-size:21px;letter-spacing:3px}.facts{grid-template-columns:1fr;gap:10px;margin:18px 0}.fact,.data-ending .facts .fact{padding:14px 17px}.fact strong{font-size:29px;line-height:1.3}.fact h2{font-size:13px;margin:3px 0 6px}.fact p{font-size:12px;line-height:1.75}.fact a{margin-top:7px;font-size:9px}.facts-note{font-size:10px;text-align:left}.data-ending .artwork{height:clamp(120px,23dvh,200px)}.journal-head{padding:12px 0}.journal-head h1{font-size:32px;letter-spacing:7px}.journal-grid{grid-template-columns:1fr;margin-top:14px;gap:16px}.journal-role{padding:20px}.journal-role>img{height:90px}.journal-role h2{font-size:23px}.journal-entry{padding-top:12px}.utility-note{margin-top:24px;font-size:11px}}
@media(max-height:600px) and (min-width:601px){.selection-head{margin-top:10px}.selection-head h1{font-size:33px;letter-spacing:8px}.selection-art{height:45px;margin:7px auto 10px}.animal-preview img{height:85px}.role-copy{padding-top:10px;padding-bottom:15px}.role-card h2{font-size:24px;margin:4px 0}.role-card p{font-size:11px;line-height:1.7;min-height:0}.role-enter{margin-top:10px}.selection-foot{margin-top:17px}.artwork{height:46dvh;min-height:155px}.scene-copy{margin-top:15px}.scene-copy p{font-size:14px}.scene-copy h1{font-size:28px}.mast{min-height:48px;margin-bottom:12px}.chapter{margin-bottom:10px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(max-width:600px){.story-choices{gap:9px;margin-top:18px}.story-choices tw-link{padding:12px 25px 12px 13px;min-height:92px}.choice-title{font-size:12px;line-height:1.7}.choice-detail{font-size:10px;line-height:1.7}.story-choices tw-link:after{right:10px;top:11px;font-size:11px}.memory{font-size:11px;padding:10px 13px;margin-top:14px}}
.actions.story-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}.actions.story-choices:has(>.decision-option:only-child){grid-template-columns:1fr}.role-pig .scene-copy .voice{color:#c6d1e0}.role-cat .scene-copy .voice{color:#e3c9cf}.role-duck .scene-copy .voice{color:#d4bee5}

/* Pages appear immediately; framework transition wrappers must not move the layout. */
html{scrollbar-gutter:auto;overflow:hidden;overflow-anchor:none;scroll-behavior:auto}body,tw-story{overflow-anchor:none}tw-passage,.page{animation:none!important;transition:none!important;transform:none!important;opacity:1!important}tw-transition-container:not(.page tw-transition-container){display:contents!important;animation:none!important;transition:none!important;transform:none!important;opacity:1!important}.transition-out{display:none!important}

/* Fit the complete scene to the viewport, reserving space for every control. */
html,body{height:100%;min-height:0;overflow:hidden}
tw-story{min-height:0;height:100dvh;padding-bottom:max(12px,env(safe-area-inset-bottom))}
.mast{min-height:58px;margin-bottom:14px}
.page{display:flow-root;min-width:0;--art-height:42dvh;--duel-height:24dvh}
.chapter{margin-bottom:10px}
.scene-stage .artwork{height:var(--art-height);min-height:0}
.scene-panel{min-width:0;display:flow-root}
.scene-copy,.task-duck .scene-copy,.data-ending .scene-copy{margin-top:14px}
.scene-copy h1{margin-top:0;margin-bottom:8px}
.scene-copy p{margin:7px 0;line-height:1.8}
.actions,.story-choices{margin-top:14px}
.actions.story-choices{margin-left:auto;margin-right:auto}
.story-choices tw-link{min-height:70px;padding-top:11px;padding-bottom:11px}
.chapter-meter{margin-top:14px}
.interaction{margin-top:12px}
.interaction .instructions{margin-bottom:8px}
.interaction [data-task-next].is-locked{display:flex!important;visibility:hidden;pointer-events:none}
.task-status{min-height:3.6em;margin:6px 0;display:flex;align-items:center;justify-content:center}
.task-track{margin-top:8px}
.duel-target img{height:var(--duel-height)}
.facts{margin:14px auto;gap:12px}
.fact,.data-ending .facts .fact{padding:14px 18px}
.fact a{margin-top:8px}
.memory{margin-top:12px;padding:8px 12px;line-height:1.7}
.card-tabs{display:none}
.card-tabs button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:8px 10px;min-height:36px;font-size:12px;letter-spacing:1px}
.card-tabs button[aria-pressed="true"]{border-color:var(--gold);background:#ffffff07;color:var(--gold)}
.cycle-word{display:inline-block;border-bottom:1px dotted currentColor;text-underline-offset:5px}
.cycle-word tw-link{color:inherit;font:inherit}
.artwork.is-listening:after{content:"点击画面 · 听听它的声音 ♫"}
.story-whisper{max-width:650px;display:grid;grid-template-columns:1fr auto;gap:3px 12px;margin:12px auto 0;padding:8px 12px;border-left:1px solid var(--line);background:#ffffff03;text-align:left;line-height:1.6}
.whisper-label{grid-column:1;grid-row:1;color:var(--gold);font-size:9px;letter-spacing:2px}
.whisper-action{grid-column:2;grid-row:1;font-size:10px;line-height:1.5;white-space:nowrap}
.whisper-copy{grid-column:1/-1;grid-row:2;display:block;height:3.6em;font-size:12px;line-height:1.8;color:#b0aaa2}
.macro-line{min-height:3.6em}
.typewriter-line{display:block;position:relative;cursor:pointer}
.typewriter-measure{display:block;visibility:hidden}
.typewriter-ink{position:absolute;inset:0;white-space:pre-line}
.typewriter-ink tw-hook[name="typedvoice"]:after{content:"▏";font-size:.8em;color:var(--gold);opacity:.6}
.typewriter-ink tw-hook[name="typedvoice"]:empty:after{content:""}
.scene-atmosphere,.impact-flash{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.scene-atmosphere{z-index:1}
.impact-flash{z-index:2;background:radial-gradient(ellipse at center,#ffe3ad77,transparent 68%);opacity:0}
.scene-atmosphere:before{content:"";position:absolute;inset:0;opacity:0}
[data-fx="light"] .scene-atmosphere:before{background:radial-gradient(ellipse at 58% 48%,#ffd77b61,transparent 62%);animation:light-breath 3.2s ease-in-out infinite}
[data-fx="revelation"] .scene-atmosphere:before{background:radial-gradient(ellipse at 50% 36%,#e3eaff68,transparent 70%);animation:divine-reveal 1.8s ease-out both}
[data-fx="warmth"] .scene-atmosphere:before{background:radial-gradient(ellipse at 55% 48%,#edbd8e2e,transparent 72%);animation:warm-breath 5s ease-in-out infinite}
[data-fx="halo"] .scene-atmosphere:before,[data-fx="altar"] .scene-atmosphere:before{background:radial-gradient(ellipse at 50% 35%,#d4a6f047,transparent 63%);animation:ritual-breath 4.5s ease-in-out infinite}
[data-fx="colour"] .artwork img{animation:dream-colour 1.8s ease-out both}
[data-fx="farewell"] .artwork img{opacity:0;animation:last-light 4s ease-out both}
.ending-pig-fall .artwork img{animation:forest-fades 5s ease-out both}
.atmosphere-cloud{position:absolute;width:44%;height:50%;left:calc(9% + var(--cloud)*18%);top:24%;border-radius:50%;background:radial-gradient(ellipse,#eef2ff66,transparent 65%);filter:blur(12px);transform-origin:50% 22%;opacity:0}
.is-steaming .atmosphere-cloud{animation:steam-rise 1.8s calc(var(--cloud)*-.55s) ease-out infinite}
.duel-target.is-hit img{animation:wing-strike .22s ease-out}
.duel-target:disabled .target-label{color:#b69fbe}
@keyframes light-breath{0%,100%{opacity:.25}50%{opacity:.8}}
@keyframes divine-reveal{from{opacity:.8}to{opacity:0}}
@keyframes warm-breath{0%,100%{opacity:.15}50%{opacity:.5}}
@keyframes ritual-breath{0%,100%{opacity:.2}50%{opacity:.65}}
@keyframes dream-colour{from{filter:grayscale(1) brightness(.65)}to{filter:grayscale(0) brightness(1)}}
@keyframes last-light{from{opacity:.45;filter:grayscale(1)}to{opacity:0;filter:grayscale(1)}}
@keyframes forest-fades{from{filter:grayscale(.15) brightness(.8)}to{filter:grayscale(1) brightness(.35)}}
@keyframes steam-rise{from{transform:translateY(-18%) scale(.45);opacity:0}35%{opacity:.8}to{transform:translateY(23%) scale(1.3);opacity:0}}
@keyframes wing-strike{0%,100%{transform:rotate(0)}35%{transform:rotate(-3deg)}70%{transform:rotate(2deg)}}
@media(prefers-reduced-motion:reduce){.typewriter-measure{visibility:visible}.typewriter-ink{visibility:hidden}}

/* Each complete route keeps its own palette, including navigation and endings. */
:root,html[data-role="selection"],html[data-role="pig"],html[data-role="duck"]{color-scheme:dark;--bg:#000;--ink:#f0f0f0;--copy:#d4d4d4;--voice:#f0f0f0;--muted:#aaa;--gold:#ddd;--line:#ffffff2b;--accent:#aaa;--paper:#101010;--surface:#111;--surface-hover:#1b1b1b;--frame:#080808;--button-bg:#181818;--button-ink:#f1f1f1;--button-border:#888;--button-hover:#272727;--button-hover-ink:#fff;--quiet-bg:#0d0d0d;--quiet-ink:#aaa;--track:#ffffff21;--image-shadow:none}
html[data-role="cat"]{color-scheme:light;--bg:#fff;--ink:#202020;--copy:#343434;--voice:#202020;--muted:#626262;--gold:#555;--line:#0000002b;--paper:#fff;--surface:#fff;--surface-hover:#f4f4f4;--frame:#fff;--button-bg:#fff;--button-ink:#222;--button-border:#777;--button-hover:#f0f0f0;--button-hover-ink:#000;--quiet-bg:#f4f4f4;--quiet-ink:#666;--track:#0000001c;--accent:#777;--image-shadow:none}
html,body{background-color:var(--bg)}
body{background-image:none}
body:before{display:none}
tw-story{position:relative;z-index:1}
.brand{color:var(--muted)}
.mast{border-bottom-color:var(--line)}
.mast tw-link,.mast tw-link:visited{color:var(--gold)}
tw-link,tw-link.visited,tw-link:visited{color:var(--gold)}
tw-link:hover,a:hover{color:var(--ink)}
.page .enchantment-link,.page .enchantment-link:hover,.page .enchantment-link:active,.page .enchantment-link:focus{color:inherit;font-weight:inherit;text-decoration:none}
.selection-head p,.role-card p,.selection-foot,.chapter small,.scene-note,.utility-note{color:var(--muted)}
.role-card{background:var(--paper);color:var(--ink);border-color:var(--line);box-shadow:none}
.role-card:hover,.role-card:focus-within{background:var(--surface-hover);border-color:var(--gold);box-shadow:none}
.role-card:nth-child(2),.journal-role[data-card-label="猫"]{color-scheme:light;--ink:#202020;--copy:#343434;--muted:#626262;--gold:#444;--line:#0000002b;--paper:#fff;--surface-hover:#f4f4f4;color:var(--ink);background:var(--paper);border-color:var(--line)}
.selection-art,.journal-role>img{filter:brightness(0) invert(1);mix-blend-mode:normal;opacity:.85}
.animal-preview img,.selection .animal-preview img{filter:invert(1) brightness(1.8);mix-blend-mode:screen;opacity:.9}
.selection .role-card:nth-child(2) .animal-preview img{filter:none;mix-blend-mode:multiply}
.journal-role[data-card-label="猫"]>img{filter:brightness(0)}
.sound-hint,.role-count{color:var(--muted)}
.selection-foot .series{color:var(--muted)}
.role-card tw-link:hover,.journal-role tw-link:hover{color:var(--ink)}
.scene-copy p,.fact p,.journal-entry.is-discovered p{color:var(--copy)}
.scene-copy .thought,.ending .ending-note,.memory,.whisper-copy,.facts-note,.choice-detail,.interaction .instructions,.duel-status{color:var(--muted)}
.role-pig .scene-copy .voice,.role-pig .voice,.role-cat .scene-copy .voice,.role-cat .voice,.role-duck .scene-copy .voice,.role-duck .voice{color:var(--voice)}
.scene-copy .closing,.fact strong,.fact h2,.journal-entry.is-discovered h3{color:var(--gold)}
.chapter .track,.role-cat .chapter .track,.role-duck .chapter .track{background:var(--line)}
.scene-stage>.artwork{width:min(100%,calc(var(--art-height) * var(--image-ratio,1.752)));margin-inline:auto;justify-self:center}
.artwork,.role-pig .artwork,.role-cat .artwork,.role-duck .artwork{background:var(--frame);border:1px solid var(--line);box-shadow:var(--image-shadow)}
.artwork img{filter:none}
.artwork.is-clickable:after{color:var(--ink);background:var(--surface);border:1px solid var(--line)}
.ending-cat-dark .artwork{background:#000}
.memory{background:var(--paper);border-left-color:var(--gold)}
.story-whisper{background:transparent;border-left:0;border-top:1px solid var(--line);padding-left:0;padding-right:0}
.actions tw-link,.action-button,.hold-button{color:var(--button-ink);border-color:var(--button-border);background:var(--button-bg);box-shadow:none}
.actions tw-link:hover,.action-button:hover,.hold-button:hover{color:var(--button-hover-ink);border-color:var(--gold);background:var(--button-hover)}
.story-choices tw-link{color:var(--ink);background:var(--surface);border-color:var(--line);box-shadow:none}
.story-choices .choice-title{color:var(--ink)}
.story-choices tw-link:hover{background:var(--surface-hover);border-color:var(--gold)}
.story-choices tw-link:hover .choice-detail{color:var(--copy)}
.actions .secondary tw-link{border-color:var(--line);color:var(--muted);background:transparent}
.task-track,.chapter-meter{background:var(--track)}
.role-pig,.role-cat,.role-duck{--accent:inherit}
.task-complete .action-button,.task-complete .hold-button{color:var(--quiet-ink);border-color:var(--line);background:var(--quiet-bg);box-shadow:none}
.hold-button.is-holding{color:var(--button-hover-ink);border-color:var(--gold)}
.hold-button:before{background:#a0a0a02b}
.artwork.is-steaming:after{inset:8% 10% 24%;background:radial-gradient(ellipse at 50% 40%,#ffffff36,transparent 60%)}
.duel-target{background:var(--frame);border-color:var(--line)}
.duel-target .target-label{color:var(--gold);background:var(--surface);border-top-color:var(--line)}
.duel-target:disabled{opacity:.6}
.duel-target:disabled .target-label{color:#b5a5a7}
.fact,.data-ending .facts .fact,.journal-role{background:var(--paper)}
.fact a{color:var(--gold)}
.journal-entry{border-top-color:var(--line)}
.journal-entry h3{color:var(--copy)}
.journal-entry p,.journal-entry .entry-state{color:var(--muted)}
.card-tabs button[aria-pressed="true"]{background:var(--button-hover);color:var(--button-hover-ink);border-color:var(--gold)}
.sound-toast{color:var(--button-ink);background:var(--button-bg);border-color:var(--gold)}
::selection{background:#8888}

/* Each text effect paints inside its own space; paragraphs and buttons stay put. */
.word-slot{display:inline-grid;position:relative;max-width:100%;vertical-align:baseline;border-bottom:1px dotted var(--gold);line-height:inherit;text-indent:0}
.word-slot .word-measure,.word-slot .word-value{grid-area:1/1;min-width:0}
.word-measure{visibility:hidden;pointer-events:none;user-select:none}
.word-value{align-self:start}
.word-slot tw-link{font:inherit;color:var(--gold);text-decoration:none}
.changing-word{border-bottom-style:solid;border-bottom-color:var(--line);color:var(--gold)}
.word-slot:hover{background:#8882}
.prose-fragment{animation:ink-sentence .9s var(--ink-delay,0ms) ease both}
.ink-title{animation:ink-title 1.6s ease-out both;background:linear-gradient(105deg,var(--ink) 20%,var(--gold) 48%,var(--ink) 76%);background-size:220% 100%;background-clip:text;-webkit-background-clip:text;color:transparent}
.typewriter-ink tw-hook[name="typedvoice"]:after{content:none}
.typewriter-caret{display:inline;color:var(--gold);animation:ink-caret .8s steps(1,end) infinite}
.cycle-word,.reveal-word{background-image:linear-gradient(90deg,#8880,#8883,#8880);background-size:240% 100%;animation:ink-clue 3.5s ease-in-out 2}
@keyframes ink-sentence{from{opacity:.12;text-shadow:0 0 7px currentColor}to{opacity:1;text-shadow:0 0 0 transparent}}
@keyframes ink-title{from{background-position:100% 50%}to{background-position:0% 50%}}
@keyframes ink-caret{0%,55%{opacity:1}56%,100%{opacity:0}}
@keyframes ink-clue{0%,100%{background-position:100% 50%}50%{background-position:0% 50%}}
@media(prefers-reduced-motion:reduce){.prose-fragment,.ink-title,.cycle-word,.reveal-word{animation:none!important}.prose-fragment{opacity:1;text-shadow:none}.typewriter-caret{display:none}}

/* Compact spacing is applied before any final scaling on very small windows. */
.fit-compact .chapter{margin-bottom:6px;font-size:10px}
.fit-compact .chapter .number{font-size:22px}
.fit-compact .scene-copy,.fit-compact.task-duck .scene-copy{margin-top:8px}
.fit-compact .scene-copy h1{font-size:clamp(22px,2.6vw,32px);line-height:1.35;letter-spacing:3px;margin-bottom:5px}
.fit-compact .scene-copy p{font-size:13px;line-height:1.65;margin:5px 0}
.fit-compact .scene-copy .voice{font-size:16px;line-height:1.65}
.fit-compact .scene-copy .thought,.fit-compact .ending-note{font-size:11px}
.fit-compact .ending-note{padding-top:8px;margin-top:8px}
.fit-compact .scene-copy .closing{font-size:18px;letter-spacing:2px}
.fit-compact .actions,.fit-compact .story-choices{margin-top:8px;gap:8px}
.fit-compact .actions tw-link,.fit-compact .action-button,.fit-compact .hold-button{min-height:38px;padding:7px 15px;font-size:12px}
.fit-compact .story-choices tw-link{min-height:62px;padding:8px 25px 8px 12px;gap:3px}
.fit-compact .choice-title{font-size:12px;line-height:1.6}
.fit-compact .choice-detail{font-size:10px;line-height:1.6}
.fit-compact .memory{font-size:10px;line-height:1.6;margin-top:8px;padding:6px 10px}
.fit-compact .memory>span{font-size:8px;margin-bottom:0}
.fit-compact .chapter-meter{margin-top:8px}
.fit-compact .interaction{margin-top:8px}
.fit-compact .interaction .instructions{font-size:10px;margin-bottom:6px}
.fit-compact .task-status{font-size:10px;margin:3px 0}
.fit-compact .task-track{margin-top:6px}
.fit-compact .duel-status{font-size:10px;margin:6px 0;gap:12px}
.fit-compact .facts{margin:8px auto;gap:8px}
.fit-compact .fact{padding:10px 12px}
.fit-compact .fact strong{font-size:26px;line-height:1.3}
.fit-compact .fact h2{font-size:12px;margin:4px 0}
.fit-compact .fact p{font-size:11px;line-height:1.7}
.fit-compact .fact a{font-size:9px;margin-top:6px}
.fit-compact .facts-note{font-size:9px;line-height:1.6}
.fit-compact .story-whisper{margin-top:8px;padding:6px 10px;gap:2px 10px}
.fit-compact .whisper-copy{font-size:10px}
.fit-compact .whisper-label{font-size:8px}
.fit-compact .whisper-action{font-size:9px}
.fit-compact .selection-head{margin-top:8px}
.fit-compact .selection-head h1{font-size:30px;line-height:1.3;margin:4px 0}
.fit-compact .selection-art{height:40px;margin:6px auto 9px}
.fit-compact .role-copy{padding:9px 14px}
.fit-compact .role-card h2{font-size:22px;margin:3px 0}
.fit-compact .role-card p{font-size:11px;line-height:1.6;min-height:0}
.fit-compact .animal-preview img{height:70px}
.fit-compact .role-enter{margin-top:7px;font-size:12px}
.fit-compact .role-grid{gap:8px;margin-top:0}
.fit-compact .selection-foot{margin-top:10px;margin-bottom:0}
.fit-compact .journal-head{padding:6px 0}
.fit-compact .journal-head h1{font-size:28px;margin:3px 0}
.fit-compact .journal-grid{margin:8px auto;gap:10px}
.fit-compact .journal-role{padding:12px}
.fit-compact .journal-role>img{height:60px}
.fit-compact .journal-role h2{font-size:22px;margin:4px 0 10px}
.fit-compact .journal-entry{padding:8px 0}
.fit-compact .journal-entry h3{font-size:13px;margin-bottom:4px}
.fit-compact .journal-entry p{font-size:11px;line-height:1.7}
.fit-compact .journal-entry .entry-state{font-size:9px;margin-bottom:4px}

@media(max-width:600px){
  tw-story{padding-left:15px;padding-right:15px}
  .mast{min-height:48px;margin-bottom:10px}
  .mast nav{gap:12px}
  .scene-copy h1{font-size:25px;letter-spacing:3px}
  .scene-copy p{font-size:13px;line-height:1.75}
  .scene-copy .voice{font-size:17px;line-height:1.75}
  .story-choices tw-link{min-height:78px}
  .ending .scene-copy h1{font-size:26px}
  .ending .closing{font-size:20px}
  .actions{gap:8px}
  .actions tw-link{padding:9px 15px;font-size:12px;min-height:40px}
  .card-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;width:100%;margin:12px auto 0}
  .card-tabs button{min-width:0}
  .has-card-tabs>.fact:not(.is-active),.has-card-tabs>.journal-role:not(.is-active){display:none}
  .facts.has-card-tabs,.journal-grid.has-card-tabs{grid-template-columns:1fr;margin-top:10px}
  .fact,.data-ending .facts .fact{padding:13px 16px}
  .fact strong{font-size:29px}
  .fact h2{font-size:13px}
  .fact p{font-size:12px;line-height:1.8}
  .fact a{font-size:9px}
  .journal-head{padding:8px 0}
  .journal-head h1{font-size:30px;margin:4px 0}
  .journal-head p{font-size:10px}
  .journal-role{padding:15px 18px}
  .journal-role>img{height:64px}
  .journal-role h2{margin:4px 0 10px}
  .journal-entry{padding:10px 0 8px}
  .journal-entry h3{font-size:14px;margin-bottom:5px}
  .journal-entry .entry-state{margin-bottom:4px;font-size:9px}
  .fit-compact .role-copy{padding:8px 10px}
  .fit-compact .role-no{font-size:7px}
  .fit-compact .role-card h2{font-size:20px}
  .fit-compact .role-card p{font-size:10px}
  .fit-compact .sound-hint{font-size:7px}
  .fit-compact .selection-foot{font-size:8px;gap:4px}
  .fit-compact .card-tabs{margin-top:8px;gap:6px}
  .fit-compact .card-tabs button{padding:6px;min-height:32px;font-size:11px}
}

/* A short, wide window gives the illustration and story their own columns. */
@media(min-width:601px) and (min-height:601px){
  .page.selection{height:var(--selection-height,calc(100dvh - 90px));display:grid;grid-template-rows:auto auto auto minmax(0,1fr) auto;row-gap:clamp(10px,1.5dvh,16px)}
  .selection .selection-head{margin:0 auto}
  .selection .selection-head h1{font-size:clamp(36px,3.2vw,60px);line-height:1.25;letter-spacing:12px;margin:0 0 10px}
  .selection .selection-head p{font-size:clamp(13px,1.05vw,16px);line-height:1.8}
  .selection .selection-art{width:280px;height:clamp(40px,8dvh,76px);margin:0 auto}
  .selection .role-grid{width:100%;height:100%;min-height:0;max-width:1380px;margin:0 auto;gap:clamp(14px,1.6vw,28px)}
  .selection .role-card{display:flex;flex-direction:column;min-height:0}
  .selection .animal-preview{display:flex;flex:1 1 0;min-height:0;flex-direction:column;justify-content:center;padding:20px 24px 6px}
  .selection .animal-preview img{flex:1 1 0;min-height:0;height:0;opacity:.8}
  .selection .sound-hint{flex:none;font-size:clamp(10px,.8vw,12px);padding-top:10px}
  .selection .role-copy{flex:none;padding:clamp(16px,1.5vw,28px)}
  .selection .role-no{font-size:clamp(9px,.75vw,12px)}
  .selection .role-card h2{font-size:clamp(28px,2vw,38px);line-height:1.4;margin:8px 0 10px}
  .selection .role-card p{font-size:clamp(13px,1.05vw,16px);line-height:1.8;min-height:0}
  .selection .role-enter{font-size:clamp(14px,1.05vw,17px);margin-top:18px}
  .selection .role-enter tw-link{min-height:36px}
  .selection .role-count{font-size:12px;top:18px;right:22px}
  .selection .selection-foot{width:100%;margin:0 auto;font-size:clamp(10px,.8vw,12px);gap:10px}
}
@media(min-width:701px) and (max-height:600px){
  tw-story{padding-left:24px;padding-right:24px}
  .mast{min-height:40px;margin-bottom:8px}
  .scene-stage{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:22px;align-items:center}
  .scene-stage>.chapter,.scene-stage>.chapter-meter{grid-column:1/-1}
  .scene-stage>.artwork{grid-column:1;grid-row:2}
  .scene-stage>.scene-panel{grid-column:2;grid-row:2}
  .scene-panel .scene-copy{margin-top:0}
  .scene-copy h1{font-size:25px;letter-spacing:3px}
  .scene-copy p{font-size:13px;line-height:1.65}
  .scene-copy .voice{font-size:16px;line-height:1.65}
  .story-choices{gap:8px}
  .story-choices tw-link{min-height:64px;padding:8px 24px 8px 10px}
  .choice-title{font-size:12px}
  .choice-detail{font-size:10px;line-height:1.6}
  .memory{font-size:10px;margin-top:8px;padding:6px 10px}
  .task-duck>.scene-panel{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:center}
  .task-duck .interaction{width:100%;margin-top:0}
  .task-duck .scene-copy{margin:0}
  .duel-status{font-size:10px;gap:12px;margin:6px 0}
  .interaction .instructions{font-size:10px}
  .task-status{font-size:10px}
  .actions tw-link,.action-button,.hold-button{min-height:36px;font-size:12px;padding:7px 12px}
  .data-ending{grid-template-columns:minmax(0,.55fr) minmax(0,1.45fr)}
  .data-ending .card-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}
  .data-ending .has-card-tabs>.fact:not(.is-active){display:none}
  .data-ending .facts.has-card-tabs{grid-template-columns:1fr;margin:8px auto}
  .data-ending .fact{padding:10px 12px}
  .data-ending .fact strong{font-size:26px;line-height:1.3}
  .data-ending .fact h2{font-size:12px;margin:3px 0}
  .data-ending .fact p{font-size:11px;line-height:1.65}
  .data-ending .fact a{font-size:9px;margin-top:5px}
  .data-ending .scene-copy h1{font-size:24px;margin-bottom:4px}
  .data-ending .scene-copy .voice{font-size:14px}
  .data-ending .facts-note{font-size:9px;line-height:1.6}
  .selection .role-card{display:grid;grid-template-columns:28% minmax(0,1fr)}
  .selection .animal-preview{padding:5px}
  .selection .animal-preview img{height:65px}
  .selection .sound-hint{font-size:8px;letter-spacing:0;line-height:1.6}
  .selection .role-copy{padding:10px 12px 10px 5px}
  .selection .role-count{top:8px;right:10px;font-size:9px}
  .selection-art{height:32px;margin:6px auto 10px}
  .journal{display:grid;grid-template-columns:170px minmax(0,1fr);column-gap:18px;align-items:start}
  .journal-head{grid-column:1;grid-row:1/4;text-align:left;padding-top:12px}
  .journal-head h1{font-size:28px;letter-spacing:7px;margin:6px 0}
  .journal-head p{font-size:11px;line-height:1.8}
  .journal>.card-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;grid-column:2;margin:0}
  .journal-grid.has-card-tabs{grid-column:2;grid-template-columns:1fr;margin:8px 0}
  .journal .has-card-tabs>.journal-role:not(.is-active){display:none}
  .journal-role{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;padding:12px}
  .journal-role>img{grid-column:1;grid-row:1;justify-self:start;height:36px;width:55px}
  .journal-role>.role-no{grid-column:2;grid-row:1;align-self:center}
  .journal-role h2{grid-column:1;grid-row:1;justify-self:end;align-self:center;font-size:20px;letter-spacing:2px;margin:0}
  .journal-entry{grid-row:2;padding:8px 0}
  .journal-entry h3{font-size:13px;line-height:1.5;margin-bottom:5px}
  .journal-entry p{font-size:11px;line-height:1.7}
  .journal-entry .entry-state{font-size:8px;letter-spacing:1px;margin-bottom:5px}
  .journal-role .role-enter{grid-column:1/-1;margin:0;font-size:12px}
  .journal>.actions{grid-column:2;margin-top:4px}
}

/* The title is a still poster; only the light, dust and rings move inside it. */
.title-screen{height:var(--selection-height,calc(100dvh - 86px));position:relative;isolation:isolate;display:grid;grid-template-rows:minmax(0,1fr) auto;overflow:hidden;background:#000;padding:0 8px}
.title-dust,.title-light{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
.title-light{background:radial-gradient(ellipse at 76% 46%,#ffffff0b,transparent 58%);opacity:.75}
.title-main{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);align-items:center;gap:clamp(20px,4vw,72px);min-height:0}
.title-copy{padding:clamp(10px,3dvh,32px) 0;min-width:0}
.title-overline{font:10px/1.8 Georgia,"Microsoft YaHei",serif;letter-spacing:3px;color:#999;margin-bottom:clamp(16px,3dvh,30px)}
.title-wordmark{font:normal clamp(52px,10.2dvh,112px)/1.14 "Songti SC","SimSun",serif;letter-spacing:.12em;color:#f5f5f5;margin:0}
.title-wordmark>span{display:block;position:relative;width:fit-content;white-space:nowrap}
.title-wordmark>span:last-child{padding-left:.4em}
.title-mark{position:absolute;font:normal .25em/1 Georgia,serif;right:-1.25em;top:.35em;color:#999}
.title-english{font:10px/1.8 Georgia,serif;letter-spacing:5px;color:#888;margin-top:20px}
.title-subtitle{font:normal clamp(18px,2.8dvh,28px)/1.6 "SimSun",serif;letter-spacing:.5em;margin:14px 0 16px;color:#dedede}
.title-invitation{font-size:13px;line-height:1.9;letter-spacing:2px;color:#aaa;margin:0}
.title-controls{margin-top:clamp(20px,4dvh,42px)}
.title-controls .actions{justify-content:flex-start;flex-wrap:nowrap;gap:14px;margin:0}
.title-controls .actions>span:first-child{flex:1;max-width:258px}
.title-controls .actions>span:first-child tw-link{display:flex;justify-content:space-between;width:100%;min-height:58px;padding:14px 25px;background:#f3f3f3;color:#111;border-color:#f3f3f3;letter-spacing:3px}
.title-controls .actions>span:first-child tw-link:hover{background:#fff;box-shadow:0 0 30px #ffffff22}
.title-controls .actions>span:last-child tw-link{background:transparent;border:0;min-height:48px;padding:10px;color:#aaa;font-size:12px;white-space:nowrap;letter-spacing:1px}
.title-controls .actions>span:last-child tw-link:hover{color:#fff}
.title-listen{display:inline-flex;align-items:center;gap:10px;border:0;background:none;padding:12px 0 0;color:#888;font-size:10px;letter-spacing:1px}
.title-listen:hover{color:#ddd}
.title-equalizer{display:flex;align-items:center;gap:3px;height:16px;width:23px}
.title-equalizer i{width:2px;height:3px;background:currentColor;transform-origin:center}
.title-screen.is-sounding .title-equalizer i{height:12px;animation:title-equalize 1.1s ease-in-out infinite}
.title-screen.is-sounding .title-equalizer i:nth-child(2){animation-delay:-.3s}
.title-screen.is-sounding .title-equalizer i:nth-child(3){animation-delay:-.6s}
.title-screen.is-sounding .title-equalizer i:nth-child(4){animation-delay:-.8s}
.title-visual{position:relative;width:100%;height:100%;max-height:620px;min-height:240px;min-width:0;align-self:center}
.title-orbit{position:absolute;width:96%;aspect-ratio:1;left:50%;top:47%;transform:translate(-50%,-50%);border:1px solid #ffffff12;border-radius:50%;pointer-events:none}
.title-orbit:before,.title-orbit:after{content:"";position:absolute;left:50%;top:50%;border-radius:50%;transform:translate(-50%,-50%)}
.title-orbit:before{width:86%;height:86%;border:1px solid #ffffff24;box-shadow:0 0 80px #ffffff07,inset 0 0 50px #ffffff06}
.title-orbit:after{width:58%;height:58%;background:radial-gradient(circle,#ffffff16,transparent 70%)}
.orbit-ring{position:absolute;border-radius:50%;inset:4%;border:1px solid transparent;border-top-color:#ccc;border-bottom-color:#ffffff30;animation:title-orbit 42s linear infinite}
.orbit-ring:after{content:"";position:absolute;left:15%;top:13%;width:5px;height:5px;background:#eee;border-radius:50%;box-shadow:0 0 12px #fff8}
.ring-inner{inset:14%;border-top-color:#ffffff38;border-bottom-color:#ffffff70;animation-duration:30s;animation-direction:reverse}
.orbit-cross{position:absolute;inset:-7%;background:linear-gradient(90deg,transparent calc(50% - .5px),#ffffff18 50%,transparent calc(50% + .5px)),linear-gradient(0deg,transparent calc(50% - .5px),#ffffff18 50%,transparent calc(50% + .5px));opacity:.6}
.orbit-star{position:absolute;font-family:Georgia,serif;color:#ccc;font-size:24px;line-height:1;text-shadow:0 0 14px #fff5;animation:title-star 4s ease-in-out infinite}
.star-north{top:-2%;left:48%}
.star-south{right:6%;bottom:14%;font-size:18px;animation-delay:-2s}
.title-portals{position:absolute;inset:16% 4% 21%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:center;gap:14px}
.title-portal{position:relative;isolation:isolate;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;width:100%;height:81%;min-width:0;overflow:hidden;border:1px solid #ffffff40;border-radius:100px 100px 2px 2px;padding:16px 8px 18px;color:#ddd;background:linear-gradient(180deg,#1e1e1e,#080808 68%);box-shadow:0 14px 40px #0008;transition:border-color .25s,box-shadow .25s,background .25s}
.title-portal:before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(115deg,transparent 30%,#ffffff0c 48%,transparent 66%);background-size:230% 100%;animation:title-portal-light 9s ease-in-out infinite}
.title-portal:after{content:"";position:absolute;left:8%;right:8%;bottom:28%;height:1px;background:linear-gradient(90deg,transparent,currentColor,transparent);opacity:.18}
.title-portal:hover,.title-portal:focus-visible,.title-portal.is-playing{border-color:#fff;box-shadow:0 0 34px #ffffff20,0 14px 40px #0008}
.portal-cat{height:100%;color:#151515;background:linear-gradient(165deg,#fff,#ececec 70%,#aaa);border-color:#eee}
.portal-cat:hover,.portal-cat:focus-visible,.portal-cat.is-playing{box-shadow:0 0 48px #ffffff38,0 14px 40px #0008}
.portal-number{position:absolute;top:13%;left:0;right:0;text-align:center;font:italic 12px/1.6 Georgia,serif;letter-spacing:2px;opacity:.65}
.portal-halo{position:absolute;width:52%;aspect-ratio:1;left:24%;top:23%;border:1px solid currentColor;border-radius:50%;opacity:.18}
.title-portal img{position:absolute;left:9%;bottom:33%;width:82%;height:36%;object-fit:contain;filter:brightness(0) invert(1);opacity:.85;pointer-events:none;transition:opacity .25s,filter .25s}
.portal-cat img{filter:brightness(0);opacity:.8}
.title-portal:hover img,.title-portal:focus-visible img,.title-portal.is-playing img{opacity:1}
.portal-caption{display:flex;flex-direction:column;align-items:center;gap:6px}
.portal-caption strong{font:normal 17px/1.5 "SimSun",serif;letter-spacing:4px;text-indent:4px}
.portal-caption small{font:8px/1.5 Georgia,serif;letter-spacing:2px;opacity:.65}
.title-scene-caption{position:absolute;bottom:7%;left:0;right:0;margin:0;text-align:center;color:#aaa;font:normal 14px/1.8 "SimSun",serif;letter-spacing:1px;min-height:3.6em;padding:0 10px;display:flex;align-items:center;justify-content:center}
.title-footer{position:relative;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 0 12px;border-top:1px solid #ffffff20;color:#888;font-size:10px;letter-spacing:1px}
.title-edition{font:9px/1.8 Georgia,"Microsoft YaHei",serif;letter-spacing:2px}
@keyframes title-orbit{to{transform:rotate(360deg)}}
@keyframes title-star{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes title-equalize{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}
@keyframes title-portal-light{0%,100%{background-position:100% 50%}50%{background-position:0 50%}}
@media(max-width:1000px){.title-main{gap:22px}.title-overline{font-size:8px;letter-spacing:2px}.title-controls .actions{gap:8px}.title-portals{gap:10px}.title-portal{padding-bottom:13px}.portal-caption strong{font-size:15px}.portal-caption small{font-size:7px;letter-spacing:1px}.title-invitation{font-size:12px;letter-spacing:1px}}
@media(max-width:700px) and (min-height:601px){
 .title-screen{padding:0 4px}.title-main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr) auto;gap:0;height:100%}.title-copy{display:contents}.title-heading{grid-row:1;text-align:center;padding-top:12px}.title-overline{margin:0 0 9px;font-size:8px;letter-spacing:2px}.title-wordmark{display:flex;justify-content:center;gap:.15em;font-size:clamp(34px,5.5dvh,49px);line-height:1.3;letter-spacing:.08em}.title-wordmark>span:last-child{padding-left:0}.title-mark{display:none}.title-english{font-size:8px;letter-spacing:3px;margin-top:8px}.title-subtitle{font-size:19px;letter-spacing:7px;margin:9px 0}.title-invitation{font-size:11px;line-height:1.75}.title-visual{grid-row:2;min-height:140px;max-height:none;width:100%;height:100%;max-width:410px;justify-self:center}.title-orbit{width:min(90%,32dvh)}.title-portals{inset:10% 9% 19%;gap:12px}.title-portal{padding-bottom:14px;max-height:270px;align-self:center}.portal-number{font-size:10px;top:12%}.portal-caption strong{font-size:15px;letter-spacing:2px}.portal-caption small{font-size:7px}.title-portal img{bottom:36%;height:36%}.title-scene-caption{font-size:12px;bottom:1%;min-height:3em}.title-controls{grid-row:3;text-align:center;margin:0;padding:6px 0 10px}.title-controls .actions{justify-content:center}.title-controls .actions>span:first-child{max-width:210px;flex:1}.title-controls .actions>span:first-child tw-link{min-height:46px;padding:10px 20px;font-size:13px;letter-spacing:2px}.title-listen{padding-top:10px;font-size:9px}.title-footer{font-size:8px;padding:10px 0 8px;gap:6px}.title-edition{display:none}
}
@media(max-height:600px){
 .title-main{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}.title-copy{padding:8px 0}.title-overline{font-size:8px;margin-bottom:10px}.title-wordmark{font-size:clamp(32px,10dvh,56px);line-height:1.1}.title-english{font-size:8px;letter-spacing:3px;margin-top:10px}.title-subtitle{font-size:17px;letter-spacing:5px;margin:8px 0}.title-invitation{font-size:11px;line-height:1.6}.title-controls{margin-top:13px}.title-controls .actions>span:first-child tw-link{min-height:40px;padding:8px 16px;font-size:12px;letter-spacing:2px}.title-controls .actions>span:last-child tw-link{font-size:10px;min-height:36px;padding:6px}.title-listen{padding-top:7px;font-size:9px}.title-visual{min-height:170px}.title-portals{inset:10% 7% 21%;gap:10px}.title-orbit{width:min(80%,65dvh)}.portal-number{font-size:9px}.portal-caption strong{font-size:13px}.portal-caption small{font-size:6px}.title-portal{padding-bottom:10px}.title-scene-caption{font-size:11px;bottom:0}.title-footer{padding:8px 0;font-size:8px}.title-edition{font-size:7px}
}
@media(max-width:700px) and (max-height:600px){
 .title-main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr) auto;gap:0}.title-copy{display:contents}.title-heading{grid-row:1;text-align:center;padding-top:4px}.title-overline{margin-bottom:6px;font-size:7px}.title-wordmark{display:flex;justify-content:center;gap:.15em;font-size:32px;line-height:1.2;letter-spacing:.05em}.title-wordmark>span:last-child{padding-left:0}.title-mark{display:none}.title-english{font-size:7px;margin-top:6px}.title-subtitle{font-size:16px;margin:6px 0;letter-spacing:5px}.title-invitation{font-size:10px;line-height:1.6}.title-visual{grid-row:2;min-height:110px;max-height:none}.title-portals{inset:10% 10% 23%;gap:10px}.title-orbit{width:min(84%,31dvh)}.title-portal{padding-bottom:8px}.portal-number{top:10%;font-size:8px}.portal-caption{gap:3px}.portal-caption strong{font-size:12px;letter-spacing:2px}.portal-caption small{font-size:6px;letter-spacing:1px}.title-portal img{bottom:35%;height:33%}.title-scene-caption{font-size:10px;bottom:0;min-height:3em}.title-controls{grid-row:3;text-align:center;margin:0;padding:5px 0 8px}.title-controls .actions{justify-content:center}.title-controls .actions>span:first-child{max-width:175px}.title-controls .actions>span:first-child tw-link{min-height:38px;padding:8px 15px}.title-listen{padding-top:6px;font-size:8px}.title-footer{font-size:7px;letter-spacing:0}.title-edition{display:none}
}
@media(max-width:600px){.mast{gap:10px}.mast nav{gap:10px;flex-shrink:0}.brand{font-size:9px;letter-spacing:0;gap:6px}}
@media(prefers-reduced-motion:reduce){.orbit-ring,.orbit-star,.title-portal:before,.title-screen.is-sounding .title-equalizer i{animation:none!important}}


:: 游戏交互与声音 [script] {"position": "480,2700", "size": "180,100"}
(function(){
  'use strict';
  const storageKey='they-once-existed-new-gift-v1';
  const validEndings=['pig-live','pig-fall','cat-light','cat-sleep','duck-yes','duck-no'];
  let saved={endings:[],muted:false};
  try{const value=JSON.parse(localStorage.getItem(storageKey)||'{}');if(value&&typeof value==='object')saved={endings:Array.isArray(value.endings)?[...new Set(value.endings.filter(x=>validEndings.includes(x)))]:[],muted:value.muted===true};}catch(_){}
  const persist=()=>{try{localStorage.setItem(storageKey,JSON.stringify(saved));}catch(_){}};
  persist();
  // 三条路线按章节播放 GitHub 原始文件直链。同一音频跨页面继续播放，切换章节时停止上一段。
  const sceneAudio={
    themeOpen:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/audio/Hollow%20Knight.mp3?v=b1da8ecb9484',
    themeEnd:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/audio/%E3%81%8B%E3%81%9F%E3%82%8F%E3%82%8C%E6%99%82.m4a?v=76da2363fc9c',
    pigOpen:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AA%E9%9F%B3%E9%A2%91/%E7%8C%AA%E5%BC%80%E5%9C%BA.m4a',pigInteract:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AA%E9%9F%B3%E9%A2%91/%E7%8C%AA%E4%BA%A4%E4%BA%92.m4a',pigWorship:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AA%E9%9F%B3%E9%A2%91/%E7%8C%AA%E5%B4%87%E6%8B%9C.m4a',pigLive:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AA%E9%9F%B3%E9%A2%91/%E7%8C%AA%E5%AD%98%E6%B4%BB.m4a',pigFall:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AA%E9%9F%B3%E9%A2%91/%E7%8C%AA%E7%81%AD%E7%BB%9D.m4a',
    catOpen:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB%E5%BC%80%E5%9C%BA.m4a',
    catInteract:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB%E5%90%83%E8%8D%AF.m4a',
    catDream:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB%E5%B9%BB%E6%83%B3.m4a',
    catPriest:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB%E7%A5%AD%E5%8F%B8.m4a',
    catEnd:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB%E6%AD%BB%E4%BA%A1.m4a',
    duckOpen:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD%E5%BC%80%E5%9C%BA.m4a',
    duckWorship:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD%E5%B4%87%E6%8B%9C.m4a',
    duckInteract:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD%E4%BA%A4%E4%BA%92.m4a',
    duckScales:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD%E5%A4%A9%E6%9E%B0.m4a',
    duckEnd:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD%E7%A5%AD%E5%8F%B8.m4a'
  };
  const calls={pig:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E5%8F%AB%E5%A3%B0/%E9%87%8E%E7%8C%AA%E5%8F%AB.mp3',cat:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E5%8F%AB%E5%A3%B0/%E7%8C%AB%E5%8F%AB.mp3',duck:'https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E5%8F%AB%E5%A3%B0/%E9%B8%AD%E5%AD%90%E5%8F%AB.mp3'};
  const ambient=new Audio();ambient.loop=true;ambient.preload='none';ambient.volume=.52;
  const preview=new Audio();preview.preload='none';preview.volume=.7;
  let wanted='',active='',unlocked=false,lastPage=null,previewButton=null,previewTimer=0,toastTimer=0,audioContext=null;
  let sceneSoundTimers=[];
  const safeURL=path=>new URL(path,document.baseURI).href;
  const normalVolume=()=>wanted.startsWith('theme')?.26:.52;
  function syncTitleSound(){
    const title=document.querySelector('.title-screen');if(!title)return;
    const playing=!saved.muted&&!ambient.paused&&!ambient.error;
    title.classList.toggle('is-sounding',playing);
    const label=title.querySelector('[data-title-audio-status]'),message=saved.muted?'音乐已关闭，点击开启':!unlocked?'点击开启音乐':ambient.error?'音乐暂时没加载好，点击重试':playing?'音乐已开启':'正在加载音乐…';
    if(label&&label.textContent!==message)label.textContent=message;
  }
  function resetPreview(){preview.pause();if(previewButton)previewButton.classList.remove('is-playing');previewButton=null;clearTimeout(previewTimer);}
  function syncAudio(){
    document.querySelectorAll('[data-audio-toggle]').forEach(b=>{b.textContent=saved.muted?'声音：关':'声音：开';b.classList.toggle('is-off',saved.muted);b.setAttribute('aria-pressed',String(!saved.muted));b.setAttribute('aria-label',saved.muted?'打开声音':'关闭声音');});
    ambient.muted=saved.muted;preview.muted=saved.muted;
    if(saved.muted||!unlocked){ambient.pause();syncTitleSound();return;}
    const source=sceneAudio[wanted]||'';
    if(!source){ambient.pause();active='';ambient.removeAttribute('src');ambient.load();syncTitleSound();return;}
    if(active!==source){ambient.pause();ambient.src=safeURL(source);active=source;}
    ambient.volume=previewButton?.12:normalVolume();
    if(ambient.paused)ambient.play().catch(()=>{});
    syncTitleSound();
  }
  function toast(message){document.querySelector('.sound-toast')?.remove();clearTimeout(toastTimer);const el=document.createElement('div');el.className='sound-toast';el.setAttribute('role','status');el.textContent=message;document.body.append(el);toastTimer=setTimeout(()=>el.remove(),1900);}
  function playCall(animal,button){if(saved.muted){toast('声音已关闭');return;}const source=calls[animal];if(!source)return;resetPreview();previewButton=button;button.classList.add('is-playing');preview.src=safeURL(source);ambient.volume=.12;preview.play().then(()=>{previewTimer=setTimeout(resetPreview,4500);}).catch(()=>resetPreview());}
  preview.addEventListener('ended',()=>{resetPreview();ambient.volume=normalVolume();});preview.addEventListener('pause',()=>{ambient.volume=normalVolume();});preview.addEventListener('error',()=>{resetPreview();ambient.volume=normalVolume();});
  for(const event of ['playing','pause','error','emptied'])ambient.addEventListener(event,syncTitleSound);
  function sound(kind){
    if(saved.muted||!unlocked)return;
    try{
      audioContext=audioContext||new (window.AudioContext||window.webkitAudioContext)();
      if(audioContext.state==='suspended')audioContext.resume().catch(()=>{});
      const time=audioContext.currentTime,gain=audioContext.createGain();gain.connect(audioContext.destination);
      if(kind==='heartbeat'||kind==='monitor'){
        const tone=(offset,frequency,duration,volume)=>{const oscillator=audioContext.createOscillator(),envelope=audioContext.createGain();oscillator.type='sine';oscillator.frequency.setValueAtTime(frequency,time+offset);envelope.gain.setValueAtTime(.001,time+offset);envelope.gain.exponentialRampToValueAtTime(volume,time+offset+.015);envelope.gain.exponentialRampToValueAtTime(.001,time+offset+duration);oscillator.connect(envelope);envelope.connect(audioContext.destination);oscillator.start(time+offset);oscillator.stop(time+offset+duration+.02);};
        if(kind==='heartbeat'){tone(0,58,.13,.13);tone(.19,48,.15,.09);}else tone(0,880,.65,.035);
        return;
      }
      const duration=kind==='ram'?.15:kind==='chew'?.095:.06;
      const osc=audioContext.createOscillator();osc.type=kind==='ram'?'triangle':'sine';osc.frequency.setValueAtTime(kind==='ram'?105:kind==='chew'?680:340,time);osc.frequency.exponentialRampToValueAtTime(kind==='ram'?32:kind==='chew'?180:210,time+duration);gain.gain.setValueAtTime(0,time);gain.gain.linearRampToValueAtTime(kind==='ram'?.12:.045,time+.008);gain.gain.exponentialRampToValueAtTime(.001,time+duration);osc.connect(gain);osc.start(time);osc.stop(time+duration+.02);
    }catch(_){}
  }
  function stopSceneSounds(){sceneSoundTimers.forEach(clearTimeout);sceneSoundTimers=[];}
  function startSceneSounds(page){
    stopSceneSounds();if(page.dataset.fx!=='farewell')return;
    for(const delay of [100,1000,1900,2800,3700])sceneSoundTimers.push(setTimeout(()=>{if(page===lastPage&&!document.hidden)sound('heartbeat');},delay));
    sceneSoundTimers.push(setTimeout(()=>{if(page===lastPage&&!document.hidden)sound('monitor');},4700));
  }
  function artworkImpact(page){
    if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
    const art=page.querySelector('.artwork'),img=art?.querySelector('img');
    // Only an explicit hit moves the illustration; entering a page never does.
    img?.animate([{transform:'translate(0,0)'},{transform:'translate(-2px,1px)'},{transform:'translate(2px,-1px)'},{transform:'translate(0,0)'}],{duration:210,easing:'ease-out'});
    art?.querySelector('.impact-flash')?.animate([{opacity:0},{opacity:.55,offset:.2},{opacity:0}],{duration:300});
  }
  function revealGod(page){
    const art=page.querySelector('.artwork'),img=art?.querySelector('img');if(!img)return;
    const preload=new Image();preload.src=safeURL('https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/6%E6%9C%BA%E5%99%A8%E5%8F%98%E9%87%8E%E7%8C%AA.jpg');
    preload.decode().then(()=>{if(page!==lastPage)return;img.src=preload.src;img.alt='第五次撞击之后，机械显出了野猪神明的轮廓';art.dataset.transformed='yes';if(!matchMedia('(prefers-reduced-motion: reduce)').matches)img.animate([{opacity:.25,filter:'brightness(1.8)'},{opacity:1,filter:'brightness(1)'}],{duration:900,easing:'ease-out'});}).catch(()=>{});
  }
  function setupSceneEffects(page){
    const art=page.querySelector('.artwork');
    if(art){
      const veil=document.createElement('div');veil.className='scene-atmosphere';veil.setAttribute('aria-hidden','true');
      if(page.dataset.fx==='steam')for(let i=0;i<3;i++){const cloud=document.createElement('span');cloud.className='atmosphere-cloud';cloud.style.setProperty('--cloud',String(i));veil.append(cloud);}
      art.append(veil);
      if(page.querySelector('[data-task="ram"],[data-task="chew"]')){const flash=document.createElement('span');flash.className='impact-flash';flash.setAttribute('aria-hidden','true');art.append(flash);}
      if(page.dataset.scene==='猫_牢笼'){
        art.classList.add('is-clickable','is-listening');art.tabIndex=0;art.setAttribute('role','button');art.setAttribute('aria-label','听听牢笼里的猫叫');
        const listen=()=>playCall('cat',art);art.addEventListener('click',listen);art.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();listen();}});
      }
    }
    startSceneSounds(page);
  }
  function setupTextEffects(page){
    page.querySelectorAll('.scene-copy h1,.selection-head h1,.journal-head h1').forEach(title=>title.classList.add('ink-title'));
    let order=0;
    page.querySelectorAll('.scene-copy p').forEach(paragraph=>{
      if(paragraph.closest('.story-whisper')||paragraph.querySelector('.typewriter-line'))return;
      const walker=document.createTreeWalker(paragraph,NodeFilter.SHOW_TEXT),nodes=[];
      while(walker.nextNode()){
        const node=walker.currentNode;
        if(node.textContent.trim()&&!node.parentElement.closest('.word-slot,tw-link,tw-hook,tw-expression,tw-enchantment,.sr-only'))nodes.push(node);
      }
      nodes.forEach(node=>{
        const fragment=document.createDocumentFragment();
        for(const sentence of node.textContent.match(/[^。！？；\n]+[。！？；]?|[。！？；\n]/g)||[]){
          const span=document.createElement('span');span.className='prose-fragment';span.style.setProperty('--ink-delay',Math.min(order++*110,660)+'ms');span.textContent=sentence;fragment.append(span);
        }
        node.replaceWith(fragment);
      });
    });
  }
  function setupTitle(page){
    if(!page.classList.contains('title-screen'))return;
    const caption=page.querySelector('[data-title-caption]'),defaultLine=caption.textContent;
    const show=button=>{caption.textContent=button?.dataset.titleLine||defaultLine;page.dataset.focus=button?.dataset.animal||'';};
    page.querySelectorAll('.title-portal').forEach(button=>{
      button.addEventListener('pointerenter',()=>show(button));button.addEventListener('focus',()=>show(button));
      button.addEventListener('pointerleave',()=>{if(document.activeElement!==button)show(null);});button.addEventListener('blur',()=>show(null));
    });
    const canvas=page.querySelector('.title-dust'),context=canvas.getContext('2d');if(!context)return;
    const motion=matchMedia('(prefers-reduced-motion: reduce)');let frame=0,width=1,height=1,last=0,clock=0,destroyed=false;
    const dots=Array.from({length:54},()=>({x:Math.random(),y:Math.random(),size:.4+Math.random()*1.1,speed:2+Math.random()*6,phase:Math.random()*Math.PI*2}));
    function draw(now){
      frame=0;if(destroyed)return;
      const delta=last?Math.min((now-last)/1000,.05):0;last=now;clock+=delta;context.clearRect(0,0,width,height);
      for(const dot of dots){if(!motion.matches)dot.y=(dot.y-dot.speed*delta/height+1)%1;const alpha=.16+(Math.sin(clock*.7+dot.phase)+1)*.16;context.fillStyle='rgba(255,255,255,'+alpha+')';context.beginPath();context.arc(dot.x*width,dot.y*height,dot.size,0,Math.PI*2);context.fill();}
      if(!motion.matches&&!document.hidden)frame=requestAnimationFrame(draw);
    }
    const pause=()=>{cancelAnimationFrame(frame);frame=0;last=0;};
    const resume=()=>{if(!destroyed&&!frame){last=0;frame=requestAnimationFrame(draw);}};
    const size=()=>{const rect=canvas.getBoundingClientRect(),ratio=Math.min(devicePixelRatio||1,2);width=Math.max(1,rect.width);height=Math.max(1,rect.height);canvas.width=Math.round(width*ratio);canvas.height=Math.round(height*ratio);context.setTransform(ratio,0,0,ratio,0,0);pause();resume();};
    const observer=new ResizeObserver(size);observer.observe(canvas);motion.addEventListener('change',size);size();
    page._pauseTitle=pause;page._resumeTitle=resume;page._stopTitle=()=>{destroyed=true;pause();observer.disconnect();motion.removeEventListener('change',size);};
  }
  function syncProgress(){
    document.querySelectorAll('[data-journal-total]').forEach(el=>el.textContent=saved.endings.length+'/'+validEndings.length);
    document.querySelectorAll('[data-role-count]').forEach(el=>{const count=saved.endings.filter(id=>id.startsWith(el.dataset.roleCount+'-')).length;el.textContent=count+'/2';el.classList.toggle('has-ending',count>0);});
    document.querySelectorAll('[data-entry]').forEach(el=>{const found=saved.endings.includes(el.dataset.entry);el.classList.toggle('is-discovered',found);el.querySelector('.entry-state').textContent=found?'已完成 / DISCOVERED':'尚未完成 / UNDISCOVERED';el.querySelector('.entry-copy').textContent=found?el.dataset.description:'走完这条路线后，这里会记下结局。';});
  }
  function complete(task,text){if(task.dataset.complete==='yes')return;task.dataset.complete='yes';task.classList.add('task-complete');const status=task.querySelector('[data-task-status]');if(status)status.textContent=text;task.querySelectorAll('[data-task-action]').forEach(b=>b.disabled=true);task.querySelectorAll('[data-task-next]').forEach(el=>{el.classList.remove('is-locked');el.removeAttribute('inert');el.removeAttribute('aria-hidden');});const meter=task.querySelector('.task-track span');if(meter)meter.style.width='100%';}
  function setupTask(task,page){
    const kind=task.dataset.task;let count=0;const goal=Number(task.dataset.goal||1);const status=task.querySelector('[data-task-status]'),track=task.querySelector('.task-track span');
    task.querySelectorAll('[data-task-next].is-locked').forEach(el=>{el.setAttribute('inert','');el.setAttribute('aria-hidden','true');});
    if(kind==='ram')task.querySelector('[data-task-action]').addEventListener('click',()=>{if(count>=goal)return;count++;task.dataset.value=String(count);status.textContent='獠牙撞击 · '+count+' / '+goal;if(track)track.style.width=count/goal*100+'%';sound('ram');artworkImpact(page);if(count===goal){complete(task,'撞了五下。你抬起头，灯光后面好像有一对獠牙。');revealGod(page);}});
    if(kind==='chew')task.querySelector('[data-task-action]').addEventListener('click',()=>{sound('chew');artworkImpact(page);complete(task,'咔嚓。奇怪的味道在嘴里散开。');});
    if(kind==='duel'){
      const targets=[...task.querySelectorAll('[data-duck-target]')];let previous=-1,hits=[0,0];
      targets.forEach((button,index)=>button.addEventListener('click',event=>{
        if(task.dataset.complete==='yes'||button.disabled)return;
        if(index===previous){status.textContent='它挡住了你。换一个方向，再试一次。';return;}
        previous=index;hits[index]++;count++;task.dataset.value=String(count);sound('grain');button.classList.add('is-hit');setTimeout(()=>button.classList.remove('is-hit'),160);
        const remaining=Math.max(0,3-hits[index]);button.querySelector('[data-target-life]').textContent=remaining===0?'对手已退下':'还需 '+remaining+' 次';
        const grain=task.querySelector('[data-grains]');grain.textContent=String(count);if(track)track.style.width=count/goal*100+'%';status.textContent=remaining===0?'它让开了。你又抢到一粒粮。':'抢到一粒。换个方向，再挤过去。';
        const rect=button.getBoundingClientRect();for(let i=0;i<5;i++){const dot=document.createElement('i');dot.className='crumb';dot.style.left=(event.clientX?event.clientX-rect.left:rect.width/2)+'px';dot.style.top=(event.clientY?event.clientY-rect.top:rect.height/2)+'px';dot.style.setProperty('--dx',(Math.random()*70-35)+'px');dot.style.setProperty('--dy',(-20-Math.random()*65)+'px');button.append(dot);setTimeout(()=>dot.remove(),800);}
        if(remaining===0)button.disabled=true;if(count>=goal)complete(task,'前面的鸭子退开了。你护住刚抢到的六粒粮。');
      }));
    }
    if(kind==='hold'){
      const button=task.querySelector('[data-task-action]'),duration=1800;let elapsed=0,started=0,frame=0,holding=false;
      const stop=()=>{if(!holding)return;elapsed=Math.min(duration,elapsed+performance.now()-started);holding=false;cancelAnimationFrame(frame);button.classList.remove('is-holding');page.querySelector('.artwork')?.classList.remove('is-steaming');if(elapsed<duration)status.textContent='再注视一会儿。巨神身旁的白雾还没有散尽。';};
      const tick=()=>{if(!holding)return;const value=Math.min(duration,elapsed+performance.now()-started);button.style.setProperty('--hold',String(value/duration));if(track)track.style.width=value/duration*100+'%';status.textContent='巨神正在喷出白雾 · '+Math.round(value/duration*100)+'%';if(value>=duration){elapsed=duration;stop();complete(task,'巨神喷出的白雾散开了。林间仍回荡着轰鸣。');return;}frame=requestAnimationFrame(tick);};
      const start=event=>{if(holding||task.dataset.complete==='yes')return;if(event.type==='pointerdown'&&event.button!==0)return;event.preventDefault();event.stopPropagation();started=performance.now();holding=true;button.classList.add('is-holding');page.querySelector('.artwork')?.classList.add('is-steaming');frame=requestAnimationFrame(tick);};
      button.addEventListener('pointerdown',start);button.addEventListener('contextmenu',event=>event.preventDefault());button.addEventListener('keydown',e=>{if([' ','Enter'].includes(e.key)&&!e.repeat)start(e);});page._stopHold=()=>{stop();cancelAnimationFrame(frame);};
    }
  }
  function setupCardTabs(page){
    page.querySelectorAll('.facts,.journal-grid').forEach((group,index)=>{
      const cards=[...group.children];if(cards.length<2)return;
      const tabs=document.createElement('nav');tabs.className='card-tabs';tabs.setAttribute('aria-label',group.classList.contains('facts')?'切换资料':'切换角色手记');
      group.classList.add('has-card-tabs');
      cards.forEach((card,i)=>{
        const button=document.createElement('button');button.type='button';button.textContent=card.dataset.cardLabel||card.querySelector('strong')?.textContent||String(i+1);
        card.id='scene-card-'+index+'-'+i;button.setAttribute('aria-controls',card.id);button.setAttribute('aria-pressed',String(i===0));card.classList.toggle('is-active',i===0);
        button.addEventListener('click',()=>{cards.forEach((item,j)=>item.classList.toggle('is-active',i===j));[...tabs.children].forEach((item,j)=>item.setAttribute('aria-pressed',String(i===j)));});tabs.append(button);
      });
      group.before(tabs);
    });
  }
  function reserveCardHeight(page){
    page.querySelectorAll('.has-card-tabs').forEach(group=>{
      group.style.minHeight='0';
      if(getComputedStyle(group.previousElementSibling).display==='none')return;
      const cards=[...group.children],selected=cards.find(card=>card.classList.contains('is-active'))||cards[0];let height=0;
      cards.forEach(card=>{cards.forEach(item=>item.classList.toggle('is-active',item===card));height=Math.max(height,group.getBoundingClientRect().height/Number(page.style.zoom||1));});
      cards.forEach(card=>card.classList.toggle('is-active',card===selected));group.style.minHeight=Math.ceil(height)+'px';
    });
  }
  function fitPage(page){
    if(!page?.isConnected)return;
    // All measurements and sizing finish synchronously before the next paint.
    const setScale=value=>{page.style.zoom=String(value);page.style.width='100%';};
    setScale(1);page.classList.remove('fit-compact');
    const height=document.documentElement.clientHeight,bottom=parseFloat(getComputedStyle(document.querySelector('tw-story')).paddingBottom)||12;
    const available=Math.max(1,height-page.getBoundingClientRect().top-bottom-1);
    page.style.setProperty('--selection-height',available+'px');
    const wide=matchMedia('(min-width:701px) and (max-height:600px)').matches;
    const artwork=page.querySelector('.artwork'),duel=page.querySelector('.duel');
    const hasArtwork=artwork&&getComputedStyle(artwork).display!=='none';
    const maximum=wide?Math.max(60,available-55):Math.min(height*(page.classList.contains('data-ending')?.3:page.classList.contains('ending')?.4:.52),680);
    const minimum=wide?60:Math.min(110,Math.max(64,height*.12));
    const sizeArt=()=>{
      if(hasArtwork)page.style.setProperty('--art-height',maximum+'px');
      if(duel)page.style.setProperty('--duel-height',Math.min(height*.28,260)+'px');
      reserveCardHeight(page);
      const excess=page.getBoundingClientRect().height-available;
      if(excess>0){
        if(wide&&hasArtwork){page.style.setProperty('--art-height',Math.max(minimum,maximum-excess)+'px');}
        else if(hasArtwork)page.style.setProperty('--art-height',Math.max(minimum,maximum-excess-1)+'px');
        else if(duel){const image=duel.querySelector('img');page.style.setProperty('--duel-height',Math.max(64,image.getBoundingClientRect().height-excess-1)+'px');}
      }
    };
    sizeArt();
    if(page.getBoundingClientRect().height>available){page.classList.add('fit-compact');sizeArt();}
    // Small windows still show the complete content: fit it as a unit instead of clipping it.
    if(page.getBoundingClientRect().height>available){
      let low=.2,high=1,best=.2;
      for(let i=0;i<11;i++){const scale=(low+high)/2;setScale(scale);reserveCardHeight(page);if(page.getBoundingClientRect().height<=available){best=scale;low=scale;}else high=scale;}
      setScale(best);reserveCardHeight(page);
    }
    page.dataset.fitScale=page.style.zoom;
  }
  function setup(){
    const pages=[...document.querySelectorAll('tw-passage .page')];const page=pages[pages.length-1];if(!page||page===lastPage)return false;
    lastPage?._stopHold?.();lastPage?._stopTitle?.();lastPage=page;resetPreview();wanted=page.dataset.sound||'';
    document.documentElement.dataset.role=['pig','cat','duck'].find(role=>page.classList.contains('role-'+role))||'selection';
    document.documentElement.dataset.view=page.classList.contains('title-screen')?'title':'story';
    const ending=page.dataset.ending;if(validEndings.includes(ending)&&!saved.endings.includes(ending)){saved.endings.push(ending);persist();}
    syncProgress();syncAudio();
    page.querySelectorAll('[data-task]').forEach(task=>setupTask(task,page));
    setupCardTabs(page);setupSceneEffects(page);setupTextEffects(page);fitPage(page);setupTitle(page);
    page.querySelectorAll('.artwork[data-advance]').forEach(art=>{const next=page.querySelector('.actions tw-link');if(!next)return;art.classList.add('is-clickable');art.tabIndex=0;art.setAttribute('role','button');art.setAttribute('aria-label','继续故事');const advance=()=>{if(page!==lastPage)return;next.click();};art.addEventListener('click',advance);art.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();advance();}});});
    window.scrollTo({top:0,behavior:'instant'});
    const heading=page.querySelector('h1');if(heading){heading.tabIndex=-1;heading.focus({preventScroll:true});}
    return true;
  }
  document.addEventListener('pointerdown',()=>{if(!unlocked){unlocked=true;syncAudio();}},{capture:true});
  document.addEventListener('keydown',event=>{if(!unlocked){unlocked=true;syncAudio();}if(['Tab','Escape'].includes(event.key))lastPage?._stopHold?.();},{capture:true});
  document.addEventListener('keyup',event=>{if([' ','Enter'].includes(event.key))lastPage?._stopHold?.();},{capture:true});
  document.addEventListener('pointerup',()=>lastPage?._stopHold?.(),{capture:true});
  document.addEventListener('pointercancel',()=>lastPage?._stopHold?.(),{capture:true});
  window.addEventListener('blur',()=>lastPage?._stopHold?.());
  document.addEventListener('click',event=>{
    if(event.target.closest('[data-start-listening]')){unlocked=true;saved.muted=false;persist();if(ambient.error)ambient.load();syncAudio();return;}
    const toggle=event.target.closest('[data-audio-toggle]');if(toggle){saved.muted=!saved.muted;persist();if(saved.muted){resetPreview();stopSceneSounds();}else if(lastPage)startSceneSounds(lastPage);syncAudio();return;}
    const call=event.target.closest('[data-animal]');if(call)playCall(call.dataset.animal,call);
  });
  document.addEventListener('error',event=>{const img=event.target;if(img.tagName!=='IMG'||img.dataset.failed)return;img.dataset.failed='yes';const parent=img.closest('.artwork');if(parent){const note=document.createElement('div');note.className='load-error';note.textContent='图片暂时没加载出来';const sub=document.createElement('small');sub.textContent='请检查网络连接。你也可以用下方按钮继续。';note.append(sub);parent.append(note);}},true);
  document.addEventListener('visibilitychange',()=>{if(document.hidden){ambient.pause();resetPreview();stopSceneSounds();lastPage?._stopHold?.();lastPage?._pauseTitle?.();}else{syncAudio();lastPage?._resumeTitle?.();}});
  window.addEventListener('pagehide',()=>{ambient.pause();resetPreview();stopSceneSounds();lastPage?._stopHold?.();lastPage?._pauseTitle?.();});
  window.addEventListener('pageshow',()=>{if(lastPage){syncAudio();lastPage._resumeTitle?.();}});
  new MutationObserver(records=>{
    if(setup())return;
    // Counter updates use reserved space; only expanded story content needs a new fit.
    if(records.some(record=>lastPage?.contains(record.target)&&!record.target.closest?.('[data-task], [data-role-count], [data-journal-total], .card-tabs, .story-whisper, .typewriter-line, .word-slot, .title-scene-caption, .title-listen')))fitPage(lastPage);
  }).observe(document.documentElement,{subtree:true,childList:true});
  window.addEventListener('resize',()=>fitPage(lastPage));
  setup();
})();
