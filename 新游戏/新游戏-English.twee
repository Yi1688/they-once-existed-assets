:: Start {"position": "480,0", "size": "180,100"}
<section data-scene="Start" class="page title-screen" data-sound="themeOpen"><canvas class="title-dust" aria-hidden="true"></canvas><div class="title-light" aria-hidden="true"></div><div class="title-main"><div class="title-copy"><div class="title-heading"><p class="title-overline">AN INTERACTIVE FABLE</p><h1 class="title-wordmark"><span>They Once</span><span>Existed<span class="title-mark" aria-hidden="true">✦</span></span></h1><p class="title-english">THREE LIVES. SIX ENDINGS.</p><h2 class="title-subtitle">A Gift from the Gods</h2><p class="title-invitation">A forest. A cage. A fence.<br>See what happens through their eyes.</p></div><div class="title-controls"><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Begin <span aria-hidden=\"true\">↗</span>", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "Journal", "Journal")</span></div><button type="button" class="title-listen" data-start-listening><span class="title-equalizer" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-title-audio-status>Click to turn on the music</span></button></div></div><div class="title-visual"><div class="title-orbit" aria-hidden="true"><div class="orbit-ring ring-outer"></div><div class="orbit-ring ring-inner"></div><div class="orbit-cross"></div><span class="orbit-star star-north">✦</span><span class="orbit-star star-south">✧</span></div><div class="title-portals"><button type="button" class="title-portal portal-pig" data-animal="pig" data-title-line="“How can it bite right through a tree?”" aria-label="Play the Boar call"><span class="portal-number">I</span><span class="portal-halo" aria-hidden="true"></span><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%87%8E%E7%8C%AA%E9%80%8F%E6%98%8E.png" alt="Boar silhouette" width="240" height="200"><span class="portal-caption"><strong>Boar</strong><small>FOREST</small></span></button><button type="button" class="title-portal portal-cat" data-animal="cat" data-title-line="“Is this really my home now?”" aria-label="Play the Cat call"><span class="portal-number">II</span><span class="portal-halo" aria-hidden="true"></span><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E7%8C%AB%E9%80%8F%E6%98%8E.png" alt="Cat silhouette" width="240" height="200"><span class="portal-caption"><strong>Cat</strong><small>HOME</small></span></button><button type="button" class="title-portal portal-duck" data-animal="duck" data-title-line="“Do the chosen ones really go to heaven?”" aria-label="Play the Duck call"><span class="portal-number">III</span><span class="portal-halo" aria-hidden="true"></span><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%B8%AD%E5%AD%90%E9%80%8F%E6%98%8E.png" alt="Duck silhouette" width="240" height="200"><span class="portal-caption"><strong>Duck</strong><small>ALTAR</small></span></button></div><p class="title-scene-caption" data-title-caption>“Is that really a god?”</p></div></div><footer class="title-footer"><span>Three stories · Six endings</span><span>Click an animal to hear its call</span><span class="title-edition">A GIFT FROM THE GODS / CHAPTER II</span></footer></section>

:: Choose a Character {"position": "720,0", "size": "180,100"}
<section data-scene="Choose a Character" class="page selection" data-sound="themeOpen"><div class="eyebrow">PROLOGUE</div><div class="selection-head"><h1>Through Their Eyes</h1><p>Choose a character and see what happens next.</p></div><img class="selection-art" src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E5%AE%83%E4%BB%AC%E9%80%8F%E6%98%8E.png" alt="Silhouettes of a boar, a cat, and a duck"><div class="role-grid"><article class="role-card"><span class="role-count" data-role-count="pig">0/2</span><button type="button" class="animal-preview" data-animal="pig" aria-label="Play the Boar call"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%87%8E%E7%8C%AA.jpg" alt="Boar silhouette"><span class="sound-hint">Click to hear its call ♫</span></button><div class="role-copy"><div class="role-no">01 / THE FOREST</div><h2>Boar</h2><p>Something huge has come to the forest.<br>You have never seen an animal like it.</p><div class="role-enter">(transition-arrive: "instant")(link-goto: "Begin this story <span>↗</span>", "Boar-Forest")</div></div></article><article class="role-card"><span class="role-count" data-role-count="cat">0/2</span><button type="button" class="animal-preview" data-animal="cat" aria-label="Play the Cat call"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E7%8C%AB.jpg" alt="Cat silhouette"><span class="sound-hint">Click to hear its call ♫</span></button><div class="role-copy"><div class="role-no">02 / THE HOME</div><h2>Cat</h2><p>Someone says they will take you home.<br>You have waited in this cage for so long.</p><div class="role-enter">(transition-arrive: "instant")(link-goto: "Begin this story <span>↗</span>", "Cat-Cage")</div></div></article><article class="role-card"><span class="role-count" data-role-count="duck">0/2</span><button type="button" class="animal-preview" data-animal="duck" aria-label="Play the Duck call"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%B8%AD%E5%AD%90.jpg" alt="Duck silhouette"><span class="sound-hint">Click to hear its call ♫</span></button><div class="role-copy"><div class="role-no">03 / THE ALTAR</div><h2>Duck</h2><p>The ducks fight for grain from a god.<br>They say a full belly leads to heaven.</p><div class="role-enter">(transition-arrive: "instant")(link-goto: "Begin this story <span>↗</span>", "Duck-Pen")</div></div></article></div><footer class="selection-foot"><span>Three stories · Two endings each · Underlined words are interactive</span><span class="series">They Once Existed / A Gift from the Gods</span></footer></section>

:: Boar-Forest {"position": "960,0", "size": "180,100"}
(set: $pigTrail to false)(set: $pigOil to false)<section data-scene="Boar-Forest" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="forest"><div class="chapter"><span class="number">01</span><span>A noise beyond the trees</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="A blue forest seen from a boar&#x27;s point of view" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>What is that noise?</h1><p class="voice">“<span class="cycle-word word-slot" title="Click to change the wording"><span class="word-measure" aria-hidden="true">Never heard that before</span><span class="word-value">(cycling-link: "Not thunder", "Not the wind either", "Never heard that before")</span></span>. Why is the ground shaking?”</p><p class="thought">You stop and turn toward the sound.</p><div class="story-whisper" data-whisper="forestEcho"><span class="whisper-label">Listen a little longer</span><span class="whisper-copy">|forestEcho>[The ground shakes again. Birds scatter from the trees.]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "Listen again ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?forestEcho)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "The ground shakes again. Birds scatter from the trees.", "The noise gets closer. Branches snap beneath it.", "You take two steps toward the clearing and prick up your ears."))]]]</span></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Go to the clearing →", "Boar-Machine")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:8%"></span></div></section>

:: Boar-Machine {"position": "1200,0", "size": "180,100"}
<section data-scene="Boar-Machine" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="machine"><div class="chapter"><span class="number">01</span><span>A noise beyond the trees</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="A dark logging machine appears beyond the trees" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>Something enormous moves slowly across the clearing.<br><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">Something inside keeps roaring. It never stops.</span><span class="word-value">|ironSkin>[There is no fur on its dark, hard shell.]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?ironSkin)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "There is no fur on its dark, hard shell.", "Its shell never rises or falls with a breath.", "Something inside keeps roaring. It never stops."))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">(set: _inkText to "“It’s huge… What does it eat?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“It’s huge… What does it eat?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 30))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 30)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“It’s huge… What does it eat?”</span></span>](click: ?spokenLine)[(set: _inkCount to 30)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Move closer</span><span class=\"choice-detail\">Get a better look at this creature.</span>", "Boar-Approach")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Follow the forest edge</span><span class=\"choice-detail\">See if there is a way around.</span>", "Boar-Path")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:16%"></span></div></section>

:: Boar-Path {"position": "1440,0", "size": "180,100"}
<section data-scene="Boar-Path" class="page scene-stage role-pig " data-sound="pigOpen"><div class="chapter"><span class="number">01</span><span>The path at the edge</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="A path through the forest that the machine has not flattened" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigTrail to true)<p>You skirt the clearing.<br><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">The path is still clear. It leads back into the woods.</span><span class="word-value">(link: "Hoofprints turn onto a path to the north.")[(transition: "dissolve")+(transition-time: .55s)[The path is still clear. It leads back into the woods.]]</span></span></p><p class="voice">(set: _inkText to "“I can still get through here. I’ll remember it for the way back.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“I can still get through here. I’ll remember it for the way back.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 66))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 66)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“I can still get through here. I’ll remember it for the way back.”</span></span>](click: ?spokenLine)[(set: _inkCount to 66)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="memory"><span>You remember</span>A northern path begins beside an old tree.</div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Go back to the huge creature →", "Boar-Approach")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:22%"></span></div></section>

:: Boar-Approach {"position": "0,180", "size": "180,100"}
<section data-scene="Boar-Approach" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="machine"><div class="chapter"><span class="number">02</span><span>The roar inside the shell</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="The wheels and steel body of the logging machine draw closer" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>It touches a tree. The trunk shakes, then snaps.<br>Branches vanish inside. Wood chips rain down.</p><p class="voice">(set: _inkText to "“It bit right through that tree…”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“It bit right through that tree…”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 33))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 33)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“It bit right through that tree…”</span></span>](click: ?spokenLine)[(set: _inkCount to 33)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "A little closer →", "Boar-Lights")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:25%"></span></div></section>

:: Boar-Lights {"position": "240,180", "size": "180,100"}
<section data-scene="Boar-Lights" class="page scene-stage role-pig " data-sound="pigOpen" data-fx="light"><div class="chapter"><span class="number">02</span><span>Blinding lights</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/4%E6%9C%BA%E5%99%A8%E5%8F%91%E5%85%89.jpg" alt="The machine shines bright yellow lights from the forest edge" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>The creature stops. Two beams of (text-style: "shadow")[blinding yellow light] hit your face.<br>The wind carries <span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">the smell of rust and engine oil</span><span class="word-value">(link: "an odd smell")[(transition: "dissolve")+(transition-time: .55s)[the smell of rust and engine oil]]</span></span>. You have never smelled it before.</p><p class="voice">(set: _inkText to "“What are you staring at? This is my forest.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“What are you staring at? This is my forest.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 45))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 45)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“What are you staring at? This is my forest.”</span></span>](click: ?spokenLine)[(set: _inkCount to 45)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Bare your tusks</span><span class=\"choice-detail\">It cannot be allowed any farther.</span>", "Boar-Charge")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Sniff the air first</span><span class=\"choice-detail\">Something about its smell is wrong.</span>", "Boar-Smell")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:34%"></span></div></section>

:: Boar-Smell {"position": "480,180", "size": "180,100"}
<section data-scene="Boar-Smell" class="page scene-stage role-pig " data-sound="pigOpen"><div class="chapter"><span class="number">02</span><span>An unfamiliar smell</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/3%E4%BC%90%E6%9C%A8%E6%9C%BA%E9%9D%A0%E8%BF%91.jpg" alt="Dark gaps between the machine&#x27;s wheels" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $pigOil to true)<p>You sniff again. No fur. No blood.<br><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">Broken branches mingle with the smell of machinery.</span><span class="word-value">(link: "Only rust, engine oil, and sap from torn bark.")[(transition: "dissolve")+(transition-time: .55s)[Broken branches mingle with the smell of machinery.]]</span></span></p><p class="voice">(set: _inkText to "“It keeps roaring. Doesn’t it need to breathe?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“It keeps roaring. Doesn’t it need to breathe?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 47))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 47)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“It keeps roaring. Doesn’t it need to breathe?”</span></span>](click: ?spokenLine)[(set: _inkCount to 47)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="memory"><span>You remember</span>It has no animal scent. Its shell never moves with a breath.</div><div class="story-whisper" data-whisper="ironBreath"><span class="whisper-label">Up close</span><span class="whisper-copy">|ironBreath>[Hot air hits your nose. You sneeze.]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "Listen again ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?ironBreath)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "Hot air hits your nose. You sneeze.", "Something this big, and not a trace of an animal's scent.", "The earth is churned up wherever it passes."))]]]</span></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Try your tusks →", "Boar-Charge")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:40%"></span></div></section>

:: Boar-Charge {"position": "720,180", "size": "180,100"}
<section data-scene="Boar-Charge" class="page scene-stage role-pig " data-sound="pigInteract"><div class="chapter"><span class="number">03</span><span>Charge</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/5%E9%87%8E%E7%8C%AA%E9%9D%A0%E8%BF%91.jpg" alt="A boar raises its tusks toward the glowing machine" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“Get out! Leave these trees alone!”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Get out! Leave these trees alone!”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 35))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 35)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Get out! Leave these trees alone!”</span></span>](click: ?spokenLine)[(set: _inkCount to 35)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p class="thought">You lower your head and drive your tusks into its shell.</p></div><div class="interaction" data-task="ram" data-goal="5"><p class="instructions">Strike five times. Try to drive it out of the forest.</p><button type="button" class="action-button" data-task-action>Ram the machine</button><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">Tusk strikes · 0 / 5</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "Look up →", "Boar-God")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:45%"></span></div></section>

:: Boar-God {"position": "960,180", "size": "180,100"}
<section data-scene="Boar-God" class="page scene-stage role-pig " data-sound="pigWorship" data-fx="revelation"><div class="chapter"><span class="number">04</span><span>The god you recognize</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/6%E6%9C%BA%E5%99%A8%E5%8F%98%E9%87%8E%E7%8C%AA.jpg" alt="In the eyes of the boar, the machine becomes a god with enormous tusks" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>On the fifth strike, your tusks ring with pain. You look up.<br><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">You have mistaken the machine's steel arms for tusks.</span><span class="word-value">|godShape>[Behind the lights are tusks just like yours.]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?godShape)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "Behind the lights are tusks just like yours.", "Those tusks are taller than you.", "You have mistaken the machine's steel arms for tusks."))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">“So it’s (text-style: "outline")[the boar god]… No wonder I couldn’t move it.”</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Gaze up at it →", "Boar-Mist")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:57%"></span></div></section>

:: Boar-Mist {"position": "1200,180", "size": "180,100"}
<section data-scene="Boar-Mist" class="page scene-stage role-pig " data-sound="pigWorship" data-fx="steam"><div class="chapter"><span class="number">04</span><span>The great god breathes</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/7%E9%87%8E%E7%8C%AA%E5%96%B7%E6%B0%94.jpg" alt="The mechanical god vents white mist above the small blue boar" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "White mist bursts from the great god.\nYou duck, then find yourself looking up again.")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">White mist bursts from the great god.<br>You duck, then find yourself looking up again.</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 84))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 84)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">White mist bursts from the great god.<br>You duck, then find yourself looking up again.</span></span>](click: ?spokenLine)[(set: _inkCount to 84)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="story-whisper" data-whisper="godReply"><span class="whisper-label">Through the mist</span><span class="whisper-copy">|godReply>[White mist from the great god drifts over your head.]</span>(set: _echo to 1)(live: 1.2s)[(set: _echo to _echo + 1)(replace: ?godReply)[(transition: "dissolve")+(transition-time: .6s)[(print: (nth: _echo, "White mist from the great god drifts over your head.", "You stand still, waiting for it to do something else.", "The mist clears. The great god lurches forward again."))]](if: _echo >= 3)[(stop:)]]</div></div><div class="interaction" data-task="hold" data-goal="1"><p class="instructions">Hold for about two seconds to watch the great god vent.</p><button type="button" class="hold-button" data-task-action>Hold · Watch the great god vent</button><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">Hold the button to watch the mist from the great god.</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "Wait for the mist to clear →", "Boar-Choice")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:70%"></span></div></section>

:: Boar-Choice {"position": "1440,180", "size": "180,100"}
<section data-scene="Boar-Choice" class="page scene-stage role-pig " data-sound="pigWorship"><div class="chapter"><span class="number">05</span><span>Leave or stay</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/%E9%87%8E%E7%8C%AA%E8%AF%B4%E8%AF%9D.jpg" alt="A boar stands before the silent steel god" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>Will you stay here?</h1><p class="voice">(set: _inkText to "“It’s so powerful. Surely I won’t go hungry if I follow it?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“It’s so powerful. Surely I won’t go hungry if I follow it?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 60))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 60)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“It’s so powerful. Surely I won’t go hungry if I follow it?”</span></span>](click: ?spokenLine)[(set: _inkCount to 60)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>Another tree falls behind you. You look back at the woods.</p>(if: $pigOil)[<div class="memory"><span>You remember</span>But it never breathes. You still cannot explain that.</div>](if: $pigTrail)[<div class="memory"><span>You remember</span>The northern path is still there, beside the old tree.</div>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Leave · Return to the forest</span><span class=\"choice-detail\">Find the stream and fruit you know.</span>", "Boar-Leave")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Stay · Follow the great god</span><span class=\"choice-detail\">A god this powerful will look after you. Surely.</span>", "Boar-Stay")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:84%"></span></div></section>

:: Boar-Leave {"position": "0,360", "size": "180,100"}
<section data-scene="Boar-Leave" class="page scene-stage role-pig ending" data-sound="themeEnd" data-ending="pig-live"><div class="chapter"><span class="number">06</span><span>Ending A · Leave</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/1%E5%9C%A8%E6%A3%AE%E6%9E%97.jpg" alt="The boar turns back into the deep blue forest" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 01 / LEAVE</div><h1>Back to the Woods</h1><p>You take one last look at the great god, then slip into the trees.<br>Even far away, you can still hear its roar.</p>(if: $pigTrail)[<p>You follow the northern path around the clearing and stop by the stream.</p>](else:)[<p>You follow familiar scents until you find the stream.</p>]<p><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">The fruit tree you remember is still there</span><span class="word-value">(link: "There is still fruit by the stream")[(transition: "dissolve")+(transition-time: .55s)[The fruit tree you remember is still there]]</span></span>. You drink and eat until the hunger eases.</p><p class="closing">(set: _inkText to "You can sleep here tonight.")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">You can sleep here tonight.</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 27))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 27)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">You can sleep here tonight.</span></span>](click: ?spokenLine)[(set: _inkCount to 27)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Play again ↻", "Boar-Forest")</span><span>(transition-arrive: "instant")(link-goto: "Choose another ↗", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "View the journal", "Journal")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: Boar-Stay {"position": "240,360", "size": "180,100"}
<section data-scene="Boar-Stay" class="page scene-stage role-pig ending ending-pig-fall" data-sound="themeEnd" data-ending="pig-fall"><div class="chapter"><span class="number">06</span><span>Ending B · Stay</span><span class="track"></span><small>BOAR / FOREST</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E6%96%B0/2%E7%9C%8B%E8%A7%81%E4%BC%90%E6%9C%A8%E6%9C%BA.jpg" alt="The forest loses its color while the logging machine keeps working" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 02 / STAY</div><h1>It Never Looked Back</h1><p><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">You follow the great god, taking its chips and stumps for gifts.</span><span class="word-value">|falseGift>[You follow the great god, taking its chips and stumps for gifts.]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?falseGift)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "You follow the great god, taking its chips and stumps for gifts.", "Wood chips and stumps are all the great god leaves behind.", "You try a bite. Your mouth fills with splinters."))]](if: _wordStep >= 3)[(stop:)]]<br>You cannot eat them. You keep waiting.</p><p>Days later, the machine leaves. The shade is gone. Mud blocks the stream.<br>Too hungry to stand, you stare after it.</p><p class="closing">(set: _inkText to "It never comes back.")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">It never comes back.</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 20))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 20)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">It never comes back.</span></span>](click: ?spokenLine)[(set: _inkCount to 20)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Play again ↻", "Boar-Forest")</span><span>(transition-arrive: "instant")(link-goto: "Choose another ↗", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "View the journal", "Journal")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: Cat-Cage {"position": "480,360", "size": "180,100"}
(set: $catTag to false)<section data-scene="Cat-Cage" class="page scene-stage role-cat " data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>Days in a cage</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="Gray cats crowded behind cold iron bars" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>Will someone come today?</h1><p>The iron bars are cold.<br><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">You are wedged in the middle, barely able to turn.</span><span class="word-value">|cageNames>[Several gray cats are packed together.]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?cageNames)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "Several gray cats are packed together.", "You are wedged in the middle, barely able to turn.", "Whenever the door opens, every cat looks up."))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">(set: _inkText to "“Is it warmer outside?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Is it warmer outside?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 23))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 23)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Is it warmer outside?”</span></span>](click: ?spokenLine)[(set: _inkCount to 23)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="story-whisper" data-whisper="cageEcho"><span class="whisper-label">At the door</span><span class="whisper-copy">|cageEcho>[Footsteps sound at the end of the aisle.]</span>(after: 1.6s)[(replace: ?cageEcho)[(transition: "dissolve")+(transition-time: .8s)[Keys jangle. You lift your head at once.]]]</div><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Look toward the door</span><span class=\"choice-detail\">Someone is coming this way.</span>", "Cat-Visitor")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Peer through the bars</span><span class=\"choice-detail\">Try to see what lies outside the cage.</span>", "Cat-Aisle")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:8%"></span></div></section>

:: Cat-Aisle {"position": "720,360", "size": "180,100"}
<section data-scene="Cat-Aisle" class="page scene-stage role-cat " data-sound="catOpen"><div class="chapter"><span class="number">01</span><span>Beyond the bars</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="A cat looks out at the aisle through iron bars" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>You press close. <span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">Every cat in every cage is watching the door.</span><span class="word-value">(link: "Rows of identical cages line the aisle.")[(transition: "dissolve")+(transition-time: .55s)[Every cat in every cage is watching the door.]]</span></span><br>The windows are high. Only the top cages catch the sun.</p><p class="voice">(set: _inkText to "“If I grew a little taller, could I reach the sunshine?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“If I grew a little taller, could I reach the sunshine?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 56))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 56)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“If I grew a little taller, could I reach the sunshine?”</span></span>](click: ?spokenLine)[(set: _inkCount to 56)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Someone is at the door →", "Cat-Visitor")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:14%"></span></div></section>

:: Cat-Visitor {"position": "960,360", "size": "180,100"}
<section data-scene="Cat-Visitor" class="page scene-stage role-cat " data-sound="catOpen" data-fx="warmth"><div class="chapter"><span class="number">02</span><span>Someone wants to take you home</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="A warm room with a sofa, a floor lamp, and a cat bed, imagined by the cat" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“What a sweet cat. Come home with me. Your bed’s all ready.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“What a sweet cat. Come home with me. Your bed’s all ready.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 60))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 60)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“What a sweet cat. Come home with me. Your bed’s all ready.”</span></span>](click: ?spokenLine)[(set: _inkCount to 60)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>You do not understand every word, but the voice is gentle.<br>You squeeze forward and press your cheek to the bars.</p><div class="story-whisper" data-whisper="homePromise"><span class="whisper-label">A home you have never seen</span><span class="whisper-copy">|homePromise>[Is a sofa somewhere you can stretch out and sleep?]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "Listen again ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?homePromise)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "Is a sofa somewhere you can stretch out and sleep?", "It must be warm in there with the lamp on.", "If the bed is soft, I'd like to sleep until tomorrow."))]]]</span></div><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Nuzzle the hand</span><span class=\"choice-detail\">It has been so long since anyone stroked you.</span>", "Cat-Food")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Look at the cage label</span><span class=\"choice-detail\">Someone beside you is changing the paper.</span>", "Cat-Label")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:18%"></span></div></section>

:: Cat-Label {"position": "1200,360", "size": "180,100"}
<section data-scene="Cat-Label" class="page scene-stage role-cat " data-sound="catOpen"><div class="chapter"><span class="number">02</span><span>A fresh label</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/1.jpg" alt="Iron bars separate a cat from the people outside" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $catTag to true)<p>The old label is torn off. The new one reads “|health>[Healthy and lively].”<br>The old paper is crumpled and tossed into a box.</p><p class="voice">(set: _inkText to "“Nothing wrong with this one. Such a good appetite.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Nothing wrong with this one. Such a good appetite.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 52))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 52)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Nothing wrong with this one. Such a good appetite.”</span></span>](click: ?spokenLine)[(set: _inkCount to 52)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="memory"><span>You remember</span>You could not eat last night. Today, they call you healthy.</div>(after: .9s)[(enchant: ?health, (text-style: "strike")+(text-colour: "#777777"))]<div class="actions"><span>(transition-arrive: "instant")(link-goto: "A bowl slides into the cage →", "Cat-Food")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:24%"></span></div></section>

:: Cat-Food {"position": "1440,360", "size": "180,100"}
<section data-scene="Cat-Food" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>Dinner arrives</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/3.jpg" alt="A pale purple food bowl against a white background" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">“Food at last. But it smells <span class="cycle-word word-slot" title="Click to change the wording"><span class="word-measure" aria-hidden="true">as if something's been mixed in</span><span class="word-value">(cycling-link: "a little strange", "a little bitter", "as if something's been mixed in")</span></span>.”</p><p class="thought">Your stomach growls. You have been hungry for so long.</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Have a little</span><span class=\"choice-detail\">Fill your stomach first.</span>", "Cat-Chew")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Sniff it closely</span><span class=\"choice-detail\">There is something bitter in the food.</span>", "Cat-Pills")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:28%"></span></div></section>

:: Cat-Pills {"position": "0,540", "size": "180,100"}
<section data-scene="Cat-Pills" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>Something in the food</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="Capsules in the bowl stand out from the food around them" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>You paw the food aside and find <span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">pills mixed into the food</span><span class="word-value">(link: "a few hard pieces")[(transition: "dissolve")+(transition-time: .55s)[pills mixed into the food]]</span></span>.<br>Up close, the bitter smell is stronger.</p><p class="voice">(set: _inkText to "“Am I meant to eat these?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Am I meant to eat these?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 26))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 26)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Am I meant to eat these?”</span></span>](click: ?spokenLine)[(set: _inkCount to 26)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Eat a little anyway</span><span class=\"choice-detail\">You are far too hungry.</span>", "Cat-Chew")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Push the bowl away</span><span class=\"choice-detail\">You do not like the smell.</span>", "Cat-Bowl")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:33%"></span></div></section>

:: Cat-Bowl {"position": "240,540", "size": "180,100"}
<section data-scene="Cat-Bowl" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>Pushing it away</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="A cat pushes a bowl of food and pills toward the cage door" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>You push the bowl to the door. <span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">The sound carries down the aisle. Nobody stops.</span><span class="word-value">(link: "The bowl hits the bars with a clink.")[(transition: "dissolve")+(transition-time: .55s)[The sound carries down the aisle. Nobody stops.]]</span></span><br>The person outside glances down and pushes it back.</p><p class="voice">(set: _inkText to "“Go on, eat. Then we’ll take you home.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Go on, eat. Then we’ll take you home.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 39))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 39)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Go on, eat. Then we’ll take you home.”</span></span>](click: ?spokenLine)[(set: _inkCount to 39)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Lower your head and eat</span><span class=\"choice-detail\">You keep thinking about the bed they promised.</span>", "Cat-Chew")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:37%"></span></div></section>

:: Cat-Chew {"position": "480,540", "size": "180,100"}
<section data-scene="Cat-Chew" class="page scene-stage role-cat " data-sound="catInteract"><div class="chapter"><span class="number">03</span><span>Bitter</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/4.jpg" alt="A capsule marked Stimulant lies among the food" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“Just one bite.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Just one bite.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 16))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 16)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Just one bite.”</span></span>](click: ?spokenLine)[(set: _inkCount to 16)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="interaction" data-task="chew" data-goal="1"><p class="instructions">Something hard in the food catches against your teeth.</p><button type="button" class="action-button" data-task-action>Try to chew</button><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">Bite down, then swallow.</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "Swallow →", "Cat-Color")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:38%"></span></div></section>

:: Cat-Color {"position": "720,540", "size": "180,100"}
<section data-scene="Cat-Color" class="page scene-stage role-cat is-colour-scene" data-sound="catDream" data-fx="colour"><div class="chapter"><span class="number">04</span><span>A cage full of color</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/5.jpg" alt="The gray cage becomes patches of soft pink, blue, and green" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">“Oh, (text-colour: "#666666")[(text-style: "shadow")[the world has turned to color]].”</p><p class="thought"><span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">You can barely keep your balance</span><span class="word-value">|sweetBars>[The bars turn pink]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?sweetBars)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "The bars turn pink", "The floor starts swaying", "You can barely keep your balance"))]](if: _wordStep >= 3)[(stop:)]]. Your body feels light.<br>You try to stand and almost bump into the cage door.</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Someone lifts you up →", "Cat-Home")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:48%"></span></div></section>

:: Cat-Home {"position": "960,540", "size": "180,100"}
<section data-scene="Cat-Home" class="page scene-stage role-cat " data-sound="catDream" data-fx="warmth"><div class="chapter"><span class="number">05</span><span>Home at last</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="A softly lit room with a rug, plants, a sofa, and a picture of a cat" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>Is this home?</h1><p class="voice">(set: _inkText to "“The sofa’s so soft. Can I really sleep here?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“The sofa’s so soft. Can I really sleep here?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 46))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 46)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“The sofa’s so soft. Can I really sleep here?”</span></span>](click: ?spokenLine)[(set: _inkCount to 46)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p class="thought">(link: "Try the sofa")[You knead twice. Your paws sink into the cushions.] · (link: "Look at the picture")[There is a cat in it too. You watch it for a while.]</p>(if: $catTag)[<div class="memory"><span>You remember</span>The label said “Healthy and lively.” Now you can barely lift your tail.</div>]<p class="thought">Before long, (text-style: "blur")[your head grows heavier], and your whole body feels too hot.</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Lie down and rest</span><span class=\"choice-detail\">Maybe the journey has just worn you out.</span>", "Cat-Priest")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Go to the window</span><span class=\"choice-detail\">It looks cooler over there.</span>", "Cat-Window")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:61%"></span></div></section>

:: Cat-Window {"position": "1200,540", "size": "180,100"}
<section data-scene="Cat-Window" class="page scene-stage role-cat " data-sound="catDream"><div class="chapter"><span class="number">05</span><span>The jump you cannot make</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="Hazy light falls through the window of a warm room" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>You try to jump onto the sill. Your back legs buckle.<br>You fall to the rug. Your person scoops you up.</p><p class="voice"><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">“They said you were healthy…”</span><span class="word-value">(link: "“They said you were healthy…”")[(transition: "dissolve")+(transition-time: .55s)[“We need a vet. Right now.”]]</span></span></p><p class="thought">A palm rests on your forehead. Someone starts looking for a phone.</p><p class="thought macro-line">(seq-link: "Your carrier is still by the door.", "The paper marked ‘Healthy’ lies beside it.", "They photograph the label and pick up the phone.")</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "The room blurs →", "Cat-Priest")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:70%"></span></div></section>

:: Cat-Priest {"position": "1440,540", "size": "180,100"}
<section data-scene="Cat-Priest" class="page scene-stage role-cat " data-sound="catPriest"><div class="chapter"><span class="number">06</span><span>Half asleep</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.6"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/7%E7%A5%AD%E5%8F%B8%E8%AF%B4%E8%AF%9D%E7%8C%AB.jpg" alt="A cat priest wearing bone ornaments and carrying a cross stands before you" width="2560" height="1600" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>You lie dazed and heavy. A tall shadow appears before you.</p><p class="voice">“Come with me. Over there, (text-style: "fade-in-out")[it won’t hurt anymore].”</p><p class="thought">There is a door behind the shadow. But someone beside you keeps calling:<br>“Wake up. We’re at the vet now.”</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Go back · Follow the voices</span><span class=\"choice-detail\">You still want to go home.</span>", "Cat-Wake")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Let go · I’m too tired</span><span class=\"choice-detail\">The voices beside you are fading.</span>", "Cat-Farewell")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:78%"></span></div></section>

:: Cat-Wake {"position": "0,720", "size": "180,100"}
<section data-scene="Cat-Wake" class="page scene-stage role-cat " data-sound="catDream" data-fx="warmth"><div class="chapter"><span class="number">07</span><span>Choice A · Go back</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/2.jpg" alt="Warm yellow light reveals the shape of the room" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>You move a paw</h1><p class="voice">(set: _inkText to "“A movement! Doctor, did you see that?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“A movement! Doctor, did you see that?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 39))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 39)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“A movement! Doctor, did you see that?”</span></span>](click: ?spokenLine)[(set: _inkCount to 39)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>You struggle to open your eyes. The air smells of disinfectant.<br>Your person is still there, still wearing their coat.</p><p class="thought">You spend the next few days at the hospital, getting treatment.</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "A few days later →", "Cat-Recover")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:90%"></span></div></section>

:: Cat-Farewell {"position": "240,720", "size": "180,100"}
<section data-scene="Cat-Farewell" class="page scene-stage role-cat ending ending-cat-dark" data-sound="catEnd" data-fx="farewell"><div class="chapter"><span class="number">07</span><span>Choice B · Let go</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.6" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/7%E7%A5%AD%E5%8F%B8%E8%AF%B4%E8%AF%9D%E7%8C%AB.jpg" alt="The cat closes its eyes as the priest fades into the dark" width="2560" height="1600" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“I want to sleep a little longer.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“I want to sleep a little longer.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 34))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 34)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“I want to sleep a little longer.”</span></span>](click: ?spokenLine)[(set: _inkCount to 34)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>You walk toward the shadow. It slowly opens the door.<br>Your person calls again. You no longer hear them.</p><p class="thought">The vet keeps trying. The monitor beeps more slowly.</p><div class="story-whisper" data-whisper="lastVoice"><span class="whisper-label">By the bed</span><span class="whisper-copy">|lastVoice>[Someone is still holding your front paw.]</span>(set: _echo to 1)(live: 1.2s)[(set: _echo to _echo + 1)(replace: ?lastVoice)[(transition: "dissolve")+(transition-time: .6s)[(print: (nth: _echo, "Someone is still holding your front paw.", "You want to nuzzle their hand. You have no strength left.", "“I’m here. Don’t be scared.”"))]](if: _echo >= 3)[(stop:)]]</div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Afterward →", "Cat-Depart")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:90%"></span></div></section>

:: Cat-Recover {"position": "480,720", "size": "180,100"}
<section data-scene="Cat-Recover" class="page scene-stage role-cat ending" data-sound="themeEnd" data-ending="cat-light"><div class="chapter"><span class="number">08</span><span>Ending A · Go back</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/6.jpg" alt="After treatment, the cat returns to its home with a sofa and a bed" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 03 / GO BACK</div><h1>Your Bed Is Still There</h1><p>Once you are stable, your person comes to take you home.<br><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">At home, you walk out of the carrier and climb slowly onto the sofa.</span><span class="word-value">(link: "At home, you walk out of the carrier and climb slowly onto the sofa.")[(transition: "dissolve")+(transition-time: .55s)[You climb onto the sofa. This time, your back legs don't give way.]]</span></span></p><p>The food bowl has moved. Fresh water sits beside it.<br>You eat a little and curl up in the bed by the window.</p><p class="ending-note">Later in the story: they keep the vet records and receipt, and report the seller.</p><p class="closing">(set: _inkText to "This time, you can sleep soundly.")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">This time, you can sleep soundly.</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 33))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 33)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">This time, you can sleep soundly.</span></span>](click: ?spokenLine)[(set: _inkCount to 33)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Play again ↻", "Cat-Cage")</span><span>(transition-arrive: "instant")(link-goto: "Choose another ↗", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "View the journal", "Journal")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: Cat-Depart {"position": "720,720", "size": "180,100"}
<section data-scene="Cat-Depart" class="page scene-stage role-cat ending" data-sound="themeEnd" data-ending="cat-sleep"><div class="chapter"><span class="number">08</span><span>Ending B · Let go</span><span class="track"></span><small>CAT / HOME</small></div><figure class="artwork" style="--image-ratio:1.6"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%8C%AB/8.jpg" alt="A news screen within the story shows an investigation into a cat-selling scam" width="2560" height="1600" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 04 / LET GO</div><h1>Not Long Enough at Home</h1><p>The vet cannot save you. You spent less than a day in your new home.<br><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">When your person comes home, the bed by the window is empty.</span><span class="word-value">(link: "When your person comes home, the bed by the window is empty.")[(transition: "dissolve")+(transition-time: .55s)[They leave your bed where it was, by the window.]]</span></span></p><p class="ending-note">Later in the story: they report the seller, keeping the vet records as evidence.<br>An investigation begins into the drugs used to sell sick cats as healthy ones.</p><p class="closing">(set: _inkText to "A few of your hairs still cling to the sofa.")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">A few of your hairs still cling to the sofa.</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 44))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 44)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">A few of your hairs still cling to the sofa.</span></span>](click: ?spokenLine)[(set: _inkCount to 44)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Play again ↻", "Cat-Cage")</span><span>(transition-arrive: "instant")(link-goto: "Choose another ↗", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "View the journal", "Journal")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: Duck-Pen {"position": "960,720", "size": "180,100"}
(set: $duckHelp to false)(set: $duckShare to false)<section data-scene="Duck-Pen" class="page scene-stage role-duck " data-sound="duckOpen" data-fx="halo"><div class="chapter"><span class="number">01</span><span>Inside the fence</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD1.jpg" alt="A duck with a halo stands in a vividly colored muddy pen" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>Is this all there is?</h1><p>You have lived in this mud all your life. The fence is high. The water is dirty.<br>Every duck has (text-style: "outline")[a ring of light] above its head.</p><p class="voice">“<span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">Once you're full, you can leave the mud</span><span class="word-value">(link: "It’s a gift from God")[(transition: "dissolve")+(transition-time: .55s)[Once you're full, you can leave the mud]]</span></span>.” That’s what everyone says.</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "The crowd suddenly surges →", "Duck-Crowd")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:10%"></span></div></section>

:: Duck-Crowd {"position": "1200,720", "size": "180,100"}
<section data-scene="Duck-Crowd" class="page scene-stage role-duck " data-sound="duckOpen"><div class="chapter"><span class="number">02</span><span>Feeding time</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="A crowd of colorful ducks pushes forward" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">(set: _inkText to "“Why is everyone pushing? What’s happening?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Why is everyone pushing? What’s happening?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 44))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 44)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Why is everyone pushing? What’s happening?”</span></span>](click: ?spokenLine)[(set: _inkCount to 44)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>“God’s here! More food today!”</p><div class="story-whisper" data-whisper="crowdEcho"><span class="whisper-label">Behind you</span><span class="whisper-copy">|crowdEcho>[“Move up! There’s nothing left back here.”]</span><span class="whisper-action">(set: _echo to 1)(link-rerun: "Listen again ↻")[(set: _echo to _echo + 1)(if: _echo > 3)[(set: _echo to 1)](replace: ?crowdEcho)[(transition: "dissolve")+(transition-time: .4s)[(print: (nth: _echo, "“Move up! There’s nothing left back here.”", "A foot lands on your tail feathers. You hurry aside.", "The crowd surges again. Nobody will step back."))]]]</span></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Follow the crowd →", "Duck-Heaven")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:23%"></span></div></section>

:: Duck-Heaven {"position": "1440,720", "size": "180,100"}
<section data-scene="Duck-Heaven" class="page scene-stage role-duck " data-sound="duckWorship" data-fx="halo"><div class="chapter"><span class="number">02</span><span>The heaven they talk about</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="Ducks gather around a towering human figure as if worshipping a god" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p class="voice">“Eat up. Only the strong get <span class="cycle-word word-slot" title="Click to change the wording"><span class="word-measure" aria-hidden="true">taken away</span><span class="word-value">(cycling-link: "chosen", "weighed", "taken away")</span></span>.”</p><p class="thought">They say the chosen ducks leave for a heaven without mud.<br>Not one of them has ever come back.</p><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Push forward for food</span><span class=\"choice-detail\">Wait any longer and there will be none left.</span>", "Duck-Scramble")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Help the fallen duck first</span><span class=\"choice-detail\">It is down, one wing stuck in the mud.</span>", "Duck-Help")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:36%"></span></div></section>

:: Duck-Help {"position": "0,900", "size": "180,100"}
<section data-scene="Duck-Help" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">02</span><span>A trapped wing</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="One duck has fallen behind the pushing crowd" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckHelp to true)<p><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">You hold the others back until the duck pulls its wing free.</span><span class="word-value">(link: "You brace against the crowd and make a little room.")[(transition: "dissolve")+(transition-time: .55s)[You hold the others back until the duck pulls its wing free.]]</span></span><br>The duck pulls its wing free and struggles to its feet.</p><p class="voice">(set: _inkText to "“Thanks. Hurry, the food’s almost gone.”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Thanks. Hurry, the food’s almost gone.”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 40))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 40)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Thanks. Hurry, the food’s almost gone.”</span></span>](click: ?spokenLine)[(set: _inkCount to 40)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Turn back toward the food →", "Duck-Scramble")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:43%"></span></div></section>

:: Duck-Scramble {"position": "240,900", "size": "180,100"}
<section data-scene="Duck-Scramble" class="page scene-stage role-duck task-duck" data-sound="duckInteract"><div class="chapter"><span class="number">03</span><span>Pushing through</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.751965"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/4.jpg" alt="Ducks compete for the grain scattered by their god" width="4457" height="2544" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>No food unless you fight</h1><p class="voice">(set: _inkText to "You spread your wings and push. Something tugs at your feathers.\nYou step on something soft. There is so little grain. Nobody gives way.")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">You spread your wings and push. Something tugs at your feathers.<br>You step on something soft. There is so little grain. Nobody gives way.</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 136))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 136)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">You spread your wings and push. Something tugs at your feathers.<br>You step on something soft. There is so little grain. Nobody gives way.</span></span>](click: ?spokenLine)[(set: _inkCount to 136)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="interaction" data-task="duel" data-goal="6"><p class="instructions">Click the two ducks in turn to push through for food.</p><div class="duel"><button type="button" class="duel-target" data-task-action data-duck-target="0" aria-label="Push past the left duck"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/4.jpg" alt="A pink duck with wings spread"><span class="target-label" data-target-life>3 pushes left</span></button><button type="button" class="duel-target" data-task-action data-duck-target="1" aria-label="Push past the right duck"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/4%201.jpg" alt="A purple duck with wings spread"><span class="target-label" data-target-life>3 pushes left</span></button></div><div class="duel-status"><span>Grains <strong data-grains>0</strong> / 6</span><span>Make your way forward</span></div><div class="task-track" aria-hidden="true"><span></span></div><p class="task-status" data-task-status role="status" aria-live="polite">If the left side is blocked, try the right.</p><div class="actions is-locked" data-task-next>(transition-arrive: "instant")(link-goto: "See what you got →", "Duck-Grain")</div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:50%"></span></div></section>

:: Duck-Grain {"position": "480,900", "size": "180,100"}
<section data-scene="Duck-Grain" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>Your handful of grain</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="The ducks settle after the scramble for food" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>Is this really all?</h1><p><span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">You guard your food and count it. Just six grains.</span><span class="word-value">(link: "You guard your food and count it. Just six grains.")[(transition: "dissolve")+(transition-time: .55s)[All that shoving, and you only got six grains.]]</span></span></p>(if: $duckHelp)[<p class="thought">The duck you helped stands beside you, empty-beaked and trembling.</p>](else:)[<p class="thought">A duck beside you pecks at the mud, looking for stray grains.</p>]<div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Eat it all</span><span class=\"choice-detail\">You have been hungry all day too.</span>", "Duck-Eat")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Share half</span><span class=\"choice-detail\">Let the duck beside you have some.</span>", "Duck-Share")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:58%"></span></div></section>

:: Duck-Eat {"position": "720,900", "size": "180,100"}
<section data-scene="Duck-Eat" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>Your turn</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD3.jpg" alt="A duck looks up at the person who scattered the grain" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><p>You gulp down the food. <span class="changing-word word-slot"><span class="word-measure" aria-hidden="true">The person who scattered the grain crouches down.</span><span class="word-value">|choosingHand>[The hand reaches toward you.]</span></span>(set: _wordStep to 1)(live: 2.4s)[(set: _wordStep to _wordStep + 1)(replace: ?choosingHand)[(transition: "dissolve")+(transition-time: .65s)[(print: (nth: _wordStep, "The hand reaches toward you.", "The person who scattered the grain crouches down.", "They glance at you, then reach for your wings."))]](if: _wordStep >= 3)[(stop:)]]</p><p class="voice">(set: _inkText to "“Me? Is it really my turn?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Me? Is it really my turn?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 27))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 27)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Me? Is it really my turn?”</span></span>](click: ?spokenLine)[(set: _inkCount to 27)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p class="thought">It grips your wings and lifts you off the ground.</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Onto the scale →", "Duck-Scale")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:63%"></span></div></section>

:: Duck-Share {"position": "960,900", "size": "180,100"}
<section data-scene="Duck-Share" class="page scene-stage role-duck " data-sound="duckWorship"><div class="chapter"><span class="number">03</span><span>Three grains</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD2.jpg" alt="Ducks huddle together in the mud" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy">(set: $duckShare to true)<p>You push three grains toward the other duck. <span class="reveal-word word-slot" title="Click to look closer"><span class="word-measure" aria-hidden="true">It eats them in seconds</span><span class="word-value">(link: "It eats them in seconds")[(transition: "dissolve")+(transition-time: .55s)[It hasn't eaten all day]]</span></span>.</p><p class="voice">(set: _inkText to "“Any more?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Any more?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 11))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 11)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Any more?”</span></span>](click: ?spokenLine)[(set: _inkCount to 11)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>You look down at your three remaining grains.<br>Before you can eat, a hand closes around your wings.</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Onto the scale →", "Duck-Scale")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:63%"></span></div></section>

:: Duck-Scale {"position": "1200,900", "size": "180,100"}
<section data-scene="Duck-Scale" class="page scene-stage role-duck " data-sound="duckScales" data-fx="scales"><div class="chapter"><span class="number">04</span><span>Weighing</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049" data-advance="yes"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD5.jpg" alt="A sacred scale holds a blue duck on one side and a heavy red offering on the other" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>They are weighing you</h1><p class="voice">(set: _inkText to "“What are they checking? Am I faithful enough?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“What are they checking? Am I faithful enough?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 47))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 47)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“What are they checking? Am I faithful enough?”</span></span>](click: ?spokenLine)[(set: _inkCount to 47)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p><p>The scale rocks. The person watches the dial, interested only in <span class="cycle-word word-slot" title="Click to change the wording"><span class="word-measure" aria-hidden="true">how much meat you carry</span><span class="word-value">(cycling-link: "your weight", "your selling price", "how much meat you carry")</span></span>.</p>(if: $duckShare)[<p class="thought">Sharing those three grains barely seems to change the needle.</p>](else:)[<p class="thought">The grain you fought for makes you heavier. It may get you taken away sooner.</p>]<div class="story-whisper" data-whisper="scaleReply"><span class="whisper-label">On the scale</span><span class="whisper-copy">|scaleReply>[You shift your feet. The needle wobbles.]</span>(set: _echo to 1)(live: 1.2s)[(set: _echo to _echo + 1)(replace: ?scaleReply)[(transition: "dissolve")+(transition-time: .6s)[(print: (nth: _echo, "You shift your feet. The needle wobbles.", "A hand holds you still. Someone checks the dial again.", "“This one’s about right.”"))]](if: _echo >= 3)[(stop:)]]</div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Lift your head →", "Duck-Priest")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:72%"></span></div></section>

:: Duck-Priest {"position": "1440,900", "size": "180,100"}
<section data-scene="Duck-Priest" class="page scene-stage role-duck " data-sound="duckEnd" data-fx="altar"><div class="chapter"><span class="number">05</span><span>The priest turns</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="The duck priest looks beyond the screen toward the player" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><h1>It is asking you</h1><p class="voice">“Human, do you think you are (text-style: "shadow")[the Creator]?”</p><div class="story-whisper" data-whisper="outsideScreen"><span class="whisper-label">It looks at you</span><span class="whisper-copy">|outsideScreen>[The priest turns toward the person beyond the screen.]</span>(after: 1.6s)[(replace: ?outsideScreen)[(transition: "dissolve")+(transition-time: .8s)[It waits. You have to choose an answer.]]]</div><div class="actions story-choices"><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">Yes</span><span class=\"choice-detail\">Humans decide how other animals live.</span>", "Duck-Yes")</span><span class="decision-option">(transition-arrive: "instant")(link-goto: "<span class=\"choice-title\">No</span><span class=\"choice-detail\">Humans are animals too, part of nature.</span>", "Duck-No")</span></div></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:83%"></span></div></section>

:: Duck-Yes {"position": "0,1080", "size": "180,100"}
<section data-scene="Duck-Yes" class="page scene-stage role-duck ending data-ending" data-sound="themeEnd" data-ending="duck-yes"><div class="chapter"><span class="number">06</span><span>Ending A · Yes</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="The duck priest silently watches the human beyond the screen" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 05 / YES</div><h1>You Have a Say. Now What?</h1><p class="voice">(set: _inkText to "“Then what will you do when these things happen?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“Then what will you do when these things happen?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 49))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 49)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“Then what will you do when these things happen?”</span></span>](click: ?spokenLine)[(set: _inkCount to 49)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="facts"><article class="fact"><strong>$44 trillion</strong><h2>in economic value depends on nature</h2><p>In 2020, the World Economic Forum estimated that over half of global GDP was moderately or highly dependent on nature and its services.</p><a href="https://www.weforum.org/publications/nature-risk-rising-why-the-crisis-engulfing-nature-matters-for-business-and-the-economy/" target="_blank" rel="noopener noreferrer">WEF · Nature Risk Rising · 2020 ↗</a></article><article class="fact"><strong>73%</strong><h2>average decline in monitored wildlife populations</h2><p>WWF’s Living Planet Report 2024 records a 73% average decline in monitored vertebrate population sizes between 1970 and 2020.</p><a href="https://livingplanet.panda.org/" target="_blank" rel="noopener noreferrer">WWF · Living Planet Report · 2024 ↗</a></article><article class="fact"><strong>~1 million</strong><h2>animal and plant species face extinction</h2><p>The 2019 IPBES Global Assessment estimated that around one million animal and plant species face extinction, many within decades.</p><a href="https://www.ipbes.net/global-assessment" target="_blank" rel="noopener noreferrer">IPBES · Global Assessment · 2019 ↗</a></article></div><p class="facts-note">The 73% figure is an average change in monitored population sizes, not a loss of 73% of all individual animals. Dates and sources appear on the cards.</p><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Play again ↻", "Duck-Pen")</span><span>(transition-arrive: "instant")(link-goto: "Choose another ↗", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "View the journal", "Journal")</span></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: Duck-No {"position": "240,1080", "size": "180,100"}
<section data-scene="Duck-No" class="page scene-stage role-duck ending data-ending" data-sound="themeEnd" data-ending="duck-no"><div class="chapter"><span class="number">06</span><span>Ending B · No</span><span class="track"></span><small>DUCK / ALTAR</small></div><figure class="artwork" style="--image-ratio:1.441049"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E9%B8%AD/%E9%B8%AD6.jpg" alt="The duck priest asks the player one final question" width="4669" height="3240" decoding="async"></figure><div class="scene-panel"><div class="scene-copy"><div class="ending-label">ENDING 06 / NO</div><h1>They Need Somewhere to Live</h1><p class="voice">(set: _inkText to "“But where they live, what they eat, when they are taken away—\naren’t humans still the ones deciding?”")(set: _inkCount to 1)|spokenLine>[<span class="typewriter-line" title="Click to read the whole line"><span class="typewriter-measure" aria-hidden="true">“But where they live, what they eat, when they are taken away—<br>aren’t humans still the ones deciding?”</span><span class="typewriter-ink" aria-hidden="true">|typedVoice>[(print: (substring: _inkText, 1, _inkCount))]|typedCursor>[<span class="typewriter-caret">▏</span>](live: 45ms)[(set: _inkCount to (min: _inkCount + 1, 102))(replace: ?typedVoice)[(print: (substring: _inkText, 1, _inkCount))](if: _inkCount >= 102)[(replace: ?typedCursor)[](stop:)]]</span><span class="sr-only">“But where they live, what they eat, when they are taken away—<br>aren’t humans still the ones deciding?”</span></span>](click: ?spokenLine)[(set: _inkCount to 102)(replace: ?typedVoice)[(print: _inkText)](replace: ?typedCursor)[]]</p></div><div class="facts"><article class="fact"><strong>Plastic</strong><h2>Where does it go after we throw it away?</h2><p>Plastic entering aquatic environments harms wildlife through ingestion, entanglement, and damage to habitats.</p><a href="https://www.unep.org/plastic-pollution" target="_blank" rel="noopener noreferrer">UNEP · Plastic pollution ↗</a></article><article class="fact"><strong>Habitat</strong><h2>Animals need somewhere to live</h2><p>Changes in land and sea use, direct exploitation, climate change, pollution, and invasive alien species are the main direct drivers of biodiversity loss.</p><a href="https://www.ipbes.net/global-assessment" target="_blank" rel="noopener noreferrer">IPBES · Global Assessment · 2019 ↗</a></article><article class="fact"><strong>Every day</strong><h2>What can we do in ordinary life?</h2><p>Use fewer disposable plastics. Avoid wildlife from unknown sources. Find out where pets come from. Keep evidence of illegal trade and report it.</p><a href="https://www.unep.org/" target="_blank" rel="noopener noreferrer">UNEP · Act for Nature ↗</a></article></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Play again ↻", "Duck-Pen")</span><span>(transition-arrive: "instant")(link-goto: "Choose another ↗", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "View the journal", "Journal")</span></div></div><div class="chapter-meter" aria-hidden="true"><span style="width:100%"></span></div></section>

:: Journal {"position": "480,1080", "size": "180,100"}
<section data-scene="Journal" class="page journal" data-sound="themeEnd"><div class="journal-head"><div class="eyebrow">ENDING RECORDS</div><h1>Journey Journal</h1><p><span data-journal-total>0/6</span> endings found · Saved in this browser</p></div><div class="journal-grid"><article class="journal-role" data-card-label="Boar"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%87%8E%E7%8C%AA%E9%80%8F%E6%98%8E.png" alt="Boar silhouette"><div class="role-no">01 / THE FOREST</div><h2>Boar</h2><div class="journal-entry" data-entry="pig-live" data-description="You leave the machine, find water and fruit, and survive in the forest."><span class="entry-state">UNDISCOVERED</span><h3>Back to the Woods</h3><p class="entry-copy">Finish this route to record its ending here.</p></div><div class="journal-entry" data-entry="pig-fall" data-description="You keep following the machine. Once the trees are gone, it leaves you with nothing to eat."><span class="entry-state">UNDISCOVERED</span><h3>It Never Looked Back</h3><p class="entry-copy">Finish this route to record its ending here.</p></div><div class="role-enter">(transition-arrive: "instant")(link-goto: "Play again ↗", "Boar-Forest")</div></article><article class="journal-role" data-card-label="Cat"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E7%8C%AB%E9%80%8F%E6%98%8E.png" alt="Cat silhouette"><div class="role-no">02 / THE HOME</div><h2>Cat</h2><div class="journal-entry" data-entry="cat-light" data-description="You wake at the vet’s and receive treatment. When you recover, someone takes you home."><span class="entry-state">UNDISCOVERED</span><h3>Your Bed Is Still There</h3><p class="entry-copy">Finish this route to record its ending here.</p></div><div class="journal-entry" data-entry="cat-sleep" data-description="The vet cannot save you. Your person keeps the records and reports the seller."><span class="entry-state">UNDISCOVERED</span><h3>Not Long Enough at Home</h3><p class="entry-copy">Finish this route to record its ending here.</p></div><div class="role-enter">(transition-arrive: "instant")(link-goto: "Play again ↗", "Cat-Cage")</div></article><article class="journal-role" data-card-label="Duck"><img src="https://raw.githubusercontent.com/Yi1688/they-once-existed-assets/main/%E6%96%B0%E6%B8%B8%E6%88%8F/%E7%B4%A0%E6%9D%90/%E9%80%89%E8%A7%92/%E9%B8%AD%E5%AD%90%E9%80%8F%E6%98%8E.png" alt="Duck silhouette"><div class="role-no">03 / THE ALTAR</div><h2>Duck</h2><div class="journal-entry" data-entry="duck-yes" data-description="You answer yes. The priest asks what you intend to do for these animals."><span class="entry-state">UNDISCOVERED</span><h3>You Have a Say. Now What?</h3><p class="entry-copy">Finish this route to record its ending here.</p></div><div class="journal-entry" data-entry="duck-no" data-description="You answer no. The priest reminds you that people still decide how animals live."><span class="entry-state">UNDISCOVERED</span><h3>They Need Somewhere to Live</h3><p class="entry-copy">Finish this route to record its ending here.</p></div><div class="role-enter">(transition-arrive: "instant")(link-goto: "Play again ↗", "Duck-Pen")</div></article></div><div class="actions"><span>(transition-arrive: "instant")(link-goto: "Back to the cast →", "Choose a Character")</span><span>(transition-arrive: "instant")(link-goto: "Back to the title", "Start")</span></div></section>

:: Styles [stylesheet] {"position": "720,1080", "size": "180,100"}
:root{color-scheme:light;--ink:#302e2f;--muted:#686159;--gold:#79613d;--line:#8a795b55;--accent:#8a7859;--bg:#d4d0c8}
html[data-role="pig"]{--bg:#03060b;--gold:#b4bfd1;--line:#a3b9dd30}html[data-role="cat"]{--bg:#0c090f;--gold:#d5b9b6;--line:#d5b9b632}html[data-role="duck"]{--bg:#07040d;--gold:#c9a8e0;--line:#c9a8e038}html,body{transition:none}h1[tabindex="-1"]:focus{outline:none}.role-pig .artwork{box-shadow:0 0 60px #10223b15}.role-cat .artwork{box-shadow:0 0 60px #a383a019}.role-duck .artwork{box-shadow:0 0 60px #7542a31c}.role-pig .voice{color:#c6d1e0}.role-cat .voice{color:#e3c9cf}.role-duck .voice{color:#d4bee5}.role-duck .chapter .track{background:linear-gradient(90deg,#c9a8e05e,transparent)}.role-cat .chapter .track{background:linear-gradient(90deg,#d5b9b65e,transparent)}.memory{max-width:650px;text-align:left;margin:18px auto 0;padding:11px 15px;border-left:1px solid var(--gold);background:#ffffff04;color:#b6afa7;font-size:12px;line-height:1.9}.memory>span{display:block;color:var(--gold);font-size:9px;letter-spacing:3px;margin-bottom:2px}.story-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:790px;margin:22px auto 0}.story-choices:has(>.decision-option:only-child){grid-template-columns:1fr;max-width:790px}.story-choices .decision-option{display:block;min-width:0}.story-choices tw-link{display:flex;width:100%;height:100%;flex-direction:column;align-items:flex-start;gap:5px;min-height:82px;text-align:left;padding:15px 20px;background:#ffffff02;border-color:var(--line)}.story-choices tw-link:after{content:"↗";position:absolute;right:15px;top:15px;opacity:.55}.story-choices tw-link{position:relative;padding-right:32px}.choice-title{color:var(--gold);font-size:14px;letter-spacing:1px}.choice-detail{color:#8d8990;font-size:11px;line-height:1.8;letter-spacing:0}.story-choices tw-link:hover{background:#ffffff06;border-color:var(--gold)}.story-choices tw-link:hover .choice-detail{color:#b6b1a8}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--ink);min-height:100%;-webkit-text-size-adjust:100%;text-size-adjust:100%}body{font-family:"Microsoft YaHei","PingFang SC",sans-serif}tw-story{display:block;background:transparent;color:var(--ink);width:100%;max-width:1640px;min-height:100dvh;margin:0 auto;padding:0 clamp(18px,4vw,70px) 26px;font-size:17px;line-height:1.8}tw-passage{display:block;overflow-wrap:break-word}tw-sidebar,tw-icon,tw-story>br{display:none}tw-include{display:contents}tw-transition-container{max-width:100%}button,a,tw-link{touch-action:manipulation}button{font:inherit}button,tw-link,a{color:var(--gold)}tw-link{font-weight:400;cursor:pointer;transition:color .2s}tw-link:hover,a:hover{color:#fff0c7}button:focus-visible,tw-link:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:5px}button{cursor:pointer}button:disabled{cursor:default}::selection{background:#c7ab7540}h1,h2,h3,p,figure{margin:0}button svg{width:18px;height:18px;vertical-align:middle;fill:none;stroke:currentColor;stroke-width:1.5}a{text-underline-offset:4px}
.mast{min-height:66px;display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);margin-bottom:20px;color:var(--muted);font-size:12px;letter-spacing:2px}.brand{display:flex;gap:12px;align-items:center;color:#a49377;font-family:Georgia,serif}.brand em{color:var(--gold);font-style:normal}.mast nav{display:flex;align-items:center;gap:24px;letter-spacing:1px}.mast tw-link{font-size:12px}.audio-toggle{border:0;padding:8px 0;background:none;font-size:12px}.audio-toggle.is-off{color:var(--muted)}.page{animation:none}.eyebrow{font:10px/1.6 Georgia,"Microsoft YaHei",serif;letter-spacing:4px;color:var(--gold)}.selection-head{text-align:center;margin:28px auto 0}.selection-head h1{font:normal clamp(34px,4vw,58px)/1.5 "Songti SC","SimSun",serif;letter-spacing:12px;margin:8px 0 4px}.selection-head p{font-size:13px;line-height:1.9;color:var(--muted);letter-spacing:1px}.selection-art{display:block;width:270px;height:96px;object-fit:contain;filter:invert(1);margin:16px auto 22px}.role-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:0 auto;max-width:1380px}.role-card{border:1px solid #ffffff18;position:relative;transition:border-color .3s,background .3s;min-width:0;background:#090a09}.role-card:hover,.role-card:focus-within{border-color:#c7ab7560;background:#10110f}.animal-preview{display:block;position:relative;background:none;border:0;width:100%;padding:12px 20px 0;overflow:hidden}.animal-preview img{display:block;width:100%;height:clamp(110px,17dvh,190px);object-fit:contain;filter:invert(1);opacity:.6;transition:opacity .25s}.animal-preview:hover img,.animal-preview.is-playing img{opacity:1}.sound-hint{font-size:10px;letter-spacing:1px;color:#9a8969;display:block;padding:6px 0}.role-copy{padding:20px 26px 26px}.role-no{font:10px Georgia,serif;letter-spacing:3px;color:var(--gold)}.role-card h2{font:normal 29px/1.5 "SimSun",serif;letter-spacing:6px;margin:7px 0}.role-card p{font-size:13px;color:#a4a095;line-height:1.95;min-height:52px}.role-enter{margin-top:18px;font-size:14px}.role-enter tw-link{display:flex;justify-content:space-between;gap:12px;align-items:center}.role-count{position:absolute;right:22px;top:16px;font:10px Georgia,serif;color:#68665e;letter-spacing:2px}.role-count.has-ending{color:var(--gold)}.selection-foot{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;margin:27px auto 10px;max-width:1380px;color:#77776f;font-size:11px;letter-spacing:1px}.selection-foot .series{color:#a28e68}
.chapter{display:flex;align-items:center;gap:15px;margin:0 0 14px;font-size:12px;letter-spacing:2px;color:var(--muted)}.chapter .number{font:italic 26px Georgia,serif;color:var(--gold)}.chapter .track{height:1px;background:var(--line);flex:1}.chapter small{font-size:10px;letter-spacing:2px;color:#77796e}.scene-stage{position:relative;width:100%;isolation:isolate}.artwork{display:flex;justify-content:center;align-items:center;position:relative;width:100%;height:clamp(220px,52dvh,650px);margin:0;overflow:hidden;background:#000}.artwork img{display:block;width:100%;height:100%;object-fit:contain;object-position:center}.artwork.is-clickable{cursor:pointer}.artwork.is-clickable:after{content:"Click the image to continue ↗";position:absolute;right:15px;bottom:10px;padding:3px 8px;color:#d7c29a;background:#000b;font-size:10px;letter-spacing:1px;pointer-events:none}.scene-copy{position:relative;max-width:900px;margin:22px auto 0;text-align:center}.scene-copy h1{font:normal clamp(26px,3vw,38px)/1.5 "SimSun",serif;letter-spacing:6px;margin:4px auto 12px}.scene-copy p{font-size:clamp(14px,1.2vw,17px);line-height:1.95;margin:9px 0;color:#c4c0b7}.scene-copy .voice{color:#e8ddc8;font-family:"SimSun",serif;font-size:clamp(17px,1.5vw,22px);line-height:1.8}.scene-copy .thought{color:#96958e;font-size:13px}.actions{display:flex;justify-content:center;align-items:center;gap:16px;flex-wrap:wrap;margin:21px 0 0}.actions tw-link,.action-button,.hold-button{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:46px;border:1px solid #c7ab7566;border-radius:0;background:linear-gradient(140deg,#c7ab750b,transparent);color:#dfcca7;padding:10px 28px;font-size:14px;font-weight:normal;letter-spacing:1px;transition:background .2s,border-color .2s}.actions tw-link:hover,.action-button:hover,.hold-button:hover{border-color:var(--gold);background:#c7ab751b;color:#fff0cf}.actions .secondary tw-link{border-color:#ffffff26;color:#b1afa8}.scene-note{font:10px/1.8 Georgia,"Microsoft YaHei",sans-serif;letter-spacing:2px;color:#666c65;text-align:center;margin-top:20px}.chapter-meter{width:100%;height:1px;background:#ffffff0a;position:relative;margin-top:22px}.chapter-meter span{display:block;height:1px;background:var(--accent)}.role-pig{--accent:#8c9fbe}.role-cat{--accent:#cfb3a6}.role-duck{--accent:#a890cc}.interaction{max-width:600px;margin:19px auto 0;text-align:center}.interaction .instructions{font-size:12px;color:#9b9588;line-height:1.8;margin:0 0 12px}.task-status{font:12px/1.8 "Microsoft YaHei",sans-serif;color:var(--gold);min-height:25px;margin:8px 0}.task-track{height:3px;background:#ffffff16;width:160px;max-width:100%;margin:12px auto 0;overflow:hidden}.task-track span{display:block;width:0;height:100%;background:var(--gold);transition:width .12s}.is-locked{display:none!important}.hold-button{user-select:none;-webkit-user-select:none;touch-action:none;min-width:240px;position:relative;overflow:hidden}.hold-button:before{content:"";position:absolute;inset:0;transform:scaleX(var(--hold,0));transform-origin:left;background:#c7ab7524;pointer-events:none}.hold-button.is-holding{border-color:#f0d49e;color:#ffedbd}.hold-button.is-holding:after{content:"";position:absolute;border:1px solid #ffe8ba33;border-radius:50%;width:90px;height:90px;left:50%;top:50%;animation:breath .8s infinite;pointer-events:none}.task-complete .action-button,.task-complete .hold-button{border-color:#c7ab752a;color:#8b826f}.artwork.is-steaming:after{content:"";position:absolute;inset:15% 28% 0;background:radial-gradient(ellipse at 50% 80%,#ffffff36,transparent 60%);animation:mist 1.1s infinite;pointer-events:none}.duel{display:grid;grid-template-columns:1fr 1fr;gap:15px;width:min(800px,100%);margin:0 auto}.duel-target{border:1px solid #ffffff22;padding:0;position:relative;background:#000;overflow:hidden}.duel-target img{display:block;width:100%;height:clamp(150px,30dvh,350px);object-fit:contain;transition:filter .2s,transform .2s}.duel-target .target-label{display:block;padding:8px 10px;color:#beab87;font-size:11px;border-top:1px solid #ffffff14}.duel-target:hover{border-color:#c7ab7580}.duel-target.is-hit img{filter:brightness(1.6)}.duel-target:disabled{opacity:.42}.task-duck .scene-copy{margin-top:20px}.task-duck .artwork{display:none}.duel-status{display:flex;justify-content:center;gap:24px;margin:12px 0;color:#b1a89a;font-size:12px}.crumb{width:6px;height:6px;position:absolute;pointer-events:none;background:#e6c47d;border-radius:50%;animation:crumb .75s both}
.ending .artwork{height:clamp(210px,40dvh,480px)}.ending .scene-copy{max-width:900px}.ending .ending-label{color:var(--gold);font:10px Georgia,"Microsoft YaHei",sans-serif;letter-spacing:4px;margin-top:4px}.ending .ending-note{color:#9f998a;font-size:12px;border-top:1px solid var(--line);padding-top:16px;margin-top:18px}.ending .closing{font:normal 23px/1.8 "SimSun",serif;letter-spacing:4px;margin-top:15px;color:#d1bb94}.ending-cat-dark .artwork{background:radial-gradient(ellipse,#151319,#000 70%)}.ending-cat-dark .artwork img{opacity:.12;filter:grayscale(1)}.ending-pig-fall .artwork img{filter:grayscale(.9) brightness(.42)}.ending-pig-fall .artwork:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#000b,transparent 50%);pointer-events:none}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;max-width:1100px;margin:22px auto}.fact{padding:24px;border:1px solid var(--line);text-align:left;background:#ffffff02}.fact strong{display:block;color:#dfc796;font:normal clamp(27px,3.5vw,45px)/1.5 Georgia,"SimSun",serif;letter-spacing:1px}.fact h2{font-weight:400;font-size:15px;margin:5px 0 10px;color:#ded9cc}.fact p{color:#a4a198;font-size:13px;line-height:1.9}.fact a{display:inline-block;font-size:10px;color:#9d8c6e;line-height:1.6;margin-top:15px}.facts-note{font-size:11px;color:#8a887e;line-height:1.9;max-width:1050px;margin:0 auto;text-align:center}.data-ending .artwork{height:clamp(160px,27dvh,320px)}.data-ending .scene-copy{margin-top:16px}.data-ending .facts .fact{padding:18px 22px}
.journal-head{text-align:center;padding:22px 0}.journal-head h1{font:normal 40px/1.5 "SimSun",serif;letter-spacing:10px;margin:8px 0}.journal-head p{font-size:12px;color:var(--muted)}.journal-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:22px auto}.journal-role{padding:24px;border:1px solid var(--line)}.journal-role>img{display:block;width:100%;height:130px;object-fit:contain;filter:invert(1);opacity:.5}.journal-role h2{font:normal 26px/1.5 "SimSun",serif;letter-spacing:6px;margin:10px 0 20px}.journal-entry{position:relative;border-top:1px solid #ffffff16;padding:15px 0 10px}.journal-entry h3{font-size:15px;font-weight:400;color:#c8c2b4;margin-bottom:8px}.journal-entry p{color:#787a72;font-size:12px;line-height:1.8}.journal-entry.is-discovered h3{color:#dfc796}.journal-entry.is-discovered p{color:#aaa69a}.journal-entry .entry-state{font:10px Georgia,"Microsoft YaHei",sans-serif;letter-spacing:2px;color:#62685e;margin-bottom:7px;display:block}.journal-entry.is-discovered .entry-state{color:var(--gold)}.journal-role .role-enter{font-size:13px;margin-top:16px}
.sound-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);padding:7px 16px;background:#161711;border:1px solid #c7ab7538;color:#cdbb96;font-size:12px;z-index:80;pointer-events:none;animation:none}.load-error{position:absolute;inset:0;display:grid;place-content:center;padding:24px;text-align:center;color:var(--muted);font-size:13px}.load-error small{display:block;color:#756d60;margin-top:7px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.utility-note{max-width:800px;margin:30px auto 0;padding-top:20px;border-top:1px solid var(--line);font-size:12px;line-height:2;color:#8b8b81;text-align:center}
@keyframes breath{from{transform:translate(-50%,-50%) scale(.3);opacity:1}to{transform:translate(-50%,-50%) scale(2.5);opacity:0}}@keyframes mist{from{transform:translateY(12px);opacity:.2}to{transform:translateY(-14px);opacity:.7}}@keyframes crumb{to{transform:translate(var(--dx),var(--dy));opacity:0}}
@media(min-width:1700px){.artwork{height:min(55dvh,720px)}.scene-copy{margin-top:26px}.role-grid{margin-top:28px}.selection-head{margin-top:42px}.selection-art{margin-top:24px;margin-bottom:30px}.animal-preview img{height:190px}.role-copy{padding:24px 30px 32px}}
@media(max-width:800px){tw-story{padding:0 20px 26px}.mast{min-height:58px;letter-spacing:1px}.brand{font-size:10px;gap:7px}.mast nav{gap:14px}.role-grid{gap:12px}.role-copy{padding:16px}.role-card p{font-size:12px}.role-card h2{font-size:25px}.role-no{font-size:9px;letter-spacing:2px}.role-count{right:12px;top:10px}.facts{gap:10px}.fact{padding:17px}.chapter small{font-size:9px}.journal-grid{gap:12px}.journal-role{padding:16px}}
@media(max-width:600px){tw-story{padding:0 15px 24px}.mast{min-height:52px;margin-bottom:14px;gap:8px}.brand .series-label{display:none}.brand{font-size:10px;letter-spacing:1px}.mast nav{gap:16px}.mast tw-link,.audio-toggle{font-size:11px}.mast .journal-number{display:none}.selection-head{margin-top:15px}.selection-head h1{font-size:33px;letter-spacing:8px;margin:5px 0 9px}.selection-head p{font-size:11px;letter-spacing:0}.eyebrow{font-size:9px;letter-spacing:3px}.selection-art{width:180px;height:61px;margin:10px auto 16px}.role-grid{grid-template-columns:1fr;gap:10px}.role-card{display:grid;grid-template-columns:29% 1fr}.animal-preview{padding:6px 5px;display:flex;flex-direction:column;justify-content:center}.animal-preview img{height:86px;width:100%;min-height:0}.sound-hint{font-size:8px;letter-spacing:0;padding:5px 0 0}.role-copy{padding:13px 15px 14px 10px}.role-no{font-size:8px;letter-spacing:2px}.role-card h2{font-size:23px;line-height:1.3;margin:5px 0;letter-spacing:4px}.role-card p{min-height:0;font-size:11px;line-height:1.7}.role-enter{margin-top:8px;font-size:12px}.role-count{top:12px;right:13px;font-size:9px}.selection-foot{font-size:9px;letter-spacing:0;margin-top:19px;gap:8px}.selection-foot .series{width:100%;order:2}.chapter{font-size:10px;gap:9px;letter-spacing:1px;margin-bottom:10px}.chapter .number{font-size:23px}.chapter small{letter-spacing:1px;font-size:8px}.artwork{height:clamp(170px,35dvh,360px)}.artwork.is-clickable:after{font-size:9px;bottom:6px;right:7px}.scene-copy{margin-top:20px}.scene-copy h1{font-size:27px;letter-spacing:4px;margin-bottom:12px}.scene-copy p{font-size:14px;line-height:1.9;margin:9px 0}.scene-copy .voice{font-size:18px}.scene-copy .thought{font-size:12px}.actions{gap:10px;margin-top:20px}.actions tw-link,.action-button,.hold-button{font-size:13px;min-height:44px;padding:10px 22px}.scene-note{font-size:8px;letter-spacing:1px;margin-top:18px}.interaction{margin-top:18px}.interaction .instructions{font-size:11px}.task-track{width:140px}.task-status{font-size:11px}.chapter-meter{margin-top:20px}.duel{gap:10px}.duel-target img{height:clamp(140px,24dvh,230px)}.duel-target .target-label{font-size:10px;padding:8px}.ending .artwork{height:clamp(170px,29dvh,310px)}.ending .scene-copy h1{font-size:29px}.ending .ending-note{font-size:11px;padding-top:13px;margin-top:16px}.ending .closing{font-size:21px;letter-spacing:3px}.facts{grid-template-columns:1fr;gap:10px;margin:18px 0}.fact,.data-ending .facts .fact{padding:14px 17px}.fact strong{font-size:29px;line-height:1.3}.fact h2{font-size:13px;margin:3px 0 6px}.fact p{font-size:12px;line-height:1.75}.fact a{margin-top:7px;font-size:9px}.facts-note{font-size:10px;text-align:left}.data-ending .artwork{height:clamp(120px,23dvh,200px)}.journal-head{padding:12px 0}.journal-head h1{font-size:32px;letter-spacing:7px}.journal-grid{grid-template-columns:1fr;margin-top:14px;gap:16px}.journal-role{padding:20px}.journal-role>img{height:90px}.journal-role h2{font-size:23px}.journal-entry{padding-top:12px}.utility-note{margin-top:24px;font-size:11px}}
@media(max-height:600px) and (min-width:601px){.selection-head{margin-top:10px}.selection-head h1{font-size:33px;letter-spacing:8px}.selection-art{height:45px;margin:7px auto 10px}.animal-preview img{height:85px}.role-copy{padding-top:10px;padding-bottom:15px}.role-card h2{font-size:24px;margin:4px 0}.role-card p{font-size:11px;line-height:1.7;min-height:0}.role-enter{margin-top:10px}.selection-foot{margin-top:17px}.artwork{height:46dvh;min-height:155px}.scene-copy{margin-top:15px}.scene-copy p{font-size:14px}.scene-copy h1{font-size:28px}.mast{min-height:48px;margin-bottom:12px}.chapter{margin-bottom:10px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(max-width:600px){.story-choices{gap:9px;margin-top:18px}.story-choices tw-link{padding:12px 25px 12px 13px;min-height:92px}.choice-title{font-size:12px;line-height:1.7}.choice-detail{font-size:10px;line-height:1.7}.story-choices tw-link:after{right:10px;top:11px;font-size:11px}.memory{font-size:11px;padding:10px 13px;margin-top:14px}}
.actions.story-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}.actions.story-choices:has(>.decision-option:only-child){grid-template-columns:1fr}.role-pig .scene-copy .voice{color:#c6d1e0}.role-cat .scene-copy .voice{color:#e3c9cf}.role-duck .scene-copy .voice{color:#d4bee5}

/* Pages appear immediately; framework transition wrappers must not move the layout. */
html{scrollbar-gutter:auto;overflow:hidden;overflow-anchor:none;scroll-behavior:auto}body,tw-story{overflow-anchor:none}tw-passage,.page{animation:none!important;transition:none!important;transform:none!important;opacity:1!important}tw-transition-container:not(.page tw-transition-container){display:contents!important;animation:none!important;transition:none!important;transform:none!important;opacity:1!important}.transition-out{display:none!important}

/* Fit the complete scene to the viewport, reserving space for every control. */
html,body{height:100%;min-height:0;overflow:hidden}
tw-story{min-height:0;height:100dvh;padding-bottom:max(12px,env(safe-area-inset-bottom))}
.mast{min-height:58px;margin-bottom:14px}
.page{display:flow-root;min-width:0;--art-height:42dvh;--duel-height:24dvh}
.chapter{margin-bottom:10px}
.scene-stage .artwork{height:var(--art-height);min-height:0}
.scene-panel{min-width:0;display:flow-root}
.scene-copy,.task-duck .scene-copy,.data-ending .scene-copy{margin-top:14px}
.scene-copy h1{margin-top:0;margin-bottom:8px}
.scene-copy p{margin:7px 0;line-height:1.8}
.actions,.story-choices{margin-top:14px}
.actions.story-choices{margin-left:auto;margin-right:auto}
.story-choices tw-link{min-height:70px;padding-top:11px;padding-bottom:11px}
.chapter-meter{margin-top:14px}
.interaction{margin-top:12px}
.interaction .instructions{margin-bottom:8px}
.interaction [data-task-next].is-locked{display:flex!important;visibility:hidden;pointer-events:none}
.task-status{min-height:3.6em;margin:6px 0;display:flex;align-items:center;justify-content:center}
.task-track{margin-top:8px}
.duel-target img{height:var(--duel-height)}
.facts{margin:14px auto;gap:12px}
.fact,.data-ending .facts .fact{padding:14px 18px}
.fact a{margin-top:8px}
.memory{margin-top:12px;padding:8px 12px;line-height:1.7}
.card-tabs{display:none}
.card-tabs button{border:1px solid var(--line);background:transparent;color:var(--muted);padding:8px 10px;min-height:36px;font-size:12px;letter-spacing:1px}
.card-tabs button[aria-pressed="true"]{border-color:var(--gold);background:#ffffff07;color:var(--gold)}
.cycle-word{display:inline-block;border-bottom:1px dotted currentColor;text-underline-offset:5px}
.cycle-word tw-link{color:inherit;font:inherit}
.artwork.is-listening:after{content:"Click the image to hear its call ♫"}
.story-whisper{max-width:650px;display:grid;grid-template-columns:1fr auto;gap:3px 12px;margin:12px auto 0;padding:8px 12px;border-left:1px solid var(--line);background:#ffffff03;text-align:left;line-height:1.6}
.whisper-label{grid-column:1;grid-row:1;color:var(--gold);font-size:9px;letter-spacing:2px}
.whisper-action{grid-column:2;grid-row:1;font-size:10px;line-height:1.5;white-space:nowrap}
.whisper-copy{grid-column:1/-1;grid-row:2;display:block;height:3.6em;font-size:12px;line-height:1.8;color:#b0aaa2}
.macro-line{min-height:3.6em}
.typewriter-line{display:block;position:relative;cursor:pointer}
.typewriter-measure{display:block;visibility:hidden}
.typewriter-ink{position:absolute;inset:0;white-space:pre-line}
.typewriter-ink tw-hook[name="typedvoice"]:after{content:"▏";font-size:.8em;color:var(--gold);opacity:.6}
.typewriter-ink tw-hook[name="typedvoice"]:empty:after{content:""}
.scene-atmosphere,.impact-flash{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.scene-atmosphere{z-index:1}
.impact-flash{z-index:2;background:radial-gradient(ellipse at center,#ffe3ad77,transparent 68%);opacity:0}
.scene-atmosphere:before{content:"";position:absolute;inset:0;opacity:0}
[data-fx="light"] .scene-atmosphere:before{background:radial-gradient(ellipse at 58% 48%,#ffd77b61,transparent 62%);animation:light-breath 3.2s ease-in-out infinite}
[data-fx="revelation"] .scene-atmosphere:before{background:radial-gradient(ellipse at 50% 36%,#e3eaff68,transparent 70%);animation:divine-reveal 1.8s ease-out both}
[data-fx="warmth"] .scene-atmosphere:before{background:radial-gradient(ellipse at 55% 48%,#edbd8e2e,transparent 72%);animation:warm-breath 5s ease-in-out infinite}
[data-fx="halo"] .scene-atmosphere:before,[data-fx="altar"] .scene-atmosphere:before{background:radial-gradient(ellipse at 50% 35%,#d4a6f047,transparent 63%);animation:ritual-breath 4.5s ease-in-out infinite}
[data-fx="colour"] .artwork img{animation:dream-colour 1.8s ease-out both}
[data-fx="farewell"] .artwork img{opacity:0;animation:last-light 4s ease-out both}
.ending-pig-fall .artwork img{animation:forest-fades 5s ease-out both}
.atmosphere-cloud{position:absolute;width:44%;height:50%;left:calc(9% + var(--cloud)*18%);top:24%;border-radius:50%;background:radial-gradient(ellipse,#eef2ff66,transparent 65%);filter:blur(12px);transform-origin:50% 22%;opacity:0}
.is-steaming .atmosphere-cloud{animation:steam-rise 1.8s calc(var(--cloud)*-.55s) ease-out infinite}
.duel-target.is-hit img{animation:wing-strike .22s ease-out}
.duel-target:disabled .target-label{color:#b69fbe}
@keyframes light-breath{0%,100%{opacity:.25}50%{opacity:.8}}
@keyframes divine-reveal{from{opacity:.8}to{opacity:0}}
@keyframes warm-breath{0%,100%{opacity:.15}50%{opacity:.5}}
@keyframes ritual-breath{0%,100%{opacity:.2}50%{opacity:.65}}
@keyframes dream-colour{from{filter:grayscale(1) brightness(.65)}to{filter:grayscale(0) brightness(1)}}
@keyframes last-light{from{opacity:.45;filter:grayscale(1)}to{opacity:0;filter:grayscale(1)}}
@keyframes forest-fades{from{filter:grayscale(.15) brightness(.8)}to{filter:grayscale(1) brightness(.35)}}
@keyframes steam-rise{from{transform:translateY(-18%) scale(.45);opacity:0}35%{opacity:.8}to{transform:translateY(23%) scale(1.3);opacity:0}}
@keyframes wing-strike{0%,100%{transform:rotate(0)}35%{transform:rotate(-3deg)}70%{transform:rotate(2deg)}}
@media(prefers-reduced-motion:reduce){.typewriter-measure{visibility:visible}.typewriter-ink{visibility:hidden}}

/* Each complete route keeps its own palette, including navigation and endings. */
:root,html[data-role="selection"],html[data-role="pig"],html[data-role="duck"]{color-scheme:dark;--bg:#000;--ink:#f0f0f0;--copy:#d4d4d4;--voice:#f0f0f0;--muted:#aaa;--gold:#ddd;--line:#ffffff2b;--accent:#aaa;--paper:#101010;--surface:#111;--surface-hover:#1b1b1b;--frame:#080808;--button-bg:#181818;--button-ink:#f1f1f1;--button-border:#888;--button-hover:#272727;--button-hover-ink:#fff;--quiet-bg:#0d0d0d;--quiet-ink:#aaa;--track:#ffffff21;--image-shadow:none}
html[data-role="cat"]{color-scheme:light;--bg:#fff;--ink:#202020;--copy:#343434;--voice:#202020;--muted:#626262;--gold:#555;--line:#0000002b;--paper:#fff;--surface:#fff;--surface-hover:#f4f4f4;--frame:#fff;--button-bg:#fff;--button-ink:#222;--button-border:#777;--button-hover:#f0f0f0;--button-hover-ink:#000;--quiet-bg:#f4f4f4;--quiet-ink:#666;--track:#0000001c;--accent:#777;--image-shadow:none}
html,body{background-color:var(--bg)}
body{background-image:none}
body:before{display:none}
tw-story{position:relative;z-index:1}
.brand{color:var(--muted)}
.mast{border-bottom-color:var(--line)}
.mast tw-link,.mast tw-link:visited{color:var(--gold)}
tw-link,tw-link.visited,tw-link:visited{color:var(--gold)}
tw-link:hover,a:hover{color:var(--ink)}
.page .enchantment-link,.page .enchantment-link:hover,.page .enchantment-link:active,.page .enchantment-link:focus{color:inherit;font-weight:inherit;text-decoration:none}
.selection-head p,.role-card p,.selection-foot,.chapter small,.scene-note,.utility-note{color:var(--muted)}
.role-card{background:var(--paper);color:var(--ink);border-color:var(--line);box-shadow:none}
.role-card:hover,.role-card:focus-within{background:var(--surface-hover);border-color:var(--gold);box-shadow:none}
.role-card:nth-child(2),.journal-role[data-card-label="Cat"]{color-scheme:light;--ink:#202020;--copy:#343434;--muted:#626262;--gold:#444;--line:#0000002b;--paper:#fff;--surface-hover:#f4f4f4;color:var(--ink);background:var(--paper);border-color:var(--line)}
.selection-art,.journal-role>img{filter:brightness(0) invert(1);mix-blend-mode:normal;opacity:.85}
.animal-preview img,.selection .animal-preview img{filter:invert(1) brightness(1.8);mix-blend-mode:screen;opacity:.9}
.selection .role-card:nth-child(2) .animal-preview img{filter:none;mix-blend-mode:multiply}
.journal-role[data-card-label="Cat"]>img{filter:brightness(0)}
.sound-hint,.role-count{color:var(--muted)}
.selection-foot .series{color:var(--muted)}
.role-card tw-link:hover,.journal-role tw-link:hover{color:var(--ink)}
.scene-copy p,.fact p,.journal-entry.is-discovered p{color:var(--copy)}
.scene-copy .thought,.ending .ending-note,.memory,.whisper-copy,.facts-note,.choice-detail,.interaction .instructions,.duel-status{color:var(--muted)}
.role-pig .scene-copy .voice,.role-pig .voice,.role-cat .scene-copy .voice,.role-cat .voice,.role-duck .scene-copy .voice,.role-duck .voice{color:var(--voice)}
.scene-copy .closing,.fact strong,.fact h2,.journal-entry.is-discovered h3{color:var(--gold)}
.chapter .track,.role-cat .chapter .track,.role-duck .chapter .track{background:var(--line)}
.scene-stage>.artwork{width:min(100%,calc(var(--art-height) * var(--image-ratio,1.752)));margin-inline:auto;justify-self:center}
.artwork,.role-pig .artwork,.role-cat .artwork,.role-duck .artwork{background:var(--frame);border:1px solid var(--line);box-shadow:var(--image-shadow)}
.artwork img{filter:none}
.artwork.is-clickable:after{color:var(--ink);background:var(--surface);border:1px solid var(--line)}
.ending-cat-dark .artwork{background:#000}
.memory{background:var(--paper);border-left-color:var(--gold)}
.story-whisper{background:transparent;border-left:0;border-top:1px solid var(--line);padding-left:0;padding-right:0}
.actions tw-link,.action-button,.hold-button{color:var(--button-ink);border-color:var(--button-border);background:var(--button-bg);box-shadow:none}
.actions tw-link:hover,.action-button:hover,.hold-button:hover{color:var(--button-hover-ink);border-color:var(--gold);background:var(--button-hover)}
.story-choices tw-link{color:var(--ink);background:var(--surface);border-color:var(--line);box-shadow:none}
.story-choices .choice-title{color:var(--ink)}
.story-choices tw-link:hover{background:var(--surface-hover);border-color:var(--gold)}
.story-choices tw-link:hover .choice-detail{color:var(--copy)}
.actions .secondary tw-link{border-color:var(--line);color:var(--muted);background:transparent}
.task-track,.chapter-meter{background:var(--track)}
.role-pig,.role-cat,.role-duck{--accent:inherit}
.task-complete .action-button,.task-complete .hold-button{color:var(--quiet-ink);border-color:var(--line);background:var(--quiet-bg);box-shadow:none}
.hold-button.is-holding{color:var(--button-hover-ink);border-color:var(--gold)}
.hold-button:before{background:#a0a0a02b}
.artwork.is-steaming:after{inset:8% 10% 24%;background:radial-gradient(ellipse at 50% 40%,#ffffff36,transparent 60%)}
.duel-target{background:var(--frame);border-color:var(--line)}
.duel-target .target-label{color:var(--gold);background:var(--surface);border-top-color:var(--line)}
.duel-target:disabled{opacity:.6}
.duel-target:disabled .target-label{color:#b5a5a7}
.fact,.data-ending .facts .fact,.journal-role{background:var(--paper)}
.fact a{color:var(--gold)}
.journal-entry{border-top-color:var(--line)}
.journal-entry h3{color:var(--copy)}
.journal-entry p,.journal-entry .entry-state{color:var(--muted)}
.card-tabs button[aria-pressed="true"]{background:var(--button-hover);color:var(--button-hover-ink);border-color:var(--gold)}
.sound-toast{color:var(--button-ink);background:var(--button-bg);border-color:var(--gold)}
::selection{background:#8888}

/* Each text effect paints inside its own space; paragraphs and buttons stay put. */
.word-slot{display:inline-grid;position:relative;max-width:100%;vertical-align:baseline;border-bottom:1px dotted var(--gold);line-height:inherit;text-indent:0}
.word-slot .word-measure,.word-slot .word-value{grid-area:1/1;min-width:0}
.word-measure{visibility:hidden;pointer-events:none;user-select:none}
.word-value{align-self:start}
.word-slot tw-link{font:inherit;color:var(--gold);text-decoration:none}
.changing-word{border-bottom-style:solid;border-bottom-color:var(--line);color:var(--gold)}
.word-slot:hover{background:#8882}
.prose-fragment{animation:ink-sentence .9s var(--ink-delay,0ms) ease both}
.ink-title{animation:ink-title 1.6s ease-out both;background:linear-gradient(105deg,var(--ink) 20%,var(--gold) 48%,var(--ink) 76%);background-size:220% 100%;background-clip:text;-webkit-background-clip:text;color:transparent}
.typewriter-ink tw-hook[name="typedvoice"]:after{content:none}
.typewriter-caret{display:inline;color:var(--gold);animation:ink-caret .8s steps(1,end) infinite}
.cycle-word,.reveal-word{background-image:linear-gradient(90deg,#8880,#8883,#8880);background-size:240% 100%;animation:ink-clue 3.5s ease-in-out 2}
@keyframes ink-sentence{from{opacity:.12;text-shadow:0 0 7px currentColor}to{opacity:1;text-shadow:0 0 0 transparent}}
@keyframes ink-title{from{background-position:100% 50%}to{background-position:0% 50%}}
@keyframes ink-caret{0%,55%{opacity:1}56%,100%{opacity:0}}
@keyframes ink-clue{0%,100%{background-position:100% 50%}50%{background-position:0% 50%}}
@media(prefers-reduced-motion:reduce){.prose-fragment,.ink-title,.cycle-word,.reveal-word{animation:none!important}.prose-fragment{opacity:1;text-shadow:none}.typewriter-caret{display:none}}

/* Compact spacing is applied before any final scaling on very small windows. */
.fit-compact .chapter{margin-bottom:6px;font-size:10px}
.fit-compact .chapter .number{font-size:22px}
.fit-compact .scene-copy,.fit-compact.task-duck .scene-copy{margin-top:8px}
.fit-compact .scene-copy h1{font-size:clamp(22px,2.6vw,32px);line-height:1.35;letter-spacing:3px;margin-bottom:5px}
.fit-compact .scene-copy p{font-size:13px;line-height:1.65;margin:5px 0}
.fit-compact .scene-copy .voice{font-size:16px;line-height:1.65}
.fit-compact .scene-copy .thought,.fit-compact .ending-note{font-size:11px}
.fit-compact .ending-note{padding-top:8px;margin-top:8px}
.fit-compact .scene-copy .closing{font-size:18px;letter-spacing:2px}
.fit-compact .actions,.fit-compact .story-choices{margin-top:8px;gap:8px}
.fit-compact .actions tw-link,.fit-compact .action-button,.fit-compact .hold-button{min-height:38px;padding:7px 15px;font-size:12px}
.fit-compact .story-choices tw-link{min-height:62px;padding:8px 25px 8px 12px;gap:3px}
.fit-compact .choice-title{font-size:12px;line-height:1.6}
.fit-compact .choice-detail{font-size:10px;line-height:1.6}
.fit-compact .memory{font-size:10px;line-height:1.6;margin-top:8px;padding:6px 10px}
.fit-compact .memory>span{font-size:8px;margin-bottom:0}
.fit-compact .chapter-meter{margin-top:8px}
.fit-compact .interaction{margin-top:8px}
.fit-compact .interaction .instructions{font-size:10px;margin-bottom:6px}
.fit-compact .task-status{font-size:10px;margin:3px 0}
.fit-compact .task-track{margin-top:6px}
.fit-compact .duel-status{font-size:10px;margin:6px 0;gap:12px}
.fit-compact .facts{margin:8px auto;gap:8px}
.fit-compact .fact{padding:10px 12px}
.fit-compact .fact strong{font-size:26px;line-height:1.3}
.fit-compact .fact h2{font-size:12px;margin:4px 0}
.fit-compact .fact p{font-size:11px;line-height:1.7}
.fit-compact .fact a{font-size:9px;margin-top:6px}
.fit-compact .facts-note{font-size:9px;line-height:1.6}
.fit-compact .story-whisper{margin-top:8px;padding:6px 10px;gap:2px 10px}
.fit-compact .whisper-copy{font-size:10px}
.fit-compact .whisper-label{font-size:8px}
.fit-compact .whisper-action{font-size:9px}
.fit-compact .selection-head{margin-top:8px}
.fit-compact .selection-head h1{font-size:30px;line-height:1.3;margin:4px 0}
.fit-compact .selection-art{height:40px;margin:6px auto 9px}
.fit-compact .role-copy{padding:9px 14px}
.fit-compact .role-card h2{font-size:22px;margin:3px 0}
.fit-compact .role-card p{font-size:11px;line-height:1.6;min-height:0}
.fit-compact .animal-preview img{height:70px}
.fit-compact .role-enter{margin-top:7px;font-size:12px}
.fit-compact .role-grid{gap:8px;margin-top:0}
.fit-compact .selection-foot{margin-top:10px;margin-bottom:0}
.fit-compact .journal-head{padding:6px 0}
.fit-compact .journal-head h1{font-size:28px;margin:3px 0}
.fit-compact .journal-grid{margin:8px auto;gap:10px}
.fit-compact .journal-role{padding:12px}
.fit-compact .journal-role>img{height:60px}
.fit-compact .journal-role h2{font-size:22px;margin:4px 0 10px}
.fit-compact .journal-entry{padding:8px 0}
.fit-compact .journal-entry h3{font-size:13px;margin-bottom:4px}
.fit-compact .journal-entry p{font-size:11px;line-height:1.7}
.fit-compact .journal-entry .entry-state{font-size:9px;margin-bottom:4px}

@media(max-width:600px){
  tw-story{padding-left:15px;padding-right:15px}
  .mast{min-height:48px;margin-bottom:10px}
  .mast nav{gap:12px}
  .scene-copy h1{font-size:25px;letter-spacing:3px}
  .scene-copy p{font-size:13px;line-height:1.75}
  .scene-copy .voice{font-size:17px;line-height:1.75}
  .story-choices tw-link{min-height:78px}
  .ending .scene-copy h1{font-size:26px}
  .ending .closing{font-size:20px}
  .actions{gap:8px}
  .actions tw-link{padding:9px 15px;font-size:12px;min-height:40px}
  .card-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;width:100%;margin:12px auto 0}
  .card-tabs button{min-width:0}
  .has-card-tabs>.fact:not(.is-active),.has-card-tabs>.journal-role:not(.is-active){display:none}
  .facts.has-card-tabs,.journal-grid.has-card-tabs{grid-template-columns:1fr;margin-top:10px}
  .fact,.data-ending .facts .fact{padding:13px 16px}
  .fact strong{font-size:29px}
  .fact h2{font-size:13px}
  .fact p{font-size:12px;line-height:1.8}
  .fact a{font-size:9px}
  .journal-head{padding:8px 0}
  .journal-head h1{font-size:30px;margin:4px 0}
  .journal-head p{font-size:10px}
  .journal-role{padding:15px 18px}
  .journal-role>img{height:64px}
  .journal-role h2{margin:4px 0 10px}
  .journal-entry{padding:10px 0 8px}
  .journal-entry h3{font-size:14px;margin-bottom:5px}
  .journal-entry .entry-state{margin-bottom:4px;font-size:9px}
  .fit-compact .role-copy{padding:8px 10px}
  .fit-compact .role-no{font-size:7px}
  .fit-compact .role-card h2{font-size:20px}
  .fit-compact .role-card p{font-size:10px}
  .fit-compact .sound-hint{font-size:7px}
  .fit-compact .selection-foot{font-size:8px;gap:4px}
  .fit-compact .card-tabs{margin-top:8px;gap:6px}
  .fit-compact .card-tabs button{padding:6px;min-height:32px;font-size:11px}
}

/* A short, wide window gives the illustration and story their own columns. */
@media(min-width:601px) and (min-height:601px){
  .page.selection{height:var(--selection-height,calc(100dvh - 90px));display:grid;grid-template-rows:auto auto auto minmax(0,1fr) auto;row-gap:clamp(10px,1.5dvh,16px)}
  .selection .selection-head{margin:0 auto}
  .selection .selection-head h1{font-size:clamp(36px,3.2vw,60px);line-height:1.25;letter-spacing:12px;margin:0 0 10px}
  .selection .selection-head p{font-size:clamp(13px,1.05vw,16px);line-height:1.8}
  .selection .selection-art{width:280px;height:clamp(40px,8dvh,76px);margin:0 auto}
  .selection .role-grid{width:100%;height:100%;min-height:0;max-width:1380px;margin:0 auto;gap:clamp(14px,1.6vw,28px)}
  .selection .role-card{display:flex;flex-direction:column;min-height:0}
  .selection .animal-preview{display:flex;flex:1 1 0;min-height:0;flex-direction:column;justify-content:center;padding:20px 24px 6px}
  .selection .animal-preview img{flex:1 1 0;min-height:0;height:0;opacity:.8}
  .selection .sound-hint{flex:none;font-size:clamp(10px,.8vw,12px);padding-top:10px}
  .selection .role-copy{flex:none;padding:clamp(16px,1.5vw,28px)}
  .selection .role-no{font-size:clamp(9px,.75vw,12px)}
  .selection .role-card h2{font-size:clamp(28px,2vw,38px);line-height:1.4;margin:8px 0 10px}
  .selection .role-card p{font-size:clamp(13px,1.05vw,16px);line-height:1.8;min-height:0}
  .selection .role-enter{font-size:clamp(14px,1.05vw,17px);margin-top:18px}
  .selection .role-enter tw-link{min-height:36px}
  .selection .role-count{font-size:12px;top:18px;right:22px}
  .selection .selection-foot{width:100%;margin:0 auto;font-size:clamp(10px,.8vw,12px);gap:10px}
}
@media(min-width:701px) and (max-height:600px){
  tw-story{padding-left:24px;padding-right:24px}
  .mast{min-height:40px;margin-bottom:8px}
  .scene-stage{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:22px;align-items:center}
  .scene-stage>.chapter,.scene-stage>.chapter-meter{grid-column:1/-1}
  .scene-stage>.artwork{grid-column:1;grid-row:2}
  .scene-stage>.scene-panel{grid-column:2;grid-row:2}
  .scene-panel .scene-copy{margin-top:0}
  .scene-copy h1{font-size:25px;letter-spacing:3px}
  .scene-copy p{font-size:13px;line-height:1.65}
  .scene-copy .voice{font-size:16px;line-height:1.65}
  .story-choices{gap:8px}
  .story-choices tw-link{min-height:64px;padding:8px 24px 8px 10px}
  .choice-title{font-size:12px}
  .choice-detail{font-size:10px;line-height:1.6}
  .memory{font-size:10px;margin-top:8px;padding:6px 10px}
  .task-duck>.scene-panel{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:22px;align-items:center}
  .task-duck .interaction{width:100%;margin-top:0}
  .task-duck .scene-copy{margin:0}
  .duel-status{font-size:10px;gap:12px;margin:6px 0}
  .interaction .instructions{font-size:10px}
  .task-status{font-size:10px}
  .actions tw-link,.action-button,.hold-button{min-height:36px;font-size:12px;padding:7px 12px}
  .data-ending{grid-template-columns:minmax(0,.55fr) minmax(0,1.45fr)}
  .data-ending .card-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:10px}
  .data-ending .has-card-tabs>.fact:not(.is-active){display:none}
  .data-ending .facts.has-card-tabs{grid-template-columns:1fr;margin:8px auto}
  .data-ending .fact{padding:10px 12px}
  .data-ending .fact strong{font-size:26px;line-height:1.3}
  .data-ending .fact h2{font-size:12px;margin:3px 0}
  .data-ending .fact p{font-size:11px;line-height:1.65}
  .data-ending .fact a{font-size:9px;margin-top:5px}
  .data-ending .scene-copy h1{font-size:24px;margin-bottom:4px}
  .data-ending .scene-copy .voice{font-size:14px}
  .data-ending .facts-note{font-size:9px;line-height:1.6}
  .selection .role-card{display:grid;grid-template-columns:28% minmax(0,1fr)}
  .selection .animal-preview{padding:5px}
  .selection .animal-preview img{height:65px}
  .selection .sound-hint{font-size:8px;letter-spacing:0;line-height:1.6}
  .selection .role-copy{padding:10px 12px 10px 5px}
  .selection .role-count{top:8px;right:10px;font-size:9px}
  .selection-art{height:32px;margin:6px auto 10px}
  .journal{display:grid;grid-template-columns:170px minmax(0,1fr);column-gap:18px;align-items:start}
  .journal-head{grid-column:1;grid-row:1/4;text-align:left;padding-top:12px}
  .journal-head h1{font-size:28px;letter-spacing:7px;margin:6px 0}
  .journal-head p{font-size:11px;line-height:1.8}
  .journal>.card-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;grid-column:2;margin:0}
  .journal-grid.has-card-tabs{grid-column:2;grid-template-columns:1fr;margin:8px 0}
  .journal .has-card-tabs>.journal-role:not(.is-active){display:none}
  .journal-role{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;padding:12px}
  .journal-role>img{grid-column:1;grid-row:1;justify-self:start;height:36px;width:55px}
  .journal-role>.role-no{grid-column:2;grid-row:1;align-self:center}
  .journal-role h2{grid-column:1;grid-row:1;justify-self:end;align-self:center;font-size:20px;letter-spacing:2px;margin:0}
  .journal-entry{grid-row:2;padding:8px 0}
  .journal-entry h3{font-size:13px;line-height:1.5;margin-bottom:5px}
  .journal-entry p{font-size:11px;line-height:1.7}
  .journal-entry .entry-state{font-size:8px;letter-spacing:1px;margin-bottom:5px}
  .journal-role .role-enter{grid-column:1/-1;margin:0;font-size:12px}
  .journal>.actions{grid-column:2;margin-top:4px}
}

/* The title is a still poster; only the light, dust and rings move inside it. */
.title-screen{height:var(--selection-height,calc(100dvh - 86px));position:relative;isolation:isolate;display:grid;grid-template-rows:minmax(0,1fr) auto;overflow:hidden;background:#000;padding:0 8px}
.title-dust,.title-light{position:absolute;inset:0;width:100%;height:100%;z-index:-1;pointer-events:none}
.title-light{background:radial-gradient(ellipse at 76% 46%,#ffffff0b,transparent 58%);opacity:.75}
.title-main{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);align-items:center;gap:clamp(20px,4vw,72px);min-height:0}
.title-copy{padding:clamp(10px,3dvh,32px) 0;min-width:0}
.title-overline{font:10px/1.8 Georgia,"Microsoft YaHei",serif;letter-spacing:3px;color:#999;margin-bottom:clamp(16px,3dvh,30px)}
.title-wordmark{font:normal clamp(52px,10.2dvh,112px)/1.14 "Songti SC","SimSun",serif;letter-spacing:.12em;color:#f5f5f5;margin:0}
.title-wordmark>span{display:block;position:relative;width:fit-content;white-space:nowrap}
.title-wordmark>span:last-child{padding-left:.4em}
.title-mark{position:absolute;font:normal .25em/1 Georgia,serif;right:-1.25em;top:.35em;color:#999}
.title-english{font:10px/1.8 Georgia,serif;letter-spacing:5px;color:#888;margin-top:20px}
.title-subtitle{font:normal clamp(18px,2.8dvh,28px)/1.6 "SimSun",serif;letter-spacing:.5em;margin:14px 0 16px;color:#dedede}
.title-invitation{font-size:13px;line-height:1.9;letter-spacing:2px;color:#aaa;margin:0}
.title-controls{margin-top:clamp(20px,4dvh,42px)}
.title-controls .actions{justify-content:flex-start;flex-wrap:nowrap;gap:14px;margin:0}
.title-controls .actions>span:first-child{flex:1;max-width:258px}
.title-controls .actions>span:first-child tw-link{display:flex;justify-content:space-between;width:100%;min-height:58px;padding:14px 25px;background:#f3f3f3;color:#111;border-color:#f3f3f3;letter-spacing:3px}
.title-controls .actions>span:first-child tw-link:hover{background:#fff;box-shadow:0 0 30px #ffffff22}
.title-controls .actions>span:last-child tw-link{background:transparent;border:0;min-height:48px;padding:10px;color:#aaa;font-size:12px;white-space:nowrap;letter-spacing:1px}
.title-controls .actions>span:last-child tw-link:hover{color:#fff}
.title-listen{display:inline-flex;align-items:center;gap:10px;border:0;background:none;padding:12px 0 0;color:#888;font-size:10px;letter-spacing:1px}
.title-listen:hover{color:#ddd}
.title-equalizer{display:flex;align-items:center;gap:3px;height:16px;width:23px}
.title-equalizer i{width:2px;height:3px;background:currentColor;transform-origin:center}
.title-screen.is-sounding .title-equalizer i{height:12px;animation:title-equalize 1.1s ease-in-out infinite}
.title-screen.is-sounding .title-equalizer i:nth-child(2){animation-delay:-.3s}
.title-screen.is-sounding .title-equalizer i:nth-child(3){animation-delay:-.6s}
.title-screen.is-sounding .title-equalizer i:nth-child(4){animation-delay:-.8s}
.title-visual{position:relative;width:100%;height:100%;max-height:620px;min-height:240px;min-width:0;align-self:center}
.title-orbit{position:absolute;width:96%;aspect-ratio:1;left:50%;top:47%;transform:translate(-50%,-50%);border:1px solid #ffffff12;border-radius:50%;pointer-events:none}
.title-orbit:before,.title-orbit:after{content:"";position:absolute;left:50%;top:50%;border-radius:50%;transform:translate(-50%,-50%)}
.title-orbit:before{width:86%;height:86%;border:1px solid #ffffff24;box-shadow:0 0 80px #ffffff07,inset 0 0 50px #ffffff06}
.title-orbit:after{width:58%;height:58%;background:radial-gradient(circle,#ffffff16,transparent 70%)}
.orbit-ring{position:absolute;border-radius:50%;inset:4%;border:1px solid transparent;border-top-color:#ccc;border-bottom-color:#ffffff30;animation:title-orbit 42s linear infinite}
.orbit-ring:after{content:"";position:absolute;left:15%;top:13%;width:5px;height:5px;background:#eee;border-radius:50%;box-shadow:0 0 12px #fff8}
.ring-inner{inset:14%;border-top-color:#ffffff38;border-bottom-color:#ffffff70;animation-duration:30s;animation-direction:reverse}
.orbit-cross{position:absolute;inset:-7%;background:linear-gradient(90deg,transparent calc(50% - .5px),#ffffff18 50%,transparent calc(50% + .5px)),linear-gradient(0deg,transparent calc(50% - .5px),#ffffff18 50%,transparent calc(50% + .5px));opacity:.6}
.orbit-star{position:absolute;font-family:Georgia,serif;color:#ccc;font-size:24px;line-height:1;text-shadow:0 0 14px #fff5;animation:title-star 4s ease-in-out infinite}
.star-north{top:-2%;left:48%}
.star-south{right:6%;bottom:14%;font-size:18px;animation-delay:-2s}
.title-portals{position:absolute;inset:16% 4% 21%;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:center;gap:14px}
.title-portal{position:relative;isolation:isolate;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;width:100%;height:81%;min-width:0;overflow:hidden;border:1px solid #ffffff40;border-radius:100px 100px 2px 2px;padding:16px 8px 18px;color:#ddd;background:linear-gradient(180deg,#1e1e1e,#080808 68%);box-shadow:0 14px 40px #0008;transition:border-color .25s,box-shadow .25s,background .25s}
.title-portal:before{content:"";position:absolute;z-index:-1;inset:0;background:linear-gradient(115deg,transparent 30%,#ffffff0c 48%,transparent 66%);background-size:230% 100%;animation:title-portal-light 9s ease-in-out infinite}
.title-portal:after{content:"";position:absolute;left:8%;right:8%;bottom:28%;height:1px;background:linear-gradient(90deg,transparent,currentColor,transparent);opacity:.18}
.title-portal:hover,.title-portal:focus-visible,.title-portal.is-playing{border-color:#fff;box-shadow:0 0 34px #ffffff20,0 14px 40px #0008}
.portal-cat{height:100%;color:#151515;background:linear-gradient(165deg,#fff,#ececec 70%,#aaa);border-color:#eee}
.portal-cat:hover,.portal-cat:focus-visible,.portal-cat.is-playing{box-shadow:0 0 48px #ffffff38,0 14px 40px #0008}
.portal-number{position:absolute;top:13%;left:0;right:0;text-align:center;font:italic 12px/1.6 Georgia,serif;letter-spacing:2px;opacity:.65}
.portal-halo{position:absolute;width:52%;aspect-ratio:1;left:24%;top:23%;border:1px solid currentColor;border-radius:50%;opacity:.18}
.title-portal img{position:absolute;left:9%;bottom:33%;width:82%;height:36%;object-fit:contain;filter:brightness(0) invert(1);opacity:.85;pointer-events:none;transition:opacity .25s,filter .25s}
.portal-cat img{filter:brightness(0);opacity:.8}
.title-portal:hover img,.title-portal:focus-visible img,.title-portal.is-playing img{opacity:1}
.portal-caption{display:flex;flex-direction:column;align-items:center;gap:6px}
.portal-caption strong{font:normal 17px/1.5 "SimSun",serif;letter-spacing:4px;text-indent:4px}
.portal-caption small{font:8px/1.5 Georgia,serif;letter-spacing:2px;opacity:.65}
.title-scene-caption{position:absolute;bottom:7%;left:0;right:0;margin:0;text-align:center;color:#aaa;font:normal 14px/1.8 "SimSun",serif;letter-spacing:1px;min-height:3.6em;padding:0 10px;display:flex;align-items:center;justify-content:center}
.title-footer{position:relative;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 0 12px;border-top:1px solid #ffffff20;color:#888;font-size:10px;letter-spacing:1px}
.title-edition{font:9px/1.8 Georgia,"Microsoft YaHei",serif;letter-spacing:2px}
@keyframes title-orbit{to{transform:rotate(360deg)}}
@keyframes title-star{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes title-equalize{0%,100%{transform:scaleY(.3)}50%{transform:scaleY(1)}}
@keyframes title-portal-light{0%,100%{background-position:100% 50%}50%{background-position:0 50%}}
@media(max-width:1000px){.title-main{gap:22px}.title-overline{font-size:8px;letter-spacing:2px}.title-controls .actions{gap:8px}.title-portals{gap:10px}.title-portal{padding-bottom:13px}.portal-caption strong{font-size:15px}.portal-caption small{font-size:7px;letter-spacing:1px}.title-invitation{font-size:12px;letter-spacing:1px}}
@media(max-width:700px) and (min-height:601px){
 .title-screen{padding:0 4px}.title-main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr) auto;gap:0;height:100%}.title-copy{display:contents}.title-heading{grid-row:1;text-align:center;padding-top:12px}.title-overline{margin:0 0 9px;font-size:8px;letter-spacing:2px}.title-wordmark{display:flex;justify-content:center;gap:.15em;font-size:clamp(34px,5.5dvh,49px);line-height:1.3;letter-spacing:.08em}.title-wordmark>span:last-child{padding-left:0}.title-mark{display:none}.title-english{font-size:8px;letter-spacing:3px;margin-top:8px}.title-subtitle{font-size:19px;letter-spacing:7px;margin:9px 0}.title-invitation{font-size:11px;line-height:1.75}.title-visual{grid-row:2;min-height:140px;max-height:none;width:100%;height:100%;max-width:410px;justify-self:center}.title-orbit{width:min(90%,32dvh)}.title-portals{inset:10% 9% 19%;gap:12px}.title-portal{padding-bottom:14px;max-height:270px;align-self:center}.portal-number{font-size:10px;top:12%}.portal-caption strong{font-size:15px;letter-spacing:2px}.portal-caption small{font-size:7px}.title-portal img{bottom:36%;height:36%}.title-scene-caption{font-size:12px;bottom:1%;min-height:3em}.title-controls{grid-row:3;text-align:center;margin:0;padding:6px 0 10px}.title-controls .actions{justify-content:center}.title-controls .actions>span:first-child{max-width:210px;flex:1}.title-controls .actions>span:first-child tw-link{min-height:46px;padding:10px 20px;font-size:13px;letter-spacing:2px}.title-listen{padding-top:10px;font-size:9px}.title-footer{font-size:8px;padding:10px 0 8px;gap:6px}.title-edition{display:none}
}
@media(max-height:600px){
 .title-main{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px}.title-copy{padding:8px 0}.title-overline{font-size:8px;margin-bottom:10px}.title-wordmark{font-size:clamp(32px,10dvh,56px);line-height:1.1}.title-english{font-size:8px;letter-spacing:3px;margin-top:10px}.title-subtitle{font-size:17px;letter-spacing:5px;margin:8px 0}.title-invitation{font-size:11px;line-height:1.6}.title-controls{margin-top:13px}.title-controls .actions>span:first-child tw-link{min-height:40px;padding:8px 16px;font-size:12px;letter-spacing:2px}.title-controls .actions>span:last-child tw-link{font-size:10px;min-height:36px;padding:6px}.title-listen{padding-top:7px;font-size:9px}.title-visual{min-height:170px}.title-portals{inset:10% 7% 21%;gap:10px}.title-orbit{width:min(80%,65dvh)}.portal-number{font-size:9px}.portal-caption strong{font-size:13px}.portal-caption small{font-size:6px}.title-portal{padding-bottom:10px}.title-scene-caption{font-size:11px;bottom:0}.title-footer{padding:8px 0;font-size:8px}.title-edition{font-size:7px}
}
@media(max-width:700px) and (max-height:600px){
 .title-main{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr) auto;gap:0}.title-copy{display:contents}.title-heading{grid-row:1;text-align:center;padding-top:4px}.title-overline{margin-bottom:6px;font-size:7px}.title-wordmark{display:flex;justify-content:center;gap:.15em;font-size:32px;line-height:1.2;letter-spacing:.05em}.title-wordmark>span:last-child{padding-left:0}.title-mark{display:none}.title-english{font-size:7px;margin-top:6px}.title-subtitle{font-size:16px;margin:6px 0;letter-spacing:5px}.title-invitation{font-size:10px;line-height:1.6}.title-visual{grid-row:2;min-height:110px;max-height:none}.title-portals{inset:10% 10% 23%;gap:10px}.title-orbit{width:min(84%,31dvh)}.title-portal{padding-bottom:8px}.portal-number{top:10%;font-size:8px}.portal-caption{gap:3px}.portal-caption strong{font-size:12px;letter-spacing:2px}.portal-caption small{font-size:6px;letter-spacing:1px}.title-portal img{bottom:35%;height:33%}.title-scene-caption{font-size:10px;bottom:0;min-height:3em}.title-controls{grid-row:3;text-align:center;margin:0;padding:5px 0 8px}.title-controls .actions{justify-content:center}.title-controls .actions>span:first-child{max-width:175px}.title-controls .actions>span:first-child tw-link{min-height:38px;padding:8px 15px}.title-listen{padding-top:6px;font-size:8px}.title-footer{font-size:7px;letter-spacing:0}.title-edition{display:none}
}
@media(max-width:600px){.mast{gap:10px}.mast nav{gap:10px;flex-shrink:0}.brand{font-size:9px;letter-spacing:0;gap:6px}}
@media(prefers-reduced-motion:reduce){.orbit-ring,.orbit-star,.title-portal:before,.title-screen.is-sounding .title-equalizer i{animation:none!important}}

/* English typography shares the artwork, palettes, and effects with the Chinese edition. */
body{font-family:"Segoe UI",Arial,sans-serif}
tw-story{line-height:1.6}
.mast,.mast nav{letter-spacing:.03em}
.brand{letter-spacing:.06em}
.series-label{letter-spacing:.02em}
.eyebrow,.role-no{letter-spacing:.15em}
.selection .selection-head h1,.selection-head h1{font-family:Georgia,"Times New Roman",serif;letter-spacing:.025em;font-size:clamp(28px,3.5vw,54px)}
.selection-head p,.selection .selection-head p{letter-spacing:0;line-height:1.6}
.role-card h2,.selection .role-card h2,.journal-role h2{font-family:Georgia,"Times New Roman",serif;letter-spacing:.03em}
.role-card p,.selection .role-card p{line-height:1.6}
.sound-hint,.selection-foot{letter-spacing:0}
.scene-copy{max-width:1040px}
.scene-copy h1,.ending .scene-copy h1{font-family:Georgia,"Times New Roman",serif;letter-spacing:.015em;line-height:1.2}
.scene-copy p{line-height:1.6}
.scene-copy .voice{font-family:Georgia,"Times New Roman",serif;line-height:1.5}
.scene-copy .thought{line-height:1.55}
.chapter{letter-spacing:.03em}
.chapter small{letter-spacing:.08em}
.actions tw-link,.action-button,.hold-button{letter-spacing:.02em}
.choice-title{letter-spacing:0;line-height:1.35}
.choice-detail{line-height:1.45}
.memory{line-height:1.5}
.memory>span,.whisper-label,.entry-state{letter-spacing:.1em}
.story-whisper{max-width:760px}
.whisper-copy{height:3.4em;line-height:1.7}
.whisper-label{letter-spacing:.06em}
.whisper-action{letter-spacing:0}
.ending .closing{font-family:Georgia,"Times New Roman",serif;letter-spacing:.015em;line-height:1.4;font-size:clamp(20px,1.8vw,27px)}
.ending .ending-note{line-height:1.6}
.fact h2{line-height:1.4}
.fact p{line-height:1.65}
.facts-note{line-height:1.5}
.journal-head h1{font-family:Georgia,"Times New Roman",serif;letter-spacing:.02em}
.journal-entry h3{line-height:1.35}
.journal-entry p{line-height:1.65}
.title-overline{letter-spacing:.2em}
.title-wordmark{font-family:Georgia,"Times New Roman",serif;font-size:clamp(48px,8.5dvh,96px);line-height:1.12;letter-spacing:-.035em}
.title-wordmark>span:last-child{padding-left:.18em}
.title-english{letter-spacing:.21em}
.title-subtitle{font-family:Georgia,"Times New Roman",serif;font-size:clamp(18px,2.7dvh,26px);letter-spacing:.08em;line-height:1.4}
.title-invitation{letter-spacing:.035em;line-height:1.8}
.title-controls .actions>span:first-child tw-link{letter-spacing:.12em}
.portal-caption strong{font-family:Georgia,"Times New Roman",serif;letter-spacing:.09em;text-indent:0}
.title-scene-caption{font-family:Georgia,"Times New Roman",serif;letter-spacing:.015em}
.title-footer{letter-spacing:.03em}
.fit-compact .scene-copy h1,.fit-compact .ending .scene-copy h1{letter-spacing:.015em}
.fit-compact .scene-copy .closing{letter-spacing:0}
@media(max-width:1050px){.brand .series-label{display:none}}
@media(max-width:700px){
 .title-wordmark{display:block;font-size:clamp(35px,5.3dvh,47px);line-height:1.03;letter-spacing:-.025em}
 .title-wordmark>span{margin-left:auto;margin-right:auto}
 .title-wordmark>span:last-child{padding-left:0}
 .title-english{font-size:7px;letter-spacing:.17em;margin-top:10px}
 .title-subtitle{font-size:19px;letter-spacing:.04em;margin:9px 0;line-height:1.4}
 .title-invitation{font-size:11px;line-height:1.6;letter-spacing:0}
 .title-scene-caption{font-size:12px;padding-left:16px;padding-right:16px}
 .title-listen{font-size:9px;letter-spacing:.02em}
 .title-controls .actions>span:last-child tw-link{letter-spacing:0}
 .title-footer{font-size:8px;letter-spacing:0}
}
@media(max-width:600px){
 .mast{gap:8px}
 .mast nav{gap:9px;letter-spacing:0}
 .mast .brand{font-size:8.5px;letter-spacing:0;gap:5px}
 .mast tw-link,.mast .audio-toggle{font-size:10px;white-space:nowrap}
 .selection-head h1,.selection .selection-head h1{font-size:28px;letter-spacing:.015em;line-height:1.2}
 .role-card h2,.fit-compact .role-card h2{font-size:22px;letter-spacing:.02em}
 .role-card p{line-height:1.5}
 .role-enter{font-size:12px}
 .scene-copy h1,.ending .scene-copy h1{font-size:25px;letter-spacing:.015em}
 .scene-copy .voice{font-size:17px;line-height:1.5}
 .scene-copy p{line-height:1.55}
 .scene-copy .thought{line-height:1.5}
 .story-choices tw-link{min-height:78px;gap:6px;padding:10px 22px 10px 11px}
 .choice-title{font-size:12px;line-height:1.35}
 .choice-detail{font-size:11px;line-height:1.4}
 .actions tw-link,.action-button,.hold-button{letter-spacing:0}
 .ending .closing{font-size:20px;line-height:1.35}
 .journal-head h1,.fit-compact .journal-head h1{font-size:28px;letter-spacing:.01em;line-height:1.3}
 .journal-role h2{letter-spacing:.02em}
 .fit-compact .scene-copy h1{font-size:22px;line-height:1.2}
 .fit-compact .choice-title{font-size:12px;line-height:1.35}
 .fit-compact .choice-detail{font-size:10px;line-height:1.4}
 .fit-compact .scene-copy .closing{font-size:18px}
}
@media(max-height:600px) and (min-width:701px){
 .title-wordmark{font-size:clamp(32px,10dvh,56px)}
 .title-subtitle{font-size:17px;letter-spacing:.03em}
 .title-invitation{font-size:11px;letter-spacing:0}
 .title-overline{font-size:8px;letter-spacing:.15em}
 .title-footer{font-size:8px}
 .journal-head h1{font-size:26px;letter-spacing:.01em}
 .scene-copy h1,.ending .scene-copy h1{font-size:25px}
}
@media(max-height:600px) and (max-width:700px){
 .title-wordmark{font-size:32px;line-height:1.02}
 .title-english{font-size:6px;margin-top:6px;letter-spacing:.14em}
 .title-subtitle{font-size:16px;margin:6px 0;letter-spacing:.025em}
 .title-invitation{font-size:10px;line-height:1.5}
 .title-overline{letter-spacing:.12em}
 .title-scene-caption{font-size:10px}
 .title-listen{font-size:8px}
 .title-footer{font-size:7px}
}


:: Interactions and Audio [script] {"position": "960,1080", "size": "180,100"}
(function(){
  'use strict';
  document.documentElement.lang='en';
  const storageKey="they-once-existed-new-gift-en-v1";
  const validEndings=['pig-live','pig-fall','cat-light','cat-sleep','duck-yes','duck-no'];
  let saved={endings:[],muted:false};
  try{const value=JSON.parse(localStorage.getItem(storageKey)||'{}');if(value&&typeof value==='object')saved={endings:Array.isArray(value.endings)?[...new Set(value.endings.filter(x=>validEndings.includes(x)))]:[],muted:value.muted===true};}catch(_){}
  const persist=()=>{try{localStorage.setItem(storageKey,JSON.stringify(saved));}catch(_){}};
  persist();
  // 三条路线按章节播放 GitHub 原始文件直链。同一音频跨页面继续播放，切换章节时停止上一段。
